[Unit]
After=network-online.target
Wants=network-online.target
Description=Tor Load Balancer
# The ExecStart/ExecStop paths are rendered at install time by
# services/install-services.sh. systemd's %h specifier cannot be used because
# this service must run as root (nftables/iptables, ip netns, chown), for which
# %h would resolve to /root.
[Service]
Type=forking
ExecStart=@REPO@/bin/net.tor.proxy
ExecStop=@REPO@/bin/net.tor.proxy.kill

[Install]
WantedBy=multi-user.target
