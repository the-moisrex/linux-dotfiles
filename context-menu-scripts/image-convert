#!/bin/bash

# Name: Convert Image
# MimeType: image/*
#
# Convert images between formats (PNG, JPG, WebP, AVIF) using ffmpeg.
# Usage: image-convert <format> <file...>
#   format: png, jpg, webp, avif
# If no format is given, converts to webp.

set -euo pipefail

show_help() {
    cat <<'EOF'
Usage: image-convert [format] <file...>

Convert images to a different format.

Formats: png, jpg, webp, avif
Default: webp

Examples:
  image-convert webp photo.jpg
  image-convert png image1.jpg image2.webp
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    show_help
    exit 0
fi

format="webp"
files=()

# First arg might be a format (no dots, short)
if [[ $# -gt 0 && "$1" != -* && ! "$1" == *.* ]]; then
    format="$1"
    shift
fi

files=("$@")

if [[ ${#files[@]} -eq 0 ]]; then
    echo "No files specified." >&2
    exit 1
fi

case "$format" in
    png|jpg|jpeg|webp|avif) ;;
    *)
        echo "Unknown format: $format" >&2
        echo "Supported: png, jpg, webp, avif" >&2
        exit 1
        ;;
esac

for file in "${files[@]}"; do
    if [[ ! -f "$file" ]]; then
        echo "Skipping (not a file): $file" >&2
        continue
    fi
    base="${file%.*}"
    out="${base}.${format}"
    echo "Converting: $file -> $out"
    if ! ffmpeg -i "$file" -y "$out" 2>/dev/null; then
        echo "Failed: $file" >&2
    fi
done
