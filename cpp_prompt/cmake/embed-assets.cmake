# Script mode: writes the raw-string asset header the `new` prompt embeds.
#
#   cmake -DASSET_OUT=<file> -DASSET_DIR=<source root> -DASSET_FILES=<ident>|<relpath>;... -P embed-assets.cmake
#
# Each source is baked into the binary at build time (a raw string constant),
# so `new` never reads the source tree at run time but stays in sync with the
# SDK/example sources it references. Re-run automatically whenever one changes
# (see the add_custom_command in CMakeLists.txt).

set(body "// Generated by cmake/embed-assets.cmake -- do not edit by hand.\n")
string(APPEND body "// One raw-string snapshot per native source the `new` prompt embeds.\n\n")
string(APPEND body "#pragma once\n\n#include <array>\n\nnamespace prompt::prompt_assets {\n\n")
string(APPEND body "struct asset {\n    char const *label;\n    char const *lang;\n    char const *text;\n};\n\n")

set(table "")
set(count 0)
foreach(spec IN LISTS ASSET_FILES)
    string(FIND "${spec}" "|" bar)
    string(SUBSTRING "${spec}" 0 ${bar} ident)
    math(EXPR start "${bar} + 1")
    string(SUBSTRING "${spec}" ${start} -1 relpath)

    file(READ "${ASSET_DIR}/${relpath}" content)

    set(delim "CPP_PROMPT_ASSET")
    while(1)
        string(FIND "${content}" ")${delim}\"" hit)
        if(hit EQUAL -1)
            break()
        endif()
        string(APPEND delim "x")
    endwhile()

    string(APPEND body "inline constexpr char const *${ident} = R\"${delim}(${content})${delim}\";\n\n")
    string(APPEND table "    {.label = \"cpp_prompt/${relpath}\", .lang = \"cpp\", .text = ${ident}},\n")
    math(EXPR count "${count} + 1")
endforeach()

string(APPEND body "inline constexpr std::array<asset, ${count}> assets = {{\n")
string(APPEND body "${table}")
string(APPEND body "},};\n\n} // namespace prompt::prompt_assets\n")

file(WRITE "${ASSET_OUT}" "${body}")
