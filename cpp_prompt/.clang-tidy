---
# clang-tidy checks for the cpp_prompt dispatcher.
# Two groups: correctness checks we fix on sight, and style checks this
# project deliberately declines. Run with:
#   clang-tidy -p build src/*.cpp src/*/*.cpp tests/*.cpp
#   clang-tidy -p build <file> --fix      # one file at a time
#
# The fixer can garble a long single-line statement when two rewrites land on
# the same line (it mangles argument lists in headers, and has deleted
# function bodies). Fix per file and compile after each; never one giant
# --fix run.
#
# Declined with a reason: use-anonymous-namespace / use-internal-linkage (the
# prompt entry points are file-local `static` functions referenced by the
# registrar in the same TU — anonymous namespaces would only add nesting),
# braces-around-statements (short single-line ifs), const-correctness on
# locals (parameters are already const&), cognitive complexity (bash-ported
# functions are long by nature), magic numbers and identifier length (the
# ports keep the scripts' literals and names), brackets/uppercase-literal-suffix.
Checks: >
  bugprone-*,
  concurrency-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -concurrency-mt-unsafe,
  -misc-const-correctness,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace,
  -misc-use-internal-linkage,
  -modernize-use-ranges,
  -modernize-use-string-view,
  -modernize-use-std-print,
  -modernize-use-trailing-return-type,
  -performance-avoid-endl,
  -performance-move-const-arg,
  -portability-avoid-pragma-once,
  -readability-braces-around-statements,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-magic-numbers,
  -*uppercase-literal-suffix

WarningsAsErrors: '*'
HeaderFilterRegex: '.*'
FormatStyle: file
