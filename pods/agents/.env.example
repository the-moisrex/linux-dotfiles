# Copy to .env (git-ignored) and set a password for the opencode web UI.
# It protects http://opencode.localhost and http://localhost:4096 with HTTP
# basic auth (user: opencode).
OPENCODE_SERVER_PASSWORD=

# Optional overrides (can also be exported in the shell instead):
# OC_PROFILE=default          # which named profile volume to use
# OC_PORT=4096                # host port published on 127.0.0.1
# OC_HOST=opencode.localhost  # traefik Host() rule
# OC_WORKSPACE=../../../Projects   # directory served as the web workspace
