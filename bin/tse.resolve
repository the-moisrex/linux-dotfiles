#!/usr/bin/env python3
"""tse.resolve — resolve Persian / finglish / fuzzy instrument names to TSETMC identifiers.

Turns a human name (`فولاد`, `foolad`, `khodro`, `فنفت`, a company-name
fragment, an ISIN, an insCode, a composite `فولاد-IRO1FOLD0001` token, or an
easytrader/tsetmc/codal URL) into the canonical TSETMC identifiers — symbol,
ISIN, insCode, market and board — so every other `tse.*` tool can share one
resolution path.

Matching runs exact (symbol/name/ISIN/insCode) -> finglish (Latin input is
reverse-transliterated through `bin/finglish` and also compared against the
forward finglish forms baked into the cache) -> fuzzy (`rapidfuzz` when
available, `difflib` otherwise). Candidates are ranked by market tier so a
duplicated symbol resolves to the traded/main-market instrument (e.g. `فنفت`
picks the `بازار دوم` listing over the `بازار پایه` one) and only truly tied
candidates are reported as ambiguous.

The active-instrument index comes from the same bulk market watch `bin/tse`
uses; it is cached (XDG cache, one week by default, `--refresh` to force) and a
live `Instrument/GetInstrumentSearch` backfills anything the index misses.
"""

import argparse
import importlib.util
import json
import os
import re
import sys
from datetime import datetime, timedelta, timezone
from importlib.machinery import SourceFileLoader
from pathlib import Path

HERE = os.path.dirname(os.path.abspath(__file__))
CACHE_VERSION = 3
DEFAULT_TTL_DAYS = 7
DEFAULT_MIN_SCORE = 62.0
FUZZY_ACCEPT_SCORE = 76.0
AMBIGUITY_MARGIN = 4.0

# Market tier: lower is "more correct" when one symbol is listed twice.
# 1/2/6/7 are the main bourse/farabourse markets, 4 the پایه market, 3 the
# derivatives market.
MARKET_RANK = {1: 0, 2: 1, 6: 1, 7: 1, 4: 2, 3: 3}
MARKET_DEFAULT_RANK = 2.5
FLOW_NAMES = {1: "بورس", 2: "فرابورس", 3: "مشتقه", 4: "پایه", 6: "فرابورس", 7: "فرابورس"}
# Base-market board codes (پایه), penalised after the flow tier.
BASE_BOARDS = {"P1", "P2", "C1", "L1"}
BOARD_CODES = {
    "1A": "بازار ابزارهاي نوين مالي فرابورس", "1N": "بازار اول (تابلوی اصلی) بورس",
    "1Z": "بازار اول فرابورس", "2A": "بازار ابزارهاي نوين مالي فرابورس",
    "2Z": "بازار دوم فرابورس", "41": "بازار ابزارهاي نوين مالي",
    "4A": "بازار ابزارهاي نوين مالي فرابورس", "51": "بازار صندوق های قابل معامله",
    "5A": "بازار صندوق های قابل معامله", "5N": "بازار صندوق های قابل معامله",
    "61": "بازار ابزارهای مشتقه", "71": "بازار ابزارهای مشتقه",
    "91": "بازار ابزارهای مشتقه", "C1": "بازار پایه نارنجی فرابورس",
    "D1": "بازار دوم فرابورس", "EQ": "بازار سایر اوراق بهادار قابل معامله",
    "F1": "بازار عادی آتی", "G1": "بازار دوم (تابلوی اصلی) بورس",
    "H1": "بازار صندوق های قابل معامله", "HN": "بازار صندوق های قابل معامله",
    "I1": "بازار ابزارهاي نوين مالي فرابورس", "I2": "بازار ابزارهاي نوين مالي فرابورس",
    "K2": "بازار دوم فرابورس", "L1": "بازار پایه قرمز فرابورس",
    "M1": "بازار ابزارهاي نوين مالي فرابورس", "M2": "بازار ابزارهاي نوين مالي فرابورس",
    "N1": "بازار اول (تابلوی فرعی) بورس", "N2": "بازار دوم (تابلوی فرعی) بورس",
    "N4": "بازار اوراق بدهی", "NS": "بازار سرمایه گذاری حرفه ای",
    "O1": "بازار خرده فروشی بورس", "P1": "بازار پایه زرد فرابورس",
    "P2": "بازار پایه زرد فرابورس", "Q1": "بورس کالا",
    "QS": "صندوق های کالایی", "T1": "بازار ابزارهاي نوين مالي فرابورس",
    "T2": "بازار ابزارهاي نوين مالي فرابورس", "V1": "بازار نوآفرین - رشد",
    "W1": "بازار نوآفرین - دانش بنیان", "Z1": "بازار دوم فرابورس",
}

KIND_TYPES = {
    300: "stock", 303: "stock", 309: "stock", 313: "stock",
    305: "fund", 380: "fund", 315: "fund",
    311: "option", 312: "option", 320: "option", 321: "option",
    304: "future", 307: "mortgage",
    400: "right", 403: "right", 404: "right",
    306: "bond", 706: "bond", 301: "bond", 206: "bond", 208: "bond",
    200: "forward", 308: "forward", 701: "forward",
    201: "other", 801: "other", 802: "other", 803: "other",
}

TYPE_ALIASES = {
    "stock": "stock", "stocks": "stock", "equity": "stock", "سهم": "stock",
    "fund": "fund", "funds": "fund", "etf": "fund", "صندوق": "fund",
    "option": "option", "options": "option",
    "bond": "bond", "bonds": "bond",
    "right": "right", "rights": "right", "حق": "right",
