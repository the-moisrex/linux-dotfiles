#!/usr/bin/env python3
"""ai.kimi — start a new Kimi chat from a prompt or stdin.

Replays the signed-in www.kimi.ai session (access/refresh tokens from
``localStorage``) over its own chat API — no API key.
See ``ai.kimi --help``.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from ai.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main("kimi"))
