#!/usr/bin/env python3
import argparse
import os
import sys
import subprocess
import re
import shlex
import glob
from pathlib import Path

# --- GLOBAL SETTINGS & CACHE ---
VERBOSE = False
PROMPT_COMMANDS_CACHE = set()

def debug(msg):
    """Print debug messages to stderr if verbose mode is enabled."""
    if VERBOSE:
        sys.stderr.write(f"[DEBUG] {msg}\n")

def run_shell(cmd_args):
    """Run a shell command, returning its stdout as a string or None if failed."""
    try:
        debug(f"Executing: {cmd_args}")
        result = subprocess.run(
            cmd_args,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=True
        )
        return result.stdout.decode("utf-8", errors="replace").strip()
    except subprocess.CalledProcessError as e:
        debug(f"Command failed: {cmd_args}\nError: {e.stderr.decode('utf-8', errors='replace').strip()}")
        return None
    except FileNotFoundError:
        debug(f"Command not found: {cmd_args[0]}")
        return None
    except Exception as e:
        debug(f"Unexpected error running {cmd_args}: {e}")
        return None

def init_cache():
    """Populate the PROMPT_COMMANDS_CACHE by running 'prompt list-prompts'."""
    output = run_shell(["prompt", "list-prompts"])
    if output:
        for line in output.splitlines():
            cmd = line.strip()
            if cmd:
                PROMPT_COMMANDS_CACHE.add(cmd)
    debug(f"Cached prompt commands: {PROMPT_COMMANDS_CACHE}")

# --- MODE 1: AUTOCOMPLETE ---
def autocomplete(snippet):
    """Evaluate the last whitespace-separated token for autocomplete matching."""
    if not snippet.strip():
        return

    tokens = snippet.split()
    target = tokens[-1]
    matches = []

    debug(f"Autocomplete target token: '{target}'")

    # 1. Variables
    if target.startswith("{{") or target.startswith("${"):
        prefix = target[2:]
        for env_var in os.environ:
            if env_var.startswith(prefix):
                if target.startswith("{{"):
                    matches.append(f"{{{{{env_var}}}}}")
                else:
                    matches.append(f"${{{env_var}}}")
    
    # 2. Slash Commands (also . and - shorthands)
    elif target.startswith(("/", ".", "-")):
        cmd_prefix = target[1:]
        prefix_char = target[0]
        for cmd in PROMPT_COMMANDS_CACHE:
            if cmd.startswith(cmd_prefix):
                matches.append(f"{prefix_char}{cmd}")
                
    # 3. Files
    elif target.startswith(("@", "./", "/", "~")):
        # Determine actual path prefix
        search_path = target[1:] if target.startswith("@") else target
        search_path = os.path.expanduser(search_path)
        
        try:
            # Use glob to find matches
            if os.path.isdir(search_path) and not search_path.endswith('/'):
                glob_pattern = search_path + "/*"
            else:
                glob_pattern = search_path + "*"
                
            for path in glob.glob(glob_pattern):
                # Format back the path depending on how it was invoked
                if target.startswith("@"):
                    res = f"@{path}"
                else:
                    res = path
                    
                # FILTER OUT perfect matches from cached commands
                clean_name = os.path.basename(path)
                if clean_name not in PROMPT_COMMANDS_CACHE:
                    matches.append(res)
        except Exception as e:
            debug(f"Autocomplete file expansion error: {e}")

    # Output matches
    if matches:
        # Strictly one per line to stdout
        sys.stdout.write("\n".join(matches) + "\n")

def expand_commands(text):
    """Convert -cmd and .cmd to /cmd with newlines between commands.
    
    Words starting with - or . followed by a word character are treated as commands.
    Each gets a newline before it and the prefix is replaced with /.
    Example: "-man test .fix" -> "/man test\n/fix"
    """
    import re as _re
    # Match words starting with - or . followed by word characters
    return _re.sub(r'(?<!\S)([-.])(\w+)', lambda m: '\n/' + m.group(2), text)

# --- MODE 2: MODIFICATION ---
def process_modification(input_text):
    """Single-pass processing loop to resolve variables, commands, and files."""
    appended_data = []
    
    # Tokenizer regex: matches variables, slash commands, or file-like tokens, plus surrounding whitespace/text
    # Group 1: Variables ({{var}} or ${var})
    # Group 2: Slash commands (/cmd [args])
    # Group 3: Files (@file, ./file, /file, ~/file)
    pattern = re.compile(r'(\{\{[^\}]+\}\}|\$\{[^\}]+\})|(/[\w-]+(?:[ \t]+(?:[^\s"\']|"[^"]*"|\'[^\']*\')+)*)|((?:@|\./|/|~)[^\s]+)')

    def replacer(match):
        var_match = match.group(1)
        cmd_match = match.group(2)
        file_match = match.group(3)

        # 1. Variables
        if var_match:
            is_curly = var_match.startswith("{{")
            var_name = var_match[2:-2] if is_curly else var_match[2:-1]
            
            # Check env var
            val = os.environ.get(var_name)
            if val is not None:
                return val
            
            # Check shell command
            out = run_shell(["prompt", var_name])
            if out is not None:
                if "\n" not in out:
                    return out
                else:
                    appended_data.append(f"\n--- VARIABLE: {var_name} ---\n{out}\n")
                    return "[Variable data appended below]"
            return var_match # Unresolved

        # 2. Slash Commands
        if cmd_match:
            try:
                parts = shlex.split(cmd_match)
                cmd_name = parts[0][1:] # Strip '/'
                args = parts[1:]
                out = run_shell(["prompt", cmd_name] + args)
                if out is not None:
                    return out
            except ValueError as e:
                debug(f"Shlex parsing error for {cmd_match}: {e}")
            return cmd_match # Unresolved

        # 3. Files
        if file_match:
            # Check if it perfectly matches a cached command
            clean_file = file_match[1:] if file_match.startswith("@") else file_match
            if clean_file in PROMPT_COMMANDS_CACHE:
                return file_match # Treat as unchanged text if it's a command name collision

            # If @ is followed by a literal filesystem path, read it directly
            # instead of shelling out to `prompt files`.
            candidate = os.path.expanduser(clean_file)
            if os.path.isfile(candidate):
                try:
                    with open(candidate, "r", errors="replace") as f:
                        appended_data.append(f"\n--- FILE: {clean_file} ---\n{f.read()}\n")
                    return file_match
                except OSError:
                    pass

            out = run_shell(["prompt", "files", clean_file])
            if out is not None:
                appended_data.append(f"\n--- FILE: {clean_file} ---\n{out}\n")
            return file_match # Leave inline token untouched

        return match.group(0)

    # Process text
    modified_text = pattern.sub(replacer, input_text)
    
    # Append trailing data
    if appended_data:
        modified_text += "\n" + "".join(appended_data)
        
    return modified_text

# --- MAIN ---
def main():
    global VERBOSE
    
    # Parse sys.argv manually to preserve arg order for -cmd/.cmd expansion.
    # Known flags are extracted; everything else is input text.
    argv = sys.argv[1:]
    VERBOSE = False
    complete = None
    input_file = None
    do_expand = False
    input_parts = []
    
    known_flags = {
        '-v': ('verbose', 0), '--verbose': ('verbose', 0),
        '-c': ('complete', 1), '--complete': ('complete', 1),
        '-i': ('input', 1), '--input': ('input', 1),
        '-e': ('expand', 0), '--expand': ('expand', 0),
        '-h': ('help', 0), '--help': ('help', 0),
    }
    
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in known_flags:
            flag_name, nargs = known_flags[arg]
            if flag_name == 'help':
                print("Usage: prompt-compiler [-v] [-c SNIPPET] [-i FILE] [-e] [TEXT]")
                print("       command | prompt-compiler [-v] [-e]")
                print()
                print("Compile prompt templates with variable expansion, slash commands, and file embedding.")
                print()
                print("Shorthand syntax:")
                print("  .cmd args / -cmd args   Equivalent to /cmd args (prompt commands)")
                print("  /cmd args               Run 'prompt cmd args' and embed the output")
                print("  @file                   Read file content inline (or embed via 'prompt files')")
                print("  {{VAR}} / ${VAR}        Expand environment variables or prompt commands")
                print()
                print("Examples:")
                print("  prompt-compiler '.note \"hello\" .files src/main.cpp'")
                print("  prompt-compiler -e '.note \"hello\" .files src/main.cpp'")
                print("  echo '.note hello .cli pwd' | prompt-compiler -e")
                print("  prompt-compiler -c '.note {{MY_VAR}}'")
                sys.exit(0)
            elif nargs == 0:
                if flag_name == 'verbose': VERBOSE = True
                elif flag_name == 'expand': do_expand = True
            elif nargs == 1:
                i += 1
                if flag_name == 'complete': complete = argv[i] if i < len(argv) else None
                elif flag_name == 'input': input_file = argv[i] if i < len(argv) else None
        else:
            input_parts.append(arg)
        i += 1
    
    # Initialize cache silently on startup
    init_cache()

    if complete is not None:
        # MODE 1: Autocomplete
        autocomplete(complete)
    else:
        # MODE 2: Modification
        input_text = " ".join(input_parts) if input_parts else None
        from_args = bool(input_parts)
        
        if input_file:
            try:
                with open(input_file, "r") as f:
                    input_text = f.read()
                    from_args = False
            except IOError as e:
                print(f"prompt-compiler: error: Failed to read input file: {e}", file=sys.stderr)
                sys.exit(2)
        elif not input_text:
            # Read from stdin if no positional argument is provided
            if not sys.stdin.isatty():
                input_text = sys.stdin.read()
                from_args = False
            else:
                print("prompt-compiler: error: Modification mode requires input_text as an argument, -i/--input, or piped via stdin.", file=sys.stderr)
                sys.exit(2)
        
        # Expand -cmd/.cmd to /cmd: auto for args, only with -e for stdin
        if input_text and (from_args or do_expand):
            input_text = expand_commands(input_text)
                
        result = process_modification(input_text)
        
        # Strictly output to stdout
        sys.stdout.write(result)
        # Ensure trailing newline if not present
        if not result.endswith('\n'):
            sys.stdout.write('\n')

if __name__ == "__main__":
    main()