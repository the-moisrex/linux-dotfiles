#!/usr/bin/env python3
"""ai.openrouter — chat with OpenRouter (an OpenAI-compatible gateway).

Uses ``OPENROUTER_API_KEY`` (or the key the installed opencode knows about) and
``OPENROUTER_BASE_URL``/``OPENROUTER_MODEL`` instead of a browser session.  See
``ai.openrouter --help``.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from ai.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main("openrouter"))
