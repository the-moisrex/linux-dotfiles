#!/bin/bash

function print_help {
    name=$(basename "$0")
    echo "Usage: $name [options] domain"
    echo
    echo "Resolve a domain to its IPv4 address."
    echo
    echo "Options:"
    echo "  -h, --help    Show this help message"
}

case $1 in
    help|-h|--help|"")
        print_help;
        exit 1;
        ;;

    *)
        # Get the ip address of the specified domain (only one ip)
        dig +short +timeout=3 "$1" | grep '^[.0-9]*$' | head -n 1
    ;;
esac
