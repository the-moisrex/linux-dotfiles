def csv_block(rows, columns):
    buffer = io.StringIO()
    writer = csv.DictWriter(
        buffer, fieldnames=columns, lineterminator="\n", extrasaction="ignore"
    )
    writer.writeheader()
    writer.writerows(rows)
    return ["```csv", buffer.getvalue().rstrip(), "```"]


def corrections_markdown(value):
    """The precomputed historical base-rate section."""
    lines = ["", "## Historical corrections / اصلاحات تاریخی"]
    note = value.get("note") if isinstance(value, dict) else None
    if note:
        lines.append(note)
        return lines
    window = value.get("window") or {}
    lines.append(
        f"Window: {window.get('first')}–{window.get('last')} "
        f"({window.get('sessions')} sessions). Episodes are selected by price structure only — "
        "never by what followed them — so the outcome columns are measurements, not a filter. "
        "Percentages use split/dividend-adjusted closes; the `*_raw_rial` columns are the levels that "
        f"actually traded. Daily حقیقی/حقوقی flow is available from {value.get('flow_from')} only: "
        "earlier episodes report empty flow, which is unknown, not zero."
    )
    episodes = value.get("corrections") or []
    lines.extend(("", f"### Corrections ({len(episodes)})"))
    lines.extend(
        csv_block(episodes, CORRECTION_COLUMNS)
        if episodes
        else ["None met the structural definition in this window."]
    )
    consolidations = value.get("consolidations") or []
    lines.extend(("", f"### Consolidations ({len(consolidations)})"))
    lines.extend(
        csv_block(consolidations, CONSOLIDATION_COLUMNS)
        if consolidations
        else ["None met the structural definition in this window."]
    )
    current = value.get("current")
    lines.extend(("", "### Current episode"))
    lines.extend(
        csv_block([current], CURRENT_COLUMNS)
        if current
        else ["Not available: the history is too short."]
    )
    baseline = value.get("baseline") or {}
    if baseline.get("uptrend_sessions"):
        lines.extend(
            (
                "",
                "Baseline over "
                f"{baseline['uptrend_sessions']} uptrend sessions: median forward 60-session return "
                f"{baseline.get('median_forward_60_pct')}% "
                f"({baseline.get('share_positive_forward_60_pct')}% positive), "
                f"median forward 250-session return {baseline.get('median_forward_250_pct')}% "
                f"({baseline.get('share_positive_forward_250_pct')}% positive), "
                f"{baseline.get('share_new_high_within_250_pct')}% reached a new 60-session high "
                "within 250 sessions.",
            )
        )
    return lines


def markdown(data):
    when = parse_moment(data.get("fetched_at"))
    fetched = jalali_stamp(when) if when is not None else (data.get("fetched_at") or "unknown")
    lines = [
        f"Fetched at: {fetched}",
        f"Market session open by schedule: {data['market_session_open']} (does not guarantee an instrument is trading)",
        "Prices and traded value are in rial, not toman. Missing values are unknown, not zero.",
    ]
    sections = (
        ("Symbol / نماد", "instrument"),
        ("Live quote / قیمت و وضعیت", "quote"),
        ("Order book / صف خرید و فروش", "order_book"),
        ("Last session book / دفتر سفارش آخرین روز", "last_book"),
        ("Money flow / حقیقی و حقوقی", "client_type"),
        ("Market benchmarks / شاخص‌های بازار", "indexes"),
        ("Market context / دلار، اقتصاد و عمق بازار", "market_context"),
        ("Statistics / آمار معاملات", "statistics"),
        ("Technicals / تحلیل تکنیکال", "technicals"),
        ("Fundamentals / اطلاعات بنیادی", "fundamentals"),
        ("Codal / اطلاعیه‌ها و صورت‌های مالی", "codal"),
    )
    for heading, key in sections:
        value = data.get(key)
        if value is None:
            continue
        lines.extend(("", f"## {heading}"))
        if key == "codal" and isinstance(value, dict):
            lines.extend(codal_cache_lines(value.get("cache")))
        lines.extend(
            (
                "```json",
                json.dumps(value, ensure_ascii=False, separators=(",", ":")),
                "```",
            )
        )
    if data.get("history") is not None:
        hist = data["history"]
        if isinstance(hist, dict) and "unadjusted" in hist:
            a_rows = hist.get("adjusted", [])
            events = hist.get("adjustment_events", {})
            buffer = io.StringIO()
            if a_rows:
                # adjusted rows already carry the raw fields plus adj_* columns
                cols = (
                    "date",
                    "first_rial",
                    "high_rial",
                    "low_rial",
                    "closing_rial",
                    "last_rial",
                    "adj_first_rial",
                    "adj_high_rial",
                    "adj_low_rial",
                    "adj_closing_rial",
                    "adj_last_rial",
                    "adj_factor",
                    "corporate_action",
                    "volume_shares",
                    "value_rial",
                    "trade_count",
                ) + CLIENT_TYPE_HISTORY_FIELDS
                writer = csv.DictWriter(buffer, fieldnames=cols, lineterminator="\n")
                writer.writeheader()
                writer.writerows(a_rows)
                heading = "## Price history / تاریخچه قیمت"
            else:
                cols = (
                    "date",
                    "first_rial",
                    "high_rial",
                    "low_rial",
                    "closing_rial",
                    "last_rial",
                    "volume_shares",
                    "value_rial",
                    "trade_count",
                ) + CLIENT_TYPE_HISTORY_FIELDS
                writer = csv.DictWriter(buffer, fieldnames=cols, lineterminator="\n")
                writer.writeheader()
                writer.writerows(hist["unadjusted"])
                heading = "## Price history / تاریخچه قیمت (بدون تعدیل)"
            lines.extend(("", heading, "```csv", buffer.getvalue().rstrip(), "```"))
            # Adjustment events table
            pa = events.get("price_adjustments", [])
            sc = events.get("share_changes", [])
            if pa or sc:
                buffer = io.StringIO()
                ev_cols = ("date", "type", "details")
                writer = csv.DictWriter(buffer, fieldnames=ev_cols, lineterminator="\n")
                writer.writeheader()
                for a in pa:
                    writer.writerow(
                        {
                            "date": a["date"],
                            "type": "price_adjustment",
                            "details": f"adj_ratio={a['adj_ratio']:.4f} (pClosing_adj={a['pClosing_adj']}, pClosing_raw={a['pClosing_raw']})",
                        }
                    )
                for s in sc:
                    writer.writerow(
                        {
                            "date": s["date"],
                            "type": "share_change",
                            "details": f"ratio={s['ratio']:.4f} (old={s['old_shares']:.0f}, new={s['new_shares']:.0f})",
                        }
                    )
                lines.extend(
                    (
                        "",
                        "## Corporate action events / رویدادهای اقدامات شرکتی",
                        "```csv",
                        buffer.getvalue().rstrip(),
                        "```",
                    )
                )
        else:
            rows = hist
            buffer = io.StringIO()
            columns = (
                "date",
                "first_rial",
                "high_rial",
                "low_rial",
                "closing_rial",
                "last_rial",
                "volume_shares",
                "value_rial",
                "trade_count",
            ) + CLIENT_TYPE_HISTORY_FIELDS
            writer = csv.DictWriter(buffer, fieldnames=columns, lineterminator="\n")
            writer.writeheader()
            writer.writerows(rows)
            lines.extend(
                (
                    "",
                    "## Price history / تاریخچه قیمت (unadjusted)",
                    "```csv",
                    buffer.getvalue().rstrip(),
                    "```",
                )
            )
    if data.get("corrections") is not None:
        lines.extend(corrections_markdown(data["corrections"]))
    if data["errors"]:
        lines.extend(
            (
                "",
                "## Missing or failed sources / داده‌های ناموجود",
                "```json",
                json.dumps(data["errors"], ensure_ascii=False, separators=(",", ":")),
                "```",
            )
        )
    return "\n".join(lines)


def snapshot_meta_text(meta, data):
    """The four header lines stock.sh derives from a .stock snapshot."""
    fetched = data.get("fetched_at") or meta.get("fetched_at") or ""
    when = parse_moment(fetched)
    if when is not None:
        stale = "yes" if (datetime.now(when.tzinfo) - when).total_seconds() > 86400 else "no"
        fetched = jalali_stamp(when)
    else:
        stale = "?" if isinstance(fetched, str) and fetched else ""
    note = meta.get("note")
    note = "" if note in (None, "") else " ".join(str(note).split())
    bits = []
    for value, label in (
        (meta.get("symbol"), ""),
        (meta.get("name"), ""),
        (meta.get("isin"), "ISIN "),
        (meta.get("ins_code"), "insCode "),
        (meta.get("market"), ""),
        (meta.get("source"), "source: "),
    ):
        if value not in (None, ""):
            bits.append(f"{label}{value}")
    return "\n".join(
        (
            fetched or "unknown",
            stale,
            note,
            "Instrument: " + " — ".join(bits) if bits else "",
        )
    )


def render_snapshot_command(command, path):
    """Handle `tse snapshot` / `tse markdown`: read a .stock file and print its
    header lines or its Markdown. Errors keep the wording of the inline probes
    `prompt tse` used before (no `tse: ` prefix)."""
    try:
        if path == "-":
            doc = json.load(sys.stdin)
        else:
            with open(path, encoding="utf-8") as handle:
                doc = json.load(handle)
    except (OSError, ValueError) as exc:
        print(
            f"{path}: not valid JSON: {exc}" if command == "snapshot" else str(exc),
            file=sys.stderr,
        )
        return 1
    meta = doc.get("meta") if isinstance(doc, dict) else None
    data = doc.get("data") if isinstance(doc, dict) else None
    if command == "snapshot":
        if not isinstance(meta, dict) or not isinstance(data, dict):
            print(
                f"{path}: not a .stock snapshot (expected top-level meta and data objects)",
                file=sys.stderr,
            )
            return 1
        print(snapshot_meta_text(meta, data))
        return 0
    if not isinstance(data, dict):
        print("data is not an object", file=sys.stderr)
        return 1
    try:
        output = markdown(data)
    except Exception as exc:
        print(str(exc), file=sys.stderr)
        return 1
    print(output)
    return 0


def main():
    parser = argparse.ArgumentParser(
        description="Fetch public Tehran Stock Exchange data (requires an Iranian IP). Codal filings are a separate tool: tse.codal.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  tse search فولاد
  tse quote فولاد --json
  tse info اهرم
  tse history فولاد --days 30
  tse all فولاد --markdown
  tse all فولاد --days 90 --markdown
  tse all IRT1DARA0001 --markdown
  tse all https://d.easytrader.ir/easy-chart/IRT1DARA0001 --markdown
  tse snapshot stocks/14050717_فولاد_IRO1FOLD0009.stock
  prompt .tse فولاد .tse.analyze
Codal filings are opt-in: `tse.codal snapshot فولاد --markdown` or `prompt tse.codal فولاد`.
History options: --full (all records) is the default; --days N overrides it.""",
    )
    sub = parser.add_subparsers(
        title="commands", metavar="COMMAND", dest="command", required=True
    )
    commands = {
        "search": "Search symbols and company names; output matching instruments as JSON",
        "quote": "Show the latest price, trading activity, and instrument state",
        "book": "Show the five best bid and ask levels (صف خرید/فروش)",
        "flow": "Show individual/legal buyer and seller activity (حقیقی/حقوقی) — share volume, rial value and trader counts when the session is closed",
        "history": "Show daily price history, trading volume, individual/legal (حقیقی/حقوقی) buy and sell volume, rial value and trader counts per day (raw plus split/dividend-adjusted columns)",
        "info": "Show industry, EPS, P/E, share count, market cap, price ranges, and fund NAV",
        "all": "Collect all available data as JSON or Markdown for an AI prompt",
        "snapshot": "Print the cached-snapshot header (fetched time, staleness, note, instrument line) for a .stock file",
        "markdown": "Render a .stock snapshot file (written by tse.snapshot) as Markdown for an AI prompt",
    }
    for name, description in commands.items():
        command = sub.add_parser(name, help=description, description=description)
        if name == "search":
            command.add_argument(
                "symbol",
                metavar="QUERY",
                help="Persian symbol, ISIN, insCode, URL, or company-name text to search",
            )
        elif name in ("snapshot", "markdown"):
            command.add_argument(
                "path",
                metavar="FILE",
                help=".stock snapshot file written by tse.snapshot, or - for stdin",
            )
        else:
            command.add_argument(
                "symbol",
                metavar="SYMBOL",
                help="Persian symbol (e.g. فولاد), ISIN, TSETMC insCode, or easytrader/tsetmc/codal URL",
            )
        if name not in ("search", "all", "snapshot", "markdown"):
            command.add_argument(
                "--json", action="store_true", help="Output JSON instead of Markdown"
            )
        if name in ("history", "all"):
            history_options = command.add_mutually_exclusive_group()
            history_options.add_argument(
                "--days",
                type=int,
                default=None,
                metavar="N",
                help="Number of trading days (1–365; overrides the default full history)",
            )
            history_options.add_argument(
                "--full",
                action="store_true",
                help="Fetch all available daily records (default; may be large)",
            )
            command.add_argument(
                "--unadjusted",
                action="store_true",
                help="Show only unadjusted prices (default includes split/dividend-adjusted)",
            )
        if name == "all":
            command.add_argument(
                "--without",
                action="append",
                metavar="NAME",
                help=(
                    "Skip a section: book, statistics, breadth, corrections"
                    " (repeatable, comma-separated)"
                ),
            )
            command.add_argument(
                "--markdown",
                action="store_true",
                help="Output prompt-ready Markdown instead of JSON",
            )
    args = parser.parse_args()
    if hasattr(args, "days") and args.days is not None and not 1 <= args.days <= 365:
        parser.error("--days must be between 1 and 365")
    skip = set()
    if args.command == "all":
        for item in getattr(args, "without", None) or []:
            for name in item.split(","):
                name = name.strip().lower()
                if name:
                    skip.add(name)
        unknown = skip - {"book", "statistics", "breadth", "corrections"}
        if unknown:
            parser.error(
                "unknown --without name(s): "
                + ", ".join(sorted(unknown))
                + " (choose from book, statistics, breadth, corrections)"
            )
    if args.command in ("snapshot", "markdown"):
        return render_snapshot_command(args.command, args.path)
    history_days = 0 if getattr(args, "days", None) is None else args.days
    client = Client()
    try:
        if args.command == "search":
            result = search(client, args.symbol)
        elif args.command == "all":
            result = collect(
                client,
                args.symbol,
                history_days,
                not getattr(args, "unadjusted", False),
                frozenset(skip),
            )
        else:
            instrument = resolve(client, args.symbol)
            code = instrument["ins_code"]
            if args.command == "quote":
                result = quote(client, code)
            elif args.command == "book":
                result = book(client, code)
            elif args.command == "flow":
                result = flow(client, code)
                # The live endpoint never carries rial values; a completed
                # session's history row does, so borrow them when the snapshot
                # is not a still-trading, partial day (no extra fetch then).
                if not market_session_open(tehran_now()):
                    try:
                        rows_by_date = client_type_history(client, code)
                    except DataError:
                        rows_by_date = {}
                    if rows_by_date:
                        result = attach_session_values(
                            result, [rows_by_date[max(rows_by_date)]]
                        )
            elif args.command == "history":
                history_errors = {}
                result = history(
                    client,
                    code,
                    history_days,
                    not getattr(args, "unadjusted", False),
                    history_errors,
                )
                if history_errors:
                    result["errors"] = history_errors
            elif args.command == "info":
                errors = {}
                try:
                    current = quote(client, code)
                except DataError as exc:
                    current = {}
                    errors["quote"] = str(exc)
                try:
                    ident = identity(client, code)
                except DataError as exc:
                    ident = {"isin": instrument["isin"]}
                    errors["identity"] = str(exc)
                result = info(client, code, ident, current, errors)
                if errors:
                    result["errors"] = errors
    except DataError as exc:
        print(f"tse: {exc}", file=sys.stderr)
        return 1
    if args.command == "all" and args.markdown:
        print(markdown(result))
    elif args.command in ("all", "search") or getattr(args, "json", False):
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        now = tehran_now()
        summary = {
            "fetched_at": jalali_stamp(now),
            "market_session_open": market_session_open(now),
            "instrument": instrument,
            "quote": result if args.command == "quote" else None,
            "order_book": result if args.command == "book" else None,
            "client_type": result if args.command == "flow" else None,
            "indexes": None,
            "market_context": None,
            "history": result if args.command == "history" else None,
            "fundamentals": result if args.command == "info" else None,
            "errors": result.get("errors", {}) if isinstance(result, dict) else {},
        }
        print(markdown(summary))
    return 0


if __name__ == "__main__":
    sys.exit(main())
