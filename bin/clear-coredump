#!/bin/bash

if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    echo "Usage: clear-coredump"
    echo
    echo "Clear coredumps and rotate journal logs."
    echo
    echo "Options:"
    echo "  -h, --help    Show this help message"
    exit 0
fi

if command -v journalctl &> /dev/null;
then
  journalctl --rotate
  journalctl -m --vacuum-time=1s
  rm -rf /var/lib/systemd/coredump/*
else
  echo no journalctl
  exit 1
fi
