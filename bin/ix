#!/usr/bin/env bash

# source is from: ix.io/client

# Examples:
#     ix hello.txt              # paste file (name/ext will be set).
#     echo Hello world. | ix    # read from STDIN (won't set name/ext).
#     ix -n 1 self_destruct.txt # paste will be deleted after one read.
#     ix -i ID hello.txt        # replace ID, if you have permission.
#     ix -d ID

ix() {
    local opts
    local OPTIND
    [ -f "$HOME/.netrc" ] && opts='-n'
    while getopts ":hd:i:n:" x; do
        case $x in
            h) cat <<'HELP'
Usage: ix [OPTIONS] [FILE]

Paste content to ix.io from a file or stdin.

Options:
  -d ID     Delete the paste with the given ID
  -i ID     Replace an existing paste by ID
  -n NUM    Set auto-delete after NUM reads
  -h        Show this help message

Examples:
  ix hello.txt              # paste a file
  echo Hello world | ix     # paste from stdin
  ix -n 1 self_destruct.txt # paste that auto-deletes after one read
  ix -d ID                  # delete a paste
HELP
            return;;
            d) curl "$opts" -X DELETE ix.io/"$OPTARG"; return;;
            i) opts="$opts -X PUT"; local id="$OPTARG";;
            n) opts="$opts -F read:1=$OPTARG";;
            :) echo "Option -$OPTARG requires an argument." >&2; return 1 ;;
            *) echo "Unknown option: -$OPTARG" >&2; return 1 ;;
        esac
    done
    shift $((OPTIND - 1))
    [ -t 0 ] && {
        local filename="$1"
        shift
        [ "$filename" ] && {
            curl "$opts" -F f:1=@"$filename" "$@" ix.io/"$id"
            return
        }
        echo "^C to cancel, ^D to send."
    }
    curl "$opts" -F f:1='<-' "$@" ix.io/"$id"
}

ix "$@"
