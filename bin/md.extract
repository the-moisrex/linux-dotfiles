#!/usr/bin/env python3
"""md.extract - pull code blocks, sections, tables and frontmatter out of Markdown.

Selection is a filter chain over blocks parsed together with their context (the
enclosing heading path plus the prose paragraph before and after), so "the csv
block whose intro says X" is just two independent filters. See --help.
"""

from __future__ import annotations

import argparse
import json
import re
import shutil
import subprocess
import sys
import textwrap
from dataclasses import dataclass, field
from pathlib import Path

PROG = "md.extract"

KINDS = ("code", "table", "section", "frontmatter")
KIND_ORDER = {kind: i for i, kind in enumerate(KINDS)}

# --- Markdown grammar -------------------------------------------------------

FENCE_OPEN = re.compile(
    r"^(?P<lead>[ \t]*(?:>[ \t]?)*[ \t]*)(?P<fence>`{3,}|~{3,})(?P<info>.*)$"
)
FENCE_CLOSE = re.compile(r"^[ \t]*(?:>[ \t]?)*[ \t]*(?P<fence>`{3,}|~{3,})[ \t]*$")
HEADING = re.compile(
    r"^[ \t]*(?:>[ \t]?)*[ \t]*(?P<h>#{1,6})[ \t]+(?P<text>.*?)(?:[ \t]+#+)?[ \t]*$"
)
TABLE_DELIM = re.compile(
    r"^[ \t]*\|?[ \t]*:?-+:?[ \t]*(?:\|[ \t]*:?-+:?[ \t]*)+\|?[ \t]*$"
)
BLOCKQUOTE = re.compile(r"^[ \t]*>[ \t]?")
ATTR = re.compile(
    r"""(?P<key>[A-Za-z_][\w-]*)\s*=\s*(?P<val>"[^"]*"|'[^']*'|[^\s}]+)"""
)

# --- Languages --------------------------------------------------------------
# --lang compares families: `bash`, `console` and `zsh` all mean `sh`,
# `c++`/`cxx`/`hpp` mean `cpp`, and `patch` means `diff`.
LANG_FAMILIES = {
    "diff": ("diff", "patch", "udiff", "unified", "gitdiff"),
    "cpp": ("cpp", "c++", "cxx", "cc", "hh", "hpp", "hxx", "c", "h", "objc",
            "objective-c", "cplusplus"),
    "sh": ("sh", "bash", "shell", "zsh", "console", "shell-session", "sh-session",
           "fish", "ksh", "dash", "posix", "shellscript", "terminal"),
    "python": ("python", "py", "python3", "py3", "python2"),
    "js": ("js", "javascript", "node", "mjs", "cjs", "jsx", "ecmascript"),
    "ts": ("ts", "typescript", "tsx"),
    "json": ("json", "jsonc", "json5", "geojson"),
    "yaml": ("yaml", "yml"),
