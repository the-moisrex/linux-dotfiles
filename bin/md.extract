ALIAS_TO_FAMILY = {
    alias: family for family, aliases in LANG_FAMILIES.items() for alias in aliases
}

EXTENSIONS = {
    "cpp": "cpp", "sh": "sh", "python": "py", "js": "js", "ts": "ts",
    "json": "json", "yaml": "yaml", "toml": "toml", "csv": "csv", "md": "md",
    "html": "html", "xml": "xml", "css": "css", "sql": "sql", "rust": "rs",
