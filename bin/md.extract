KIND_EXTENSIONS = {"frontmatter": "yaml", "section": "md", "table": "md"}


class UsageError(Exception):
    """Bad invocation: exit 2."""


class SoftError(Exception):
    """Nothing matched: exit 1."""


@dataclass
class Block:
    kind: str
    file: str
    start_line: int
    end_line: int
    body: str
    index: int = 0
    lang_raw: str = ""
    lang: str = ""
    info_raw: str = ""
    fence: str = ""
    title: str = ""
    ident: str = ""
    heading_path: list[tuple[int, str]] = field(default_factory=list)
    heading_level: int = 0
    before: str = ""
    after: str = ""
    closed: bool = True
    file_order: int = 0
    program: str = ""
    _guess: str | None = None

    def guessed(self) -> str:
        if self._guess is None:
            self._guess = infer_family(self.body) if self.kind == "code" else ""
        return self._guess


# --- Block parsing helpers --------------------------------------------------


def family(lang: str) -> str:
    key = lang.strip().lower().split()[0] if lang.strip() else ""
    return ALIAS_TO_FAMILY.get(key, key)


def strip_quotes(value: str) -> str:
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    return value


def parse_info(info: str) -> tuple[str, dict[str, str]]:
    """Split a fence info string into (language, attributes)."""
    raw = info.strip()
    attrs: dict[str, str] = {}
    if raw.startswith("{") and raw.endswith("}"):
        for token in raw[1:-1].split():
            if token.startswith("."):
                attrs.setdefault("lang", token[1:])
            elif token.startswith("#"):
                attrs.setdefault("id", token[1:])
            else:
                match = ATTR.fullmatch(token)
                if match:
                    attrs[match["key"].lower()] = strip_quotes(match["val"])
                elif "lang" not in attrs:
                    # Bare `{cpp}` is not CommonMark, but people write it.
                    attrs["lang"] = token
        return attrs.pop("lang", ""), attrs
    for match in ATTR.finditer(raw):
        attrs[match["key"].lower()] = strip_quotes(match["val"])
    rest = ATTR.sub(" ", raw).strip()
    return (rest.split()[0] if rest.split() else ""), attrs


def normalize_body(lines: list[str], quote_depth: int) -> str:
    """Strip the fence's own blockquote/list prefix (nested quotes included)."""
    cleaned = []
    for line in lines:
        for _ in range(quote_depth):
            match = BLOCKQUOTE.match(line)
            if not match:
                break
            line = line[match.end():]
        cleaned.append(line)
    return textwrap.dedent("\n".join(cleaned)).strip("\n")


def strip_quote(line: str) -> str:
    while True:
        match = BLOCKQUOTE.match(line)
        if not match:
            return line
        line = line[match.end():]


def first_line(text: str, limit: int) -> str:
    for line in text.splitlines():
        line = line.strip()
        if line:
            return line if len(line) <= limit else line[: max(1, limit - 1)] + "…"
    return ""


def count_lines(text: str) -> int:
    return len(text.splitlines())


# --- Language sniffing (--guess) --------------------------------------------


def looks_csv(text: str) -> bool:
    import csv
    import io

    rows = [line for line in text.splitlines() if line.strip()][:6]
    if len(rows) < 2 or any("," not in row for row in rows):
        return False
    try:
        counts = [len(next(csv.reader([row]))) for row in rows]
    except (csv.Error, StopIteration):
        return False
    return counts[0] >= 2 and len(set(counts)) == 1


def infer_family(body: str) -> str:
    """Best-effort language guess for an untagged fenced block."""
    text = body.strip("\n")
    if not text:
        return ""
    head = text[:4000]
    first = head.lstrip().split("\n", 1)[0]

    if re.search(r"^diff --git ", head, re.M) or (
        re.search(r"^@@ -\d+", head, re.M) and re.search(r"^(---|\+\+\+) ", head, re.M)
    ):
        return "diff"
    if first.startswith("{") or first.startswith("["):
        try:
            json.loads(text)
            return "json"
        except (ValueError, TypeError):
            pass
    if re.search(r"^#include\s*[<\"]", head, re.M) or "std::" in head:
        return "cpp"
    if first.startswith("#!"):
        lowered = first.lower()
        for name in ("python", "node", "perl", "ruby", "php", "lua"):
            if name in lowered:
                return name
        return "sh"
    if re.match(r"^\s*<!DOCTYPE html|^\s*<html", head, re.I):
        return "html"
    if looks_csv(head):
        return "csv"
    if re.match(r"^\s*(select|insert\s+into|update|delete\s+from|create\s+table|with)\b",
                first, re.I) and re.search(r"\b(from|where|values)\b", head, re.I):
        return "sql"
    if re.search(r"^package [\w/]+$", head, re.M) and re.search(r"^func ", head, re.M):
        return "go"
    if re.search(r"^use .*;$", head, re.M) and re.search(r"\bfn main\s*\(", head):
        return "rust"
    if re.search(r"^cmake_minimum_required\b", head, re.M) or re.search(
        r"^(add_executable|target_link_libraries)\s*\(", head, re.M
    ):
        return "cmake"
    if re.match(r"^FROM \S+", head, re.M) and re.search(
        r"^(RUN|COPY|ADD|CMD|ENTRYPOINT)\b", head, re.M
    ):
        return "docker"
    if re.search(r"^using System", head, re.M):
        return "csharp"
    if re.search(r"^(public|private)\s+(class|interface|enum)\b", head, re.M):
        return "java"
    if re.search(r"^(def|class)\s+\w+.*:\s*$", head, re.M) or re.search(
        r"^(import|from)\s+\w+", head, re.M
    ):
        return "python"
    if re.search(r"^(sudo|export|apt|pacman|cd|echo|mkdir|rm|cp|mv)\b", head, re.M) or re.search(
        r"^\$ ", head, re.M
    ):
        return "sh"
    if re.search(r"^\s*```", head, re.M):
        return "md"
    return ""


# --- Document parsing -------------------------------------------------------


def assign_indices(blocks: list[Block]) -> None:
    """Put blocks in document order and give them provisional per-kind numbers."""
    blocks.sort(
        key=lambda block: (
            block.file_order,
            block.start_line,
            KIND_ORDER.get(block.kind, 99),
        )
    )
    counters: dict[str, int] = {}
    for block in blocks:
        counters[block.kind] = counters.get(block.kind, 0) + 1
        block.index = counters[block.kind]


def parse_document(
    text: str,
    name: str,
    *,
    file_order: int = 0,
    indented: bool = False,
    include_subsections: bool = True,
) -> list[Block]:
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    if text.startswith("\ufeff"):
        text = text[1:]
    lines = text.split("\n")
    total = len(lines)

    blocks: list[Block] = []
    paragraphs: list[tuple[int, int, str]] = []
    headings: list[tuple[int, str, int, list[tuple[int, str]]]] = []
    struct_starts: list[int] = []
    stack: list[tuple[int, str]] = []
    buffer: list[str] = []
    buffer_start = 0
    last_prose = ""

    def flush(end_line: int) -> None:
        nonlocal buffer, last_prose
        if not buffer:
            return
        paragraph = "\n".join(strip_quote(line) for line in buffer).strip("\n")
        paragraphs.append((buffer_start, end_line, paragraph))
        if paragraph:
            last_prose = paragraph
        buffer = []

    def add(block: Block) -> None:
        block.file_order = file_order
        block.before = last_prose
        block.lang = family(block.lang_raw)
        blocks.append(block)
        struct_starts.append(block.start_line)

    i = 0
    while i < total:
        line = lines[i]
        lineno = i + 1

        if i == 0 and line.strip() in ("---", "+++"):
            mark = line.strip()
            close = next((j for j in range(1, total) if lines[j].strip() == mark), None)
            if close is not None:
                add(
                    Block(
                        kind="frontmatter",
                        file=name,
                        start_line=1,
                        end_line=close + 1,
                        body="\n".join(lines[1:close]).strip("\n"),
                        lang_raw="yaml" if mark == "---" else "toml",
                        info_raw=mark,
                    )
                )
                struct_starts.append(close + 1)
                last_prose = ""
                i = close + 1
                continue

        fence = FENCE_OPEN.match(line)
        if fence and not (fence["fence"][0] == "`" and "`" in fence["info"]):
            flush(i)
            marker = fence["fence"]
            character = marker[0]
            content: list[str] = []
            j = i + 1
            closed = False
            while j < total:
                closing = FENCE_CLOSE.match(lines[j])
                if (
                    closing
                    and closing["fence"][0] == character
                    and len(closing["fence"]) >= len(marker)
                ):
                    closed = True
                    break
                content.append(lines[j])
                j += 1
            if not closed:
                print(
                    f"{PROG}: {name}:{lineno}: unterminated {marker} fence (runs to EOF)",
                    file=sys.stderr,
                )
            lang_raw, attrs = parse_info(fence["info"])
            add(
                Block(
                    kind="code",
                    file=name,
                    start_line=lineno,
                    end_line=(j + 1) if closed else total,
                    body=normalize_body(content, fence["lead"].count(">")),
                    lang_raw=lang_raw,
                    info_raw=fence["info"],
                    fence=marker,
                    title=attrs.get("title") or attrs.get("name") or attrs.get("file", ""),
                    ident=attrs.get("id", ""),
                    heading_path=list(stack),
                    closed=closed,
                )
            )
            i = j + 1
            continue

        heading = HEADING.match(line)
        if heading:
            flush(i)
            last_prose = ""
            level = len(heading["h"])
            text_ = heading["text"].strip()
            while stack and stack[-1][0] >= level:
                stack.pop()
            headings.append((level, text_, lineno, list(stack)))
            stack.append((level, text_))
            struct_starts.append(lineno)
            i += 1
            continue

        if (
            "|" in line
            and line.strip()
            and i + 1 < total
            and TABLE_DELIM.match(lines[i + 1])
        ):
            flush(i)
            j = i + 2
            while j < total and lines[j].strip() and "|" in lines[j]:
                j += 1
            add(
                Block(
                    kind="table",
                    file=name,
                    start_line=lineno,
                    end_line=j,
                    body="\n".join(lines[i:j]).strip("\n"),
                    heading_path=list(stack),
                )
            )
            last_prose = ""
            i = j
            continue

        if (line.startswith("    ") or line.startswith("\t")) and (
            i == 0 or not lines[i - 1].strip()
        ):
            j = i
            content = []
            while j < total:
                current = lines[j]
                if not current.strip():
                    content.append("")
                    j += 1
                elif current.startswith("    "):
                    content.append(current[4:])
                    j += 1
                elif current.startswith("\t"):
                    content.append(current[1:])
                    j += 1
                else:
                    break
            body = "\n".join(content).strip("\n")
            if body:
                flush(i)
                # Recognised always, extracted only with --indented, so the
                # 4-space rule never leaks into the prose label of a later block.
                if indented:
                    add(
                        Block(
                            kind="code",
                            file=name,
                            start_line=lineno,
                            end_line=j,
                            body=body,
                            heading_path=list(stack),
                        )
                    )
                struct_starts.append(lineno)
                last_prose = ""
                i = j
                continue

        if not line.strip():
            flush(i)
            i += 1
            continue

        if not buffer:
            buffer_start = lineno
        buffer.append(line)
        i += 1

    flush(total)

    # Sections are derived from the heading list, not the line loop.
    for position, (level, heading_text, lineno, ancestors) in enumerate(headings):
        stop = total
        for later_level, _later_text, later_line, _later in headings[position + 1 :]:
            if include_subsections and later_level > level:
                continue  # a subsection belongs to this section
            stop = later_line - 1
            break
        body = "\n".join(lines[lineno:stop]).strip("\n") if stop > lineno else ""
        blocks.append(
            Block(
                kind="section",
                file=name,
                file_order=file_order,
                start_line=lineno,
                end_line=stop if stop >= lineno else lineno,
                body=body,
                title=heading_text,
                heading_level=level,
                heading_path=ancestors,
            )
        )

    for block in blocks:
        next_start = min(
            (candidate for candidate in struct_starts if candidate > block.end_line),
            default=None,
        )
        for start, _end, paragraph in paragraphs:
            if start > block.end_line and (next_start is None or start < next_start):
                block.after = paragraph
                break
    return blocks


# --- Selection --------------------------------------------------------------


@dataclass
class Query:
    kinds: set[str]
    langs: list[str]
    guess: bool
    heading: list[re.Pattern]
    under: list[re.Pattern]
    before: list[re.Pattern]
    after: list[re.Pattern]
    title: list[re.Pattern]
    grep: list[re.Pattern]


def compile_patterns(values: list[str], literal: bool) -> list[re.Pattern]:
    patterns: list[re.Pattern] = []
    for value in values:
        try:
            patterns.append(re.compile(re.escape(value) if literal else value, re.I))
        except re.error as error:
            raise UsageError(f"invalid pattern {value!r}: {error}") from error
    return patterns


def display_lang(block: Block, guess: bool) -> str:
    if block.lang:
        return block.lang
    guessed = block.guessed() if guess else ""
    return f"{guessed}?" if guessed else ""


def lang_matches(block: Block, wanted: list[str], guess: bool) -> bool:
    if not wanted:
        return True
    if "*" in wanted:
        return True
    families = [family(value) for value in wanted]
    if not block.lang:
        if "any" in families or "untagged" in families:
            return True
        return bool(guess and block.guessed() in families)
    return block.lang in families


def nearest_heading(block: Block) -> str:
    if block.kind == "section":
        return block.title
    return block.heading_path[-1][1] if block.heading_path else ""


def heading_texts(block: Block) -> list[str]:
    texts = [text for _level, text in block.heading_path]
    if block.kind == "section" and block.title:
        texts.append(block.title)
    return texts


def full_heading(block: Block) -> str:
    return " > ".join(heading_texts(block))


def matches_query(block: Block, query: Query) -> bool:
    if block.kind not in query.kinds:
        return False
    # A language only means something for code (and the frontmatter dialect).
    if query.langs and block.kind not in ("code", "frontmatter"):
        return False
    if not lang_matches(block, query.langs, query.guess):
        return False
    if query.heading and not any(pattern.search(nearest_heading(block)) for pattern in query.heading):
        return False
    if query.under and not any(
        pattern.search(text) for pattern in query.under for text in heading_texts(block)
    ):
        return False
    if query.before and not any(pattern.search(block.before) for pattern in query.before):
        return False
    if query.after and not any(pattern.search(block.after) for pattern in query.after):
        return False
    if query.title:
        haystack = "\n".join((block.title, block.ident, block.info_raw))
        if not any(pattern.search(haystack) for pattern in query.title):
            return False
    if query.grep and not any(pattern.search(block.body) for pattern in query.grep):
        return False
    return True


def parse_index_spec(raw: str) -> list[int]:
    values: list[int] = []
    for part in raw.split(","):
        part = part.strip()
        if not part:
            continue
        ranged = re.fullmatch(r"(-?\d+)\s*-\s*(-?\d+)", part)
        if ranged:
            start, end = int(ranged[1]), int(ranged[2])
            if start == 0 or end == 0:
                raise UsageError("--index is 1-based; 0 is not a block")
            step = 1 if end >= start else -1
            values.extend(range(start, end + step, step))
            continue
        if re.fullmatch(r"-?\d+", part):
            value = int(part)
            if value == 0:
                raise UsageError("--index is 1-based; 0 is not a block")
            values.append(value)
            continue
        raise UsageError(f"invalid --index value {part!r} (try 3, 2-5, 1,4 or -1)")
    return values


def select_blocks(
    blocks: list[Block], query: Query, index_values: list[int] | None
) -> list[Block]:
    matched = [
        block
        for block in blocks
        if block.kind in query.kinds and matches_query(block, query)
    ]
    if not index_values:
        return matched
    picked: list[Block] = []
    seen: set[int] = set()
    for value in index_values:
        position = value - 1 if value > 0 else len(matched) + value
        if position < 0 or position >= len(matched):
            continue
        block = matched[position]
        if id(block) not in seen:
            seen.add(id(block))
            picked.append(block)
    if not picked:
        raise SoftError(
            f"index {', '.join(str(value) for value in index_values)} is out of range"
            f" (the selection holds {len(matched)} blocks)"
        )
    return picked


# --- Selectors --------------------------------------------------------------


@dataclass
class Selector:
    """The `kind[:qualifier][@position]` grammar shared by --select/--items/--contract.

    A bare word that is not a kind is a section heading. `.expect`, `.extract`,
    `.each` and `.exec` hand the same string to this parser, so the grammar
    lives in exactly one place.
    """

    kind: str
    qualifier: str = ""
    position: int | None = None


SELECTOR_KINDS = set(KINDS) | {"auto", "any", "all", "none"}


def parse_selector(raw: str) -> Selector:
    raw = raw.strip()
    if not raw:
        raise UsageError("empty selector")
    position: int | None = None
    match = re.search(r"@(-?\d+)$", raw)
    if match:
        position = int(match[1])
        raw = raw[: match.start()]
    if raw in ("auto", "any", "all", "none"):
        return Selector("any" if raw == "all" else raw, "", position)
    if ":" in raw:
        kind, qualifier = raw.split(":", 1)
        kind = kind.strip().lower()
        qualifier = qualifier.strip()
    else:
        kind, qualifier = raw.lower(), ""
    if kind not in SELECTOR_KINDS:
        # A bare word is the heading of the section to take.
        return Selector("section", raw, position)
    if kind == "all":
        kind = "any"
    return Selector(kind, qualifier, position)


def split_table_row(line: str) -> list[str]:
    text = line.strip()
    if text.startswith("|"):
        text = text[1:]
    if text.endswith("|"):
        text = text[:-1]
    cells: list[str] = []
    current: list[str] = []
    escaped = False
    for char in text:
        if escaped:
            current.append(char)
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == "|":
            cells.append("".join(current).strip())
            current = []
        else:
            current.append(char)
    cells.append("".join(current).strip())
    return cells


def table_headers(block: Block) -> list[str]:
    lines = [line for line in block.body.splitlines() if line.strip()]
    return split_table_row(lines[0]) if lines else []


def table_rows(block: Block) -> list[dict[str, str]]:
    lines = [line for line in block.body.splitlines() if line.strip()]
    if len(lines) < 2:
        return []
    headers = split_table_row(lines[0])
    rows: list[dict[str, str]] = []
    for line in lines[2:]:
        cells = split_table_row(line)
        cells = (cells + [""] * len(headers))[: len(headers)]
        rows.append(dict(zip(headers, cells)))
    return rows


def table_columns(block: Block) -> list[str]:
    return table_headers(block)


def command_line(block: Block) -> str:
    """The command a code/command block carries: its first non-comment line.

    A leading shell prompt (`$ `) is a transcript marker, not part of the
    command, so it is stripped.
    """
    if block.kind not in ("code", "command") or not block.body.strip():
        return ""
    for raw in block.body.splitlines():
        text = raw.strip()
        if not text or text.startswith("#"):
            continue
        if text.startswith("$ "):
            text = text[2:].strip()
        return text
    return ""


def derive_command(block: Block) -> Block | None:
    """A code block viewed as the command on its first non-comment line."""
    line = command_line(block)
    if block.kind != "code" or not line:
        return None
    try:
        words = shlex.split(line)
    except ValueError:
        words = line.split()
    if not words:
        return None
    return Block(
        kind="command",
        file=block.file,
        start_line=block.start_line,
        end_line=block.end_line,
        body=block.body,
        lang_raw=block.lang_raw,
        lang=block.lang,
        info_raw=block.info_raw,
        fence=block.fence,
        title=block.title,
        ident=block.ident,
        heading_path=block.heading_path,
        heading_level=block.heading_level,
        before=block.before,
        after=block.after,
        closed=block.closed,
        file_order=block.file_order,
        program=Path(words[0]).name,
    )


def derive_commands(blocks: list[Block]) -> list[Block]:
    derived: list[Block] = []
    for block in blocks:
        command = derive_command(block)
        if command is not None:
            derived.append(command)
    return derived


# A labelled line, e.g. `filename: fix-parser.prompt`, `filename = x`, or
# `- **filename**: x`. The label may not contain `:`/`=`, so the first colon or
# equals is the separator.
FIELD_LINE = re.compile(
    r"^[ \t]*(?:[-*][ \t]+)?(?:\*\*)?(?P<label>[^:*=\n]+?)(?:\*\*)?[ \t]*[:=][ \t]*(?P<value>.+?)[ \t]*$"
)


def clean_field_value(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'`":
        value = value[1:-1].strip()
    return value


def find_fields(text: str, label: str) -> list[tuple[str, int]]:
    """Every `label: value` line (case-insensitive), as a list of (value, line number)."""
    wanted = label.strip().lower()
    found: list[tuple[str, int]] = []
    for lineno, line in enumerate(text.split("\n"), 1):
        match = FIELD_LINE.match(line)
        if not match or match["label"].strip().lower() != wanted:
            continue
        value = clean_field_value(match["value"])
        if value:
            found.append((value, lineno))
    return found


def field_blocks(texts: list[tuple[str, str]], label: str) -> list[Block]:
    """Synthetic field blocks, so the selector pipeline can render/position them."""
    if not label:
        raise UsageError("the field selector needs a label: field:filename")
    blocks: list[Block] = []
    for file_order, (name, text) in enumerate(texts):
        for value, lineno in find_fields(text, label):
            blocks.append(
                Block(
                    kind="field",
                    file=name,
                    file_order=file_order,
                    start_line=lineno,
                    end_line=lineno,
                    body=value,
                )
            )
    return blocks


def selector_kinds(selector: Selector) -> set[str]:
    if selector.kind == "auto":
        return set(SOURCE_KINDS)
    if selector.kind == "any":
        return set(SOURCE_KINDS)
    if selector.kind == "none":
        return set()
    return {selector.kind}


def auto_select(blocks: list[Block]) -> list[Block]:
    # A `command` is a view of a code block, not a second candidate: auto picks
    # the only table, code block or section, and refuses when the answer has
    # more than one shape (the caller must then name the selector).
    groups = (
        ("table", [block for block in blocks if block.kind == "table"]),
        ("code", [block for block in blocks if block.kind == "code"]),
        ("section", [block for block in blocks if block.kind == "section"]),
    )
    nonempty = [(name, group) for name, group in groups if group]
    if len(nonempty) == 1 and len(nonempty[0][1]) == 1:
        return nonempty[0][1]
    counts = ", ".join(f"{len(group)} {name}" for name, group in nonempty)
    raise SoftError(
        "cannot auto-select: "
        + (counts or "no blocks")
        + "; pass a selector (e.g. table, table:column, code:sh, command:prompt)"
    )


def drop_nested(blocks: list[Block]) -> list[Block]:
    """Keep top-level blocks when a selected section already contains them."""
    sections = [block for block in blocks if block.kind == "section"]
    return [
        block
        for block in blocks
        if not any(
            section is not block
            and section.file == block.file
            and section.start_line <= block.start_line <= section.end_line
            for section in sections
        )
    ]


def apply_position(blocks: list[Block], selector: Selector) -> list[Block]:
    if selector.position is None:
        return blocks
    position = selector.position - 1 if selector.position > 0 else len(blocks) + selector.position
    if position < 0 or position >= len(blocks):
        raise SoftError(
            f"position {selector.position} is out of range"
            f" (the selector matched {len(blocks)} block{'s' if len(blocks) != 1 else ''})"
        )
    return [blocks[position]]


def select_selector(blocks: list[Block], selector: Selector) -> list[Block]:
    if selector.kind == "none":
        raise SoftError("the 'none' selector has no blocks")
    if selector.kind == "auto":
        return apply_position(auto_select(blocks), selector)

    query = Query(
        kinds=selector_kinds(selector),
        langs=[],
        guess=False,
        heading=[],
        under=[],
        before=[],
        after=[],
        title=[],
        grep=[],
    )
    if selector.kind == "code" and selector.qualifier:
        query.langs = [selector.qualifier]
    elif selector.kind == "section" and selector.qualifier:
        query.heading = compile_patterns([selector.qualifier], False)

    matched = select_blocks(blocks, query, None)
    if selector.kind == "table" and selector.qualifier:
        wanted = [column.strip().lower() for column in selector.qualifier.split(",") if column.strip()]
        kept = []
        for block in matched:
            have = [column.lower() for column in table_headers(block)]
            if all(column in have for column in wanted):
                kept.append(block)
        if not kept:
            available = sorted({column for block in matched for column in table_headers(block)})
            raise SoftError(
                "no table has "
                + ", ".join(wanted)
                + " (available columns: "
                + (", ".join(available) if available else "none")
                + ")"
            )
        matched = kept
    elif selector.kind == "command" and selector.qualifier:
        wanted = selector.qualifier.lower()
        matched = [block for block in matched if wanted == "*" or block.program.lower() == wanted]

    return apply_position(matched, selector)


def render_projection(block: Block, columns: list[str], header: bool) -> str:
    headers = table_headers(block)
    names = {name.lower(): name for name in headers}
    chosen = [names[column.lower()] for column in columns if column.lower() in names]
    lines: list[str] = []
    if header:
        lines.append("\t".join(chosen))
    for row in table_rows(block):
        lines.append("\t".join(row.get(name, "") for name in chosen))
    return "\n".join(lines)


def render_selection(blocks: list[Block], selector: Selector, args: argparse.Namespace) -> str:
    if selector.kind == "table" and selector.qualifier:
        columns = [column.strip() for column in selector.qualifier.split(",") if column.strip()]
        rendered = [render_projection(block, columns, not args.no_header) for block in blocks]
        return "\n\n".join(part for part in rendered if part) + ("\n" if rendered else "")
    if selector.kind == "section":
        parts = []
        for block in blocks:
            heading = ""
            if block.kind == "section" and block.heading_level:
                heading = "#" * block.heading_level + " " + block.title
            body = block.body if block.kind == "section" else render_block(block, args)
            parts.append("\n\n".join(part for part in (heading, body) if part))
        return "\n\n".join(parts) + ("\n" if parts else "")
    if selector.kind == "any" or blocks and blocks[0].kind == "command":
        # A section already renders its nested code/tables; keeping both would
        # print the same content twice.
        parts = []
        for block in drop_nested(blocks):
            if block.kind == "section" and block.heading_level:
                parts.append("#" * block.heading_level + " " + block.title + "\n\n" + block.body)
            elif block.kind == "command":
                parts.append(command_line(block))
            else:
                parts.append(block.body)
        return "\n\n".join(parts) + ("\n" if parts else "")
    return render_many(blocks, args)


def selector_items(blocks: list[Block], selector: Selector, guess: bool) -> list[dict[str, object]]:
    selected = select_selector(blocks, selector)
    if selector.kind == "any":
        selected = drop_nested(selected)
    items: list[dict[str, object]] = []

    def table_items(group: list[Block], qualifier: str = "") -> None:
        columns = [column.strip() for column in qualifier.split(",") if column.strip()]
        for block in group:
            if block.kind != "table":
                continue
            headers = table_headers(block)
            if columns:
                names = {name.lower(): name for name in headers}
                headers = [names[column.lower()] for column in columns if column.lower() in names]
            for row_index, row in enumerate(table_rows(block), 1):
                record: dict[str, object] = {column: row.get(column, "") for column in headers}
                text = "\t".join(record[column] for column in headers)
                record.setdefault("item", text)
                record.setdefault("body", text)
                record["_row"] = row_index
                record["_table"] = block.index
                items.append(record)

    if selector.kind == "table":
        table_items(selected, selector.qualifier)
    elif selector.kind == "auto" and selected and selected[0].kind == "table":
        table_items(selected)
    else:
        for block in selected:
            if block.kind == "table":
                table_items([block])
                continue
            record = block_record(block, guess)
            text = command_line(block) if block.kind == "command" else block.body
            record.setdefault("item", text)
            record.setdefault("body", text)
            if block.kind == "command":
                record.setdefault("command", text)
                record.setdefault("program", block.program)
            items.append(record)
    return items


def contract_for(selector: Selector) -> str:
    kind = selector.kind
    qualifier = selector.qualifier
    if kind == "none":
        return (
            "Answer in plain prose. Do not add code fences, tables or headings unless the answer genuinely needs "
            "them.\n"
        )
    if kind == "table":
        if qualifier:
            columns = ", ".join(f"`{column.strip()}`" for column in qualifier.split(",") if column.strip())
            return (
                "Return exactly one Markdown table with a header row and these columns: "
                + columns
                + ". Put no prose before or after the table.\n"
            )
        return "Return exactly one Markdown table with a header row. Put no prose before or after the table.\n"
    if kind == "code":
        language = f" tagged `{qualifier}`" if qualifier else ""
        return (
            f"Return exactly one fenced code block{language} containing only the code. "
            "Put no prose before or after the block.\n"
        )
    if kind == "section":
        heading = qualifier or "Answer"
        return (
            f"Use a Markdown section headed `{heading}` and put the whole answer under it. "
            "Do not add other top-level sections.\n"
        )
    if kind == "command":
        program = f" `{qualifier}`" if qualifier else ""
        return (
            f"Return exactly one fenced `sh` code block containing a single{program} command line. "
            "Put no prose, no explanation and no other code blocks before or after it.\n"
        )
    if kind == "frontmatter":
        return (
            "Begin the response with a YAML frontmatter block delimited by `---` lines, then the answer.\n"
        )
    if kind == "field":
        label = qualifier or "value"
        return (
            f"Also include a line `{label}: <value>` carrying the requested value, on a line of its own.\n"
        )
    if kind == "any":
        return "Return only the requested block or blocks, with no surrounding commentary.\n"
    return (
        "Return only the requested result (a table, code block, section or command), "
        "with no surrounding commentary.\n"
    )


def describe_selector(selector: Selector) -> str:
    """One line of a combined multi-part contract, without the trailing period."""
    kind = selector.kind
    qualifier = selector.qualifier
    if kind == "field":
        return f"a line `{qualifier or 'value'}: <value>` carrying the requested value"
    if kind == "table":
        if qualifier:
            columns = ", ".join(f"`{column.strip()}`" for column in qualifier.split(",") if column.strip())
            return f"one Markdown table with a header row and these columns: {columns}"
        return "one Markdown table with a header row"
    if kind == "code":
        language = f" tagged `{qualifier}`" if qualifier else ""
        return f"one fenced code block{language} containing only the code"
    if kind == "command":
        program = f" `{qualifier}`" if qualifier else ""
        return f"one fenced `sh` code block containing a single{program} command line"
    if kind == "section":
        return f"a Markdown section headed `{qualifier or 'Answer'}` containing the answer"
    if kind == "frontmatter":
        return "a leading YAML frontmatter block"
    if kind == "none":
        return "plain prose"
    return "the requested result"


def combined_contract(selectors: list[Selector]) -> str:
    """One coherent instruction for several selectors (a `.expect` plan)."""
    lines = ["Return one answer containing all of the following, and nothing else:"]
    for position, selector in enumerate(selectors, 1):
        lines.append(f"{position}. {describe_selector(selector)}.")
    if any(selector.kind == "field" for selector in selectors):
        lines.append(
            "Put every `name: <value>` line in one block so it is easy to read, "
            "and use the exact label shown."
        )
    return "\n".join(lines) + "\n"


def render_kinds() -> str:
    return "\n".join(
        (
            "code         fenced ``` / ~~~ blocks (and 4-space blocks with --indented)",
            "table        GFM tables; table:col1,col2 projects named columns",
            "section      a heading and everything under it",
            "frontmatter  the leading --- / +++ block",
            "command      a code block viewed as the command on its first line;",
            "             command:program filters by that program's basename",
            "field        a `label: value` line; field:label reads that value",
            "any          the four source kinds above (commands and fields are opt-in)",
            "auto         the only table, code block or section in the document",
        )
    )


# --- Rendering --------------------------------------------------------------


def render_block(block: Block, args: argparse.Namespace) -> str:
    parts: list[str] = []
    if args.with_heading:
        parts.extend("#" * level + " " + text for level, text in block.heading_path)
        if block.kind == "section" and block.heading_level:
            parts.append("#" * block.heading_level + " " + block.title)
    if args.with_intro and block.before:
        parts.append(block.before)

    if block.kind == "frontmatter" and args.fence:
        mark = block.info_raw.strip() or "---"
        parts.append(mark + "\n" + block.body + "\n" + mark)
    elif block.kind == "section" and args.fence:
        if not args.with_heading:
            parts.append("#" * (block.heading_level or 1) + " " + block.title)
        parts.append(block.body)
    elif block.kind == "table":
        parts.append(block.body)
    elif block.kind == "command":
        parts.append(command_line(block))
    elif args.fence:
        marker = block.fence or "```"
        parts.append(marker + block.info_raw.rstrip() + "\n" + block.body + "\n" + marker)
    else:
        parts.append(block.body)
    return "\n\n".join(part for part in parts if part != "").strip("\n")


def render_many(blocks: list[Block], args: argparse.Namespace) -> str:
    rendered = [render_block(block, args).rstrip("\n") for block in blocks]
    return "\n\n".join(rendered) + ("\n" if rendered else "")


def render_list(blocks: list[Block], guess: bool) -> str:
    header = ["IDX", "KIND", "LANG", "LINES", "HEADING", "LABEL", "SOURCE"]
    rows = [header]
    for block in blocks:
        lang = display_lang(block, guess)
        if not lang:
            lang = "?" if block.kind == "code" else "-"
        rows.append(
            [
                str(block.index),
                block.kind,
                lang,
                str(count_lines(block.body)),
                first_line(full_heading(block), 36),
                first_line(block.before, 44),
                f"{block.file}:{block.start_line}",
            ]
        )
    widths = [max(len(row[column]) for row in rows) for column in range(len(header))]
    return "\n".join(
        "  ".join(cell.ljust(widths[column]) for column, cell in enumerate(row)).rstrip()
        for row in rows
    )


def block_record(block: Block, guess: bool) -> dict[str, object]:
    return {
        "file": block.file,
        "kind": block.kind,
        "index": block.index,
        "lang": display_lang(block, guess),
        "lang_raw": block.lang_raw,
        "info": block.info_raw.strip(),
        "title": block.title,
        "id": block.ident,
        "heading": full_heading(block),
        "heading_path": [
            {"level": level, "text": text} for level, text in block.heading_path
        ],
        "before": block.before,
        "after": block.after,
        "line": block.start_line,
        "end_line": block.end_line,
        "lines": count_lines(block.body),
        "closed": block.closed,
        "body": block.body,
        "program": block.program,
    }


# --- Writing files ----------------------------------------------------------


def sanitize_name(name: str) -> str:
    cleaned = re.sub(r"[^\w.@+-]+", "-", name, flags=re.UNICODE).strip(".-_")
    return cleaned or "block"


def target_name(block: Block, ext_override: str | None, guess: bool = False) -> str:
    title = block.title or block.ident
    if title:
        stem = sanitize_name(Path(title).name)
    else:
        language = block.lang or (block.guessed() if guess else "")
        stem = f"{language or block.kind}-{block.index}"
    if ext_override:
        return Path(stem).stem + "." + ext_override
    if not Path(stem).suffix:
        extension = (
            EXTENSIONS.get(block.lang or (block.guessed() if guess else ""))
            or KIND_EXTENSIONS.get(block.kind)
            or "txt"
        )
        stem += "." + extension
    return stem


def write_blocks(blocks: list[Block], args: argparse.Namespace) -> None:
    if args.out_dir and args.output:
        raise UsageError("use either -o/--output or --out-dir, not both")
    if args.output:
        if len(blocks) != 1:
            raise UsageError(
                f"-o/--output needs exactly one block, got {len(blocks)}"
                " (narrow the selection or use --out-dir)"
            )
        targets = [(Path(args.output), blocks[0])]
    else:
        directory = Path(args.out_dir)
        used: set[str] = set()
        targets: list[tuple[Path, Block]] = []
        for block in blocks:
            name = target_name(block, args.ext, args.guess)
            if name in used:
                stem, _dot, suffix = name.rpartition(".")
                name = (stem or name) + f"-{block.index}" + (("." + suffix) if stem else "")
            used.add(name)
            targets.append((directory / name, block))

    conflicts = [str(path) for path, _block in targets if path.exists() and not args.force]
    if conflicts:
        raise UsageError("refusing to overwrite (use --force): " + ", ".join(conflicts))

    if args.dry_run:
        for path, block in targets:
            print(f"{path}\t{count_lines(block.body)} lines")
        return

    for path, block in targets:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(block.body.rstrip("\n") + "\n", encoding="utf-8")
        print(f"{PROG}: wrote {path}", file=sys.stderr)


def pick_block(blocks: list[Block], guess: bool) -> list[Block]:
    executable = shutil.which("fzf")
    if not executable:
        raise UsageError("--pick needs fzf on PATH")
    rows = []
    for sequence, block in enumerate(blocks):
        rows.append(
            "\t".join(
                [
                    str(sequence),
                    str(block.index),
                    block.kind,
                    display_lang(block, guess) or "?",
                    str(count_lines(block.body)),
                    first_line(full_heading(block), 60),
                    first_line(block.before, 60),
                    f"{block.file}:{block.start_line}",
                ]
            )
        )
    result = subprocess.run(
        [executable, "--delimiter=\t", "--with-nth=2..", "--prompt=block> ", "--height=60%"],
        input="\n".join(rows) + "\n",
        text=True,
        capture_output=True,
    )
    if result.returncode != 0 or not result.stdout.strip():
        raise SoftError("selection cancelled")
    return [blocks[int(result.stdout.split("\t", 1)[0])]]


# --- Command line -----------------------------------------------------------

DESCRIPTION = """\
Extract blocks from Markdown on stdin or in FILE arguments. `--list` numbers
the rows of the current selection, so `--list` then `-n N` (with the same
flags) is a reliable two-step workflow; every other selector is an independent
filter, and they combine with AND.

Default output is the block body alone, so the tool composes:

  md.extract --lang diff answer.md | git apply
  md.extract --kind csv --before "monthly totals" report.md > totals.csv
  md.extract --kind section --heading Installation README.md
  md.extract --lang cpp --one answer.md > parser.cpp
  md.extract --select table:symbol answer.md
  md.extract --select command:prompt answer.md | sh
  md.extract --select field:filename answer.md
  md.extract --items table:symbol,reason answer.md
  md.extract --contract command:prompt
  md.extract --list answer.md
"""

EPILOG = """\
KINDS
  code         fenced ``` / ~~~ blocks (and 4-space blocks with --indented)
  table        GFM tables (header + delimiter row)
  section      a heading and everything under it (--no-subsections to stop)
  frontmatter  the leading --- / +++ block
  command      a code block viewed as the command on its first line
  field        a `label: value` line viewed as its value (field:label)
  any          the four source kinds above (commands are opt-in)

SELECTORS
  --select SPEC, --items SPEC and --contract SPEC share one grammar:
  kind[:qualifier][@N]. `table:symbol,reason` projects those columns (tab
  separated); `code:cpp` filters by language; `section:Usage` by heading;
  `command:prompt` keeps code blocks whose first command is `prompt`;
  `field:filename` reads the value of a `filename:` line; `@2` is the second
  match. `any` means the four source kinds, `auto` picks the only table, code
  block or section, and `none` asks an AI for prose. --items prints a JSON
  array of items (table rows become objects keyed by their columns), and
  --contract prints the response instruction for an AI (repeat --contract for a
  combined multi-part contract). See --kinds for the current grammar.

CONTEXT
  code, table and frontmatter blocks carry the nearest enclosing heading path
  and the prose paragraph right before them (`before`) and after them
  (`after`). `before` persists across consecutive fences, so one intro labels a
  group; a heading resets it. IDX numbers the rows of the current selection,
  so `--list` with your filters then `--index N` names exactly that row.

PATTERNS
  Case-insensitive regular expressions unless -F/--literal. A selector given
  twice, or comma-separated, matches any of its values.

LANGUAGES
  --lang compares language families: c++/cxx/hpp mean cpp, bash/console/zsh
  mean sh, patch means diff, py means python. `any` selects untagged blocks and
  `*` selects every language. With --guess, untagged bodies are sniffed and
  shown as `cpp?` by --list.

EXIT STATUS
  0  at least one block was printed or written
  1  nothing matched (or the picker was cancelled)
  2  usage error: bad option, unreadable file, --one saw several blocks,
     refusing to overwrite
"""


class CommaList(argparse.Action):
    def __call__(self, parser, namespace, values, option_string=None):
        current = list(getattr(namespace, self.dest) or [])
        for value in values.split(","):
            value = value.strip()
            if value:
                current.append(value)
        setattr(namespace, self.dest, current)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROG,
        description=DESCRIPTION,
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "files",
        nargs="*",
        metavar="FILE",
        help="Markdown files ('-' for stdin); stdin when omitted",
    )

    selection = parser.add_argument_group("selection")
    selection.add_argument(
        "--kind",
        action=CommaList,
        metavar="KINDS",
        help="code, table, section, frontmatter, command or any (default: code)",
    )
    selection.add_argument(
        "--lang",
        action=CommaList,
        metavar="LANGS",
        help="language families: cpp, diff, sh, csv, python, …; any = untagged, * = all",
    )
    selection.add_argument(
        "--guess", action="store_true", help="sniff untagged code bodies for --lang"
    )
    selection.add_argument(
        "--heading", action=CommaList, metavar="PAT", help="nearest heading (sections: own heading)"
    )
    selection.add_argument(
        "--under", action=CommaList, metavar="PAT", help="any heading in the enclosing path"
    )
    selection.add_argument(
        "--before", action=CommaList, metavar="PAT", help="prose paragraph right before the block"
    )
    selection.add_argument(
        "--after", action=CommaList, metavar="PAT", help="prose paragraph right after the block"
    )
    selection.add_argument(
        "--title", action=CommaList, metavar="PAT", help="fence title=/id= or section heading"
    )
    selection.add_argument(
        "--grep", action=CommaList, metavar="PAT", help="block body content"
    )
    selection.add_argument(
        "-n",
        "--index",
        metavar="SPEC",
        help="3 | 2-5 | 1,4 | -1 (last): row of the current selection",
    )
    selection.add_argument("--first", action="store_true", help="shorthand for --index 1")
    selection.add_argument("--last", action="store_true", help="shorthand for --index -1")
    selection.add_argument(
        "--one", action="store_true", help="fail unless exactly one block matches"
    )
    selection.add_argument(
        "-F", "--literal", action="store_true", help="treat patterns as literal text"
    )
    selection.add_argument(
        "--indented", action="store_true", help="also parse 4-space indented code blocks"
    )
    selection.add_argument(
        "--no-subsections",
        action="store_true",
        help="a section stops at its first subheading",
    )
    selection.add_argument(
        "--select",
        metavar="SPEC",
        help="selector grammar: kind[:qualifier][@N] (table:col, code:lang, "
        "section:heading, command:program, any, auto); see --kinds",
    )

    output = parser.add_argument_group("output")
    output.add_argument(
        "--list", action="store_true", help="inventory: index, kind, language, heading, label"
    )
    output.add_argument("--pick", action="store_true", help="choose a block with fzf")
    output.add_argument("-c", "--count", action="store_true", help="print how many blocks match")
    output.add_argument("--fence", action="store_true", help="re-emit with the original fence")
    output.add_argument(
        "--with-heading", action="store_true", help="prepend the enclosing heading path"
    )
    output.add_argument(
        "--with-intro", action="store_true", help="prepend the prose paragraph before"
    )
    output.add_argument("--json", action="store_true", help="print matching blocks as JSON")
    output.add_argument("--jsonl", action="store_true", help="print one JSON object per block")
    output.add_argument("--items", metavar="SPEC", help="print the selector's items as JSON (for `.each`)")
    output.add_argument(
        "--contract",
        action="append",
        metavar="SPEC",
        help="print the AI instruction for a selector; repeat for a combined multi-part contract",
    )
    output.add_argument("--kinds", action="store_true", help="list the selector kinds and exit")
    output.add_argument("--no-header", action="store_true", help="table projections: omit the header row")

    writing = parser.add_argument_group("writing")
    writing.add_argument(
        "-o", "--output", metavar="FILE", help="write the single match to FILE ('-' for stdout)"
    )
    writing.add_argument("--out-dir", metavar="DIR", help="write every match into DIR")
    writing.add_argument("--ext", metavar="EXT", help="extension for --out-dir names")
    writing.add_argument("--force", action="store_true", help="overwrite existing files")
    writing.add_argument(
        "--dry-run", action="store_true", help="with -o/--out-dir, print what would be written"
    )
    return parser


def read_file(path: str) -> str:
    try:
        return Path(path).read_bytes().decode("utf-8", "replace")
    except OSError as error:
        raise UsageError(f"cannot read {path}: {error.strerror}") from error


def run(args: argparse.Namespace) -> int:
    # Offline modes: no input is read, so `.expect` can call --contract in a
    # chain where stdin is a terminal (or already spent).
    if args.kinds:
        print(render_kinds())
        return 0
    if args.contract:
        selectors = [parse_selector(spec) for spec in args.contract]
        if len(selectors) == 1:
            sys.stdout.write(contract_for(selectors[0]))
        else:
            sys.stdout.write(combined_contract(selectors))
        return 0

    selector = parse_selector(args.select) if args.select is not None else None

    kinds = set(args.kind or ["code"])
    if "any" in kinds or "all" in kinds:
        kinds = set(SOURCE_KINDS)
    if "field" in kinds and selector is None:
        raise UsageError("the field kind needs a label: use --select field:LABEL")
    unknown = kinds - set(KINDS)
    if unknown:
        raise UsageError(
            f"unknown kind {', '.join(sorted(unknown))} (use {', '.join(KINDS)} or any)"
        )
    if selector is not None:
        if selector.kind == "none":
            raise SoftError("the 'none' selector has no blocks")
        kinds = selector_kinds(selector)

    index_values: list[int] | None = None
    if args.index is not None:
        index_values = parse_index_spec(args.index)
    if args.first and args.last:
        raise UsageError("--first and --last are mutually exclusive")
    if (args.first or args.last) and index_values:
        raise UsageError("--first/--last cannot be combined with --index")
    if args.first:
        index_values = [1]
    if args.last:
        index_values = [-1]
    if selector is not None and index_values:
        raise UsageError("--select has its own @N position; drop --index/--first/--last")

    if args.dry_run and not (args.output or args.out_dir):
        raise UsageError("--dry-run needs -o/--output or --out-dir")
    if args.json and args.jsonl:
        raise UsageError("use either --json or --jsonl")

    query = Query(
        kinds=kinds,
        langs=list(args.lang or []),
        guess=args.guess,
        heading=compile_patterns(list(args.heading or []), args.literal),
        under=compile_patterns(list(args.under or []), args.literal),
        before=compile_patterns(list(args.before or []), args.literal),
        after=compile_patterns(list(args.after or []), args.literal),
        title=compile_patterns(list(args.title or []), args.literal),
        grep=compile_patterns(list(args.grep or []), args.literal),
    )

    if args.files:
        sources = list(args.files)
    elif sys.stdin.isatty():
        raise UsageError("no input: pass FILE arguments or pipe Markdown on stdin")
    else:
        sources = ["-"]

    blocks: list[Block] = []
    texts: list[tuple[str, str]] = []
    for file_order, source in enumerate(sources):
        text = sys.stdin.read() if source == "-" else read_file(source)
        texts.append((source, text))
        blocks.extend(
            parse_document(
                text,
                source,
                file_order=file_order,
                indented=args.indented,
                include_subsections=not args.no_subsections,
            )
        )
    # `command` is a view of a code block; derive it for every document so
    # auto-detection can see it, even when the caller did not name the kind.
    blocks.extend(derive_commands(blocks))
    # `field` is a view of a labelled line; only the selector names its label.
    if selector is not None and selector.kind == "field":
        blocks.extend(field_blocks(texts, selector.qualifier))
    assign_indices(blocks)

    if args.items is not None:
        items_selector = parse_selector(args.items)
        items = selector_items(blocks, items_selector, args.guess)
        if not items:
            raise SoftError(f"selector {args.items!r} produced no items")
        print(json.dumps(items, indent=2, ensure_ascii=False))
        return 0

    if selector is not None:
        selected = select_selector(blocks, selector)
    else:
        selected = select_blocks(blocks, query, index_values)
    for position, block in enumerate(selected, 1):
        block.index = position

    if args.one and len(selected) != 1:
        if not selected:
            raise SoftError("no block matches --one")
        raise UsageError(
            f"--one needs exactly one block, got {len(selected)}"
            " (narrow the selection or drop --one)"
        )

    if args.count:
        print(len(selected))
        return 0 if selected else 1

    if not selected:
        kind_names = (
            ", ".join(sorted(selector_kinds(selector))) if selector is not None else ", ".join(sorted(kinds))
        )
        raise SoftError(
            f"no matching {kind_names} blocks"
            " (try --list, --kind any, or --guess)"
        )

    if args.list:
        print(render_list(selected, args.guess))
        return 0

    if args.pick:
        selected = pick_block(selected, args.guess)

    if args.json:
        print(
            json.dumps(
                [block_record(block, args.guess) for block in selected],
                indent=2,
                ensure_ascii=False,
            )
        )
        return 0
    if args.jsonl:
        for block in selected:
            print(json.dumps(block_record(block, args.guess), ensure_ascii=False))
        return 0

    if selector is not None:
        if args.out_dir:
            raise UsageError("--select cannot be combined with --out-dir")
        rendered = render_selection(selected, selector, args)
        if args.output and args.output != "-":
            Path(args.output).write_text(rendered, encoding="utf-8")
        else:
            sys.stdout.write(rendered)
        return 0

    if args.output == "-":
        sys.stdout.write(render_many(selected, args))
        return 0
    if args.output or args.out_dir:
        write_blocks(selected, args)
        return 0

    sys.stdout.write(render_many(selected, args))
    return 0


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return run(args)
    except SoftError as error:
        print(f"{PROG}: {error}", file=sys.stderr)
        return 1
    except UsageError as error:
        print(f"{PROG}: {error}", file=sys.stderr)
        return 2
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
