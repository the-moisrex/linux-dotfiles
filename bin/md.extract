}

ALIAS_TO_FAMILY = {
    alias: family for family, aliases in LANG_FAMILIES.items() for alias in aliases
}

EXTENSIONS = {
    "cpp": "cpp", "sh": "sh", "python": "py", "js": "js", "ts": "ts",
    "json": "json", "yaml": "yaml", "toml": "toml", "csv": "csv", "md": "md",
    "html": "html", "xml": "xml", "css": "css", "sql": "sql", "rust": "rs",
    "go": "go", "java": "java", "kotlin": "kt", "ruby": "rb", "php": "php",
    "perl": "pl", "lua": "lua", "r": "r", "swift": "swift", "scala": "scala",
    "csharp": "cs", "make": "mk", "cmake": "cmake", "docker": "dockerfile",
    "text": "txt", "mermaid": "mmd", "tex": "tex", "powershell": "ps1",
    "asm": "asm", "batch": "bat", "vba": "vb", "solidity": "sol", "wasm": "wat",
