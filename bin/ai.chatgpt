#!/usr/bin/env python3
"""ai.chatgpt — start a new ChatGPT chat from a prompt or stdin.

Replays the signed-in chatgpt.com session (cookies + access token) over its own
conversation API — no API key.  See ``ai.chatgpt --help``.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from ai.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main("chatgpt"))
