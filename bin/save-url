#!/bin/bash

# Check if Chromium is installed
if ! command -v chromium &> /dev/null; then
    echo "Error: Chromium is not installed. Please install it first." >&2
    exit 1
fi

# Function to display help message
show_help() {
    echo "Usage: $0 [options] [url1 url2 ...]"
    echo "Options:"
    echo "  --dir DIR        Save files in DIR"
    echo "  --help           Show this help message"
    echo "  --pdf            Create PDF file"
    echo "  --html           Create HTML file (DOM)"
    echo "  --mhtml          Create mHTML file"
    echo "  --png            Take Screenshot"
    echo "  --jpeg           Take Screenshot"
    echo "  --output FILE    Specify output filename (only for single URL)"
    echo "If no formats are specified, default to PDF."
    echo "If no URLs are provided, read from stdin (one URL per line)."
}

# Parse options
dir=""
declare -a formats
output=""
declare -a urls
out_mode="ignore"
max_jobs=10
TIMEOUT=60 # seconds

# https://peter.sh/experiments/chromium-command-line-switches/
chromium_default_opts=(
    --headless
    --no-remote
    # --no-sandbox
    # --single-process
    # --no-zygote
    # --disable-setuid-sandbox
    --disable-bundled-ppapi-flash
    --disable-offline-load-stale-cache
    # --disk-cache-size=1
    # --media-cache-size=1
    # --disk-cache-dir=/dev/null
    --no-first-run
    --no-referrers
    --save-page-as-mhtml
    --no-default-browser-check
    --deny-permission-prompts
    --disable-sync
    --ignore-certificate-errors

    --disable-gpu
    --window-size='1920,9000'
    --run-all-compositor-stages-before-draw
    --virtual-time-budget=7000

    # --disable-web-security
    --disable-extensions
    # --ignore-urlfetcher-cert-requests
    # --ignore-certificate-errors
    --ignore-ssl-errors
    --disable-dev-shm-usage

    --timeout=55000 # 50 seconds
    --network-quiet-timeout=50 # seconds
)



while [[ $# -gt 0 ]]; do
    case $1 in
        --dir)
            dir=$2
            shift 2
            ;;
        --help|-help|help)
            show_help
            exit 0
            ;;
        --pdf|-pdf|pdf)
            formats+=("pdf")
            shift
            ;;
        --html|-html|html)
            formats+=("html")
            shift
            ;;
        --mhtml|-mhtml|mhtml)
            formats+=("mhtml")
            shift
            ;;
        --jpg|-jpg|jpg)
            formats+=("jpg")
            shift
            ;;
        --jpeg|-jpeg|jpeg)
            formats+=("jpeg")
            shift
            ;;
        --png|-png|png|screenshot|--screenshot|-screenshot)
            formats+=("png")
            shift
            ;;
        --output|-o)
            output=$2
            shift 2
            ;;
        --replace)
            out_mode="replace";
            shift;
            ;;
        --unique)
            out_mode="unique";
            shift;
            ;;
        --ignore)
            out_mode="ignore";
            shift;
            ;;
        -*)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
        *)
            urls+=("$1")
            shift
            ;;
    esac
done

# Default to PDF if no formats specified
if [ ${#formats[@]} -eq 0 ]; then
    formats=("pdf")
fi

# If no URLs provided as arguments, read from stdin
if [ "${#urls[@]}" -eq 0 ]; then
    while IFS= read -r line; do
        urls+=("$line")
    done
fi

# Check if URLs are provided
if [ "${#urls[@]}" -eq 0 ]; then
    echo "Error: No URLs provided." >&2
    exit 1
fi

function try() {
    retry_count=5
    while ! "$@"; do
        sleep 1s;

        if [ "$retry_count" -le 0 ]; then
            break;
        fi
        retry_count=$((retry_count - 1))
    done
}

# Function to get page title or sanitized URL
get_title() {
    local url=$1
    local title;
    title=$(try curl -Ls "$url" | grep -m1 -oP '(?<=<title>).*(?=</title>)')
    if [ -z "$title" ]; then
        title=$(echo "$url" | sed 's|http[s]*://||g' | sed 's|/|_|g' | sed 's|[^a-zA-Z0-9_-]|_|g')
    fi
    echo "$title" | sed 's|[^a-zA-Z0-9_-]|_|g' | sed -E 's|_+|_|g' | sed 's|_\.|.|g' | sed 's|_\-_|-|g' | sed 's|^_||g' | cut -c1-100
}

# Function to create file
create_file() {
    local url=$1
    local format=$2
    local filename=$3

    temp_dir="$(mktemp -d --suffix="-chromium")"

    case "$format" in
        pdf)
            try timeout "${TIMEOUT}s" chromium --user-data-dir="$temp_dir" "${chromium_default_opts[@]}" --print-to-pdf="$filename" "$url" 2>/dev/null
            ;;
        html)
            try timeout "${TIMEOUT}s" chromium --user-data-dir="$temp_dir" "${chromium_default_opts[@]}" --dump-dom "$url" > "$filename" 2>/dev/null
            ;;
        mhtml)
            save_mhtml "$url" "$filename"
            ;;
        jpg|jpeg|png)
            try timeout "${TIMEOUT}s" chromium --user-data-dir="$temp_dir" "${chromium_default_opts[@]}" --screenshot="$filename" "$url" 2>/dev/null
            ;;
        *)
            echo "Unknown format: $format" >&2
            exit 1
            ;;
    esac
    if [ -f "$filename" ] && [ -s "$filename" ]; then
        echo "Saved $format to $filename"
    else
        echo "Warning: Failed to save $format for $url" >&2
    fi
    rm -rf "$temp_dir";
}

# Save the page as a real MHTML file via the DevTools Page.captureSnapshot API.
save_mhtml() {
    local url=$1
    local filename=$2
    if ! command -v python3 >/dev/null 2>&1; then
        echo "Error: 'python3' is required for --mhtml." >&2
        return 1
    fi
    try python3 - "$url" "$filename" <<'PYEOF'
import json, os, sys, time, struct, base64, socket, subprocess, urllib.request, tempfile, shutil

def main():
    url = sys.argv[1]
    out = sys.argv[2]
    userdir = tempfile.mkdtemp(prefix="save-url-mhtml-")
    proc = subprocess.Popen([
        "chromium", "--headless=new", "--disable-gpu", "--no-sandbox",
        "--no-first-run", "--disable-extensions", "--disable-dev-shm-usage",
        "--user-data-dir=" + userdir, "--remote-debugging-port=0", url,
    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        port_path = os.path.join(userdir, "DevToolsActivePort")
        port = None
        for _ in range(100):
            if os.path.exists(port_path):
                with open(port_path) as f:
                    port = int(f.readline().strip())
                break
            time.sleep(0.1)
        if port is None:
            raise RuntimeError("DevTools port not found")
        ws_url = None
        for _ in range(50):
            try:
                with urllib.request.urlopen("http://127.0.0.1:%d/json/list" % port, timeout=2) as r:
                    targets = json.loads(r.read())
                for t in targets:
                    if t.get("type") == "page":
                        ws_url = t.get("webSocketDebuggerUrl")
                        break
                if ws_url:
                    break
            except Exception:
                pass
            time.sleep(0.2)
        if ws_url is None:
            raise RuntimeError("no page target found")
        mhtml = websocket_capture(ws_url)
        with open(out, "wb") as f:
            f.write(mhtml)
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
        shutil.rmtree(userdir, ignore_errors=True)

def websocket_capture(ws_url):
    rest = ws_url[len("ws://"):]
    hostport, _, path = rest.partition("/")
    path = "/" + path
    host, _, port = hostport.partition(":")
    port = int(port or 80)
    s = socket.create_connection((host, port), timeout=15)
    key = base64.b64encode(os.urandom(16)).decode()
    s.sendall((
        "GET %s HTTP/1.1\r\nHost: %s\r\nUpgrade: websocket\r\n"
        "Connection: Upgrade\r\nSec-WebSocket-Key: %s\r\n"
        "Sec-WebSocket-Version: 13\r\n\r\n"
    ) % (path, hostport, key).encode())
    resp = b""
    while b"\r\n\r\n" not in resp:
        resp += s.recv(4096)
    if b" 101 " not in resp.split(b"\r\n", 1)[0]:
        raise RuntimeError("websocket handshake failed")

    def send_frame(data):
        payload = data if isinstance(data, bytes) else data.encode()
        mask = os.urandom(4)
        header = bytearray([0x81])
        ln = len(payload)
        if ln < 126:
            header.append(0x80 | ln)
        elif ln < 65536:
            header.append(0x80 | 126)
            header += struct.pack(">H", ln)
        else:
            header.append(0x80 | 127)
            header += struct.pack(">Q", ln)
        header += mask
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        s.sendall(bytes(header) + masked)

    def recv_exact(n):
        buf = b""
        while len(buf) < n:
            chunk = s.recv(n - len(buf))
            if not chunk:
                raise RuntimeError("socket closed")
            buf += chunk
        return buf

    def recv_frame():
        b1, b2 = recv_exact(2)
        opcode = b1 & 0x0F
        ln = b2 & 0x7F
        if ln == 126:
            ln = struct.unpack(">H", recv_exact(2))[0]
        elif ln == 127:
            ln = struct.unpack(">Q", recv_exact(8))[0]
        if b2 & 0x80:
            mask = recv_exact(4)
            payload = bytes(b ^ mask[i % 4] for i, b in enumerate(recv_exact(ln)))
        else:
            payload = recv_exact(ln)
        if opcode == 0x9:
            send_frame(payload)
            return None
        return opcode, payload

    send_frame(json.dumps({"id": 1, "method": "Page.captureSnapshot",
                           "params": {"format": "mhtml"}}))
    data = b""
    while True:
        frame = recv_frame()
        if frame is None:
            continue
        opcode, payload = frame
        if opcode == 0x1 or opcode == 0x2:
            data += payload
            try:
                obj = json.loads(data.decode())
                if obj.get("id") == 1:
                    if "error" in obj:
                        raise RuntimeError("capture error: %s" % obj["error"])
                    s.close()
                    return obj["result"]["data"].encode("utf-8")
            except json.JSONDecodeError:
                pass
        elif opcode == 0x8:
            break
    raise RuntimeError("connection closed before capture result")

if __name__ == "__main__":
    main()
PYEOF
}

# Handle --output for single URL (sequential processing)
if [ -n "$output" ]; then
    if [ "${#urls[@]}" -ne 1 ]; then
        echo "Error: --output can only be used with exactly one URL." >&2
        exit 1
    fi
    if [ ${#formats[@]} -gt 1 ]; then
        echo "Error: --output can only be used with one format." >&2
        exit 1
    fi
    # Deduce format from output extension if not specified
    if [ ${#formats[@]} -eq 0 ]; then
        case "$output" in
            *.pdf)
                formats=("pdf")
                ;;
            *.html)
                formats=("html")
                ;;
            *.mhtml)
                formats=("mhtml")
                ;;
            *.png)
                formats=("png")
                ;;
            *.jpg)
                formats=("jpg")
                ;;
            *.jpeg)
                formats=("jpeg")
                ;;
            *)
                formats=("pdf")
                echo "Warning: Could not deduce format from '$output', defaulting to PDF." >&2
                ;;
        esac
    fi
    format="${formats[0]}"
    filename="$output"
    create_file "${urls[0]}" "$format" "$filename"
else
    # Create directory if specified
    if [ -n "$dir" ]; then
        mkdir -p "$dir" || exit 1
    fi

    # Process multiple URLs in parallel, computing filenames in the parent
    # shell so that --unique dedup and the --ignore check actually work.
    declare -A used_filenames
    running=0
    for url in "${urls[@]}"; do
        if [ -z "$url" ]; then
            continue;
        fi
        for format in "${formats[@]}"; do
            base_filename=$(get_title "$url")
            filename=""
            if [ "$out_mode" == "unique" ]; then
                key="${format}_${base_filename}"
                count=${used_filenames["$key"]:-0}
                if [ "$count" -eq 0 ]; then
                    unique_base="$base_filename"
                else
                    unique_base="${base_filename}_${count}"
                fi
                used_filenames["$key"]=$((count + 1))
                filename="${unique_base}.${format}"
            else
                filename="${base_filename}.${format}"
            fi
            if [ -n "$dir" ]; then
                filename="$dir/$filename"
            fi
            if [ "$out_mode" == "ignore" ] && [ -f "$filename" ]; then
                echo "Ignored: $filename  (URL: $url)." >&2
                continue
            fi
            create_file "$url" "$format" "$filename" &
            running=$((running + 1))
            if [ "$running" -ge "$max_jobs" ]; then
                wait -n
                running=$((running - 1))
            fi
        done
    done
    wait  # Wait for all background jobs to complete
fi

