#!/usr/bin/env bash

set -euo pipefail

signal="TERM"
force=0

usage() {
    cat <<'EOF'
Usage: fkill [-s SIGNAL] [-y] [-h] [-g GROUP]

Kill processes interactively using fzf.

Options:
  -s SIGNAL    Signal to send (default: TERM)
  -y           Skip confirmation prompt
  -g GROUP     Kill process group (all processes in the group)
  -h           Show this help message

Signals:
  TERM, INT, HUP, KILL, STOP, CONT, USR1, USR2

Examples:
  fkill                     # Interactive TERM kill
  fkill -s KILL             # Interactive KILL
  fkill -y -s HUP           # SIGHUP without confirmation
  fkill -g $(pgrep -g myapp) # Kill process group
EOF
    exit 1
}

kill_group=0

while getopts "s:yg:h" opt; do
    case "$opt" in
        s) signal="$OPTARG" ;;
        y) force=1 ;;
        g) kill_group=1; pids="$OPTARG" ;;
        h) usage ;;
        *) usage ;;
    esac
done

if [[ $kill_group -eq 1 ]]; then
    # Direct group kill mode
    echo "Sending SIG$signal to process group: $pids"
    if [ "$force" -eq 0 ]; then
        read -rp "Are you sure? (y/N) " confirm
        case "$confirm" in
            [Yy]*) ;;
            *) echo "Aborted."; exit 1 ;;
        esac
    fi
    kill "-$signal" -- -"$pids" 2>/dev/null || kill "-$signal" $pids
    exit 0
fi

command -v fzf >/dev/null || {
    echo "Error: fzf is required."
    exit 1
}

# Select processes
selection=$(
    ps -eo pid,user,comm,%cpu,%mem --sort=-%cpu |
    sed 1d |
    fzf -m --header="Select process(es) to kill (TAB to mark)"
)

[ -z "$selection" ] && exit 0

pids=$(echo "$selection" | awk '{print $1}')

echo "Sending SIG$signal to:"
echo "$selection"
echo

if [ "$force" -eq 0 ]; then
    read -rp "Are you sure? (y/N) " confirm
    case "$confirm" in
        [Yy]*) ;;
        *) echo "Aborted."; exit 1 ;;
    esac
fi

kill "-$signal" $pids
