#!/bin/bash

cmd="microsoft-edge-stable"
if ! command -v "$cmd" >/dev/null; then
    cmd="microsoft-edge"
    if ! command -v "$cmd" >/dev/null; then
        echo "Microsoft Edge is not installed or it's not in the PATH";
        exit 1;
    fi
fi


show_help() {
    cat <<'EOF'
Usage: edge.tmp [--tor [PORT]] [-- URL...]

Launch Microsoft Edge with a temporary profile in private mode (deleted on exit).

Options:
  --tor [PORT]  Route traffic through a local Tor SOCKS5 proxy (default: 9050)
  -h, --help    Show this help message

All other arguments are passed directly to Edge.
EOF
}

tor_cmds=()
case "${1:-}" in
    -h|--help) show_help; exit 0 ;;
	--tor|tor)
        if [ -z "$2" ]; then
            port="9050";
        else
            port="$2";
            shift;
        fi;
        # --host-resolver-rules='MAP * ~NOTFOUND , EXCLUDE 127.0.0.1'
		tor_cmds=(--proxy-server="socks5://127.0.0.1:$port")
		shift
		;;
esac

dir=$(mktemp -d)
echo "Microsoft Edge Config Directory: $dir"
"$cmd" --inprivate --user-data-dir="$dir" "${tor_cmds[@]}" --new-window "$@"
rm -rf "$dir"
echo "Microsoft Edge Config Directory $dir Deleted."