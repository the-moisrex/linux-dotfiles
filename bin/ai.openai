#!/usr/bin/env python3
"""ai.openai — chat with the OpenAI API (or any OpenAI-compatible endpoint).

Uses ``OPENAI_API_KEY`` and ``OPENAI_BASE_URL``/``OPENAI_MODEL`` instead of a
browser session, so api.openai.com, OpenRouter, Groq, vLLM and a remote
llama.cpp all work.  See ``ai.openai --help``.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from ai.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main("openai"))
