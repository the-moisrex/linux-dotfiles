#!/bin/bash

function battery {
    pactl list sinks | grep bluetooth.battery | sed -E 's/.*?"([0-9]+%)".*/\1/'
}

function follow_battery {
    while true; do
        b=$(battery)
        if [ -z "$b" ]; then
            echo -ne "\rNaN";
        else
            echo -ne "\r$b";
        fi
        sleep 3s;
    done
}

case $1 in
    -f|--follow)
        follow_battery;
        ;;
    -h|--help)
        echo "Usage: $0 [-f|--follow]"
        echo
        echo "  Print the battery level of connected Bluetooth headphones."
        echo
        echo "Options:"
        echo "  -f, --follow        Keep showing the battery level every 3 seconds"
        echo "  -h, --help          Show this help message"
        ;;
    *)
        battery;
        ;;
esac
