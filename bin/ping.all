#!/bin/bash

# Check for help flag or empty arguments
if [[ "$1" == "--help" || "$1" == "-h" || $# -eq 0 ]]; then
    echo "Usage: $0 [ping_options...] [IP/Domain...] "
    echo ""
    echo "Pings multiple addresses concurrently and colorizes the latency."
    echo "You can pass standard ping flags (e.g., -A, -c 4, -s 0) natively."
    echo ""
    echo "Latency Colors:"
    echo -e "  \033[32mGreen\033[0m  : < 50 ms"
    echo -e "  \033[33mYellow\033[0m : 50 ms - 100 ms"
    echo -e "  \033[38;5;208mOrange\033[0m : 100 ms - 200 ms"
    echo -e "  \033[31mRed\033[0m    : > 200 ms or Timeout"
    echo ""
    echo "Examples:"
    echo "  $0 1.1.1.1 8.8.8.8 google.com"
    echo "  $0 -A -c 5 1.1.1.1 google.com"
    echo "  $0 -s 0 8.8.8.8"
    exit 0
fi

PING_OPTS=()
TARGETS=()

# Separate ping options from targets
for arg in "$@"; do
    if [[ "$arg" == -* ]]; then
        PING_OPTS+=("$arg")
        elif [[ "$arg" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        PING_OPTS+=("$arg")
    else
        TARGETS+=("$arg")
    fi
done

if [ ${#TARGETS[@]} -eq 0 ]; then
    echo -e "\033[31mError: No IP addresses or domains provided.\033[0m"
    exit 1
fi

for target in "${TARGETS[@]}"; do
    echo "ping ${PING_OPTS[@]} $target"
done | xargs -I {} -P0 bash -c "{}" | awk '
{
    # Remove the first "PING x.x.x.x..." header line
    if ($1 == "PING") {
        next
    }
    # Handle dropped packets or explicit timeouts
    else if ($0 ~ /timeout/ || $0 ~ /no answer/) {
        print "\033[31m" $0 "\033[0m"
    }
    # Match standard ping response lines containing "bytes from"
    else if ($0 ~ /bytes from/) {
        has_time = 0

        # Loop through all fields to dynamically find "time=X.X"
        for (i=1; i<=NF; i++) {
            if ($i ~ /^time=/) {
                has_time = 1
                split($i, a, "=")
                t = a[2]

                if (t < 50) color = "\033[32m"
                else if (t < 100) color = "\033[33m"
                else if (t < 200) color = "\033[38;5;208m"
                else color = "\033[31m"

                # $4 is the IP address (e.g., "1.1.1.1:")
                ip = $4
                sub(/:$/, "", ip) # Remove trailing colon for cleaner output

                print color t "\033[0m" "\t" ip
                break
            }
        }

        # If the line was a success but had no time data (e.g. ping -s 0)
        if (has_time == 0) {
            print ip "\t" $0
        }
    }
    # Print any other output lines normally (preventing empty blank lines)
    else if (NF > 0) {
        print $0
    }

    fflush()
}'
