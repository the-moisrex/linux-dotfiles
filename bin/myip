#!/bin/bash

domain="myadd.ir"

function get {
    curl -s "$domain$*"
}

function get_json {
    local ip asn country city timezone
    ip=$(get /ip)
    asn=$(get /asn)
    country=$(get /country)
    city=$(get /city)
    timezone=$(get /timezone)
    
    cat <<EOF
{
  "ip": "$ip",
  "asn": "$asn",
  "country": "$country",
  "city": "$city",
  "timezone": "$timezone"
}
EOF
}

function get_ip {
    local ip
    ip=$(dig +short myip.opendns.com @resolver1.opendns.com 2>/dev/null | tr -d '[:space:]')
    if [[ -z "$ip" ]]; then
        ip=$(dig -4 @1.1.1.1 +short ch txt whoami.cloudflare 2>/dev/null | tr -d '"[:space:]')
    fi
    echo "$ip"
}

case $1 in
    --help|-h|help)
        echo "Usage: $0 [all|ip|asn|country|city|timezone|json]"
        echo
        echo "  Print information about your public IP address."
        echo
        echo "Commands:"
        echo "  (no args)           Print the public IP address"
        echo "  all                 Print all available information"
        echo "  ip                  Print only the IP address"
        echo "  asn                 Print the ASN"
        echo "  country             Print the country"
        echo "  city                Print the city"
        echo "  timezone            Print the timezone"
        echo "  json                Print all info as JSON"
        echo "  -h, --help          Show this help message"
        ;;
    all)
        get 
        ;;
    ip)
        get /ip
        ;;
    asn)
        get /asn
        ;;
    country)
        get /country
        ;;
    city)
        get /city
        ;;
    timezone|time-zone)
        get /timezone
        ;;
    json|--json)
        get_json
        ;;
    *)
        get_ip;
        ;;
esac
