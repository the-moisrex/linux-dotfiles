#!/usr/bin/env python3
"""Fetch currency and commodity prices from Tasnim News (tasnimnews.ir/fa/currency)."""

import argparse
import csv
import io
import json
import re
import sys
import urllib.request


API_URL = "https://www.tasnimnews.ir/common/CurrencyTable"

