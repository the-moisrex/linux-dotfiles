#!/bin/bash

set -euo pipefail

show_help() {
    cat <<'EOF'
Usage: try [OPTIONS] [RETRY_COUNT] [--] COMMAND [ARGS...]

Retry a command until it succeeds (exit code 0).

Options:
  -h, --help            Show this help message
  -d, --delay SECONDS   Wait SECONDS between retries (default: 1)
  -v, --verbose         Print each attempt and its exit code
  --backoff             Use exponential backoff (1s, 2s, 4s, 8s, ...)
  --max-delay SECONDS   Maximum delay when using --backoff (default: 60)

Arguments:
  RETRY_COUNT           Maximum number of retries (0 or omitted = infinite)
  COMMAND               The command to retry
  ARGS...               Arguments for the command

Examples:
  try 5 curl -sf http://example.com     # Try up to 5 times
  try --delay 2 ping -c1 8.8.8.8       # Ping with 2s delay
  try --backoff 10 ./deploy.sh          # Exponential backoff, max 10 retries
  try -v 3 make build                   # Verbose, 3 retries
EOF
}

delay=1
retry_count=0
verbose=false
backoff=false
max_delay=60

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
        ;;
        -d|--delay)
            if [[ $# -lt 2 ]]; then
                echo "try: missing value for --delay" >&2
                exit 1
            fi
            delay="$2"
            shift 2
            continue
        ;;
        -v|--verbose)
            verbose=true
            shift
            continue
        ;;
        --backoff)
            backoff=true
            shift
            continue
        ;;
        --max-delay)
            if [[ $# -lt 2 ]]; then
                echo "try: missing value for --max-delay" >&2
                exit 1
            fi
            max_delay="$2"
            shift 2
            continue
        ;;
        --)
            shift
            break
        ;;
        -*)
            echo "try: unknown option: $1" >&2
            exit 1
        ;;
        *)
            # First non-flag argument that looks like a number is retry_count
            if [[ -n "$1" && "$1" =~ ^[0-9]+$ ]]; then
                retry_count="$1"
                shift
                break
            fi
            break
        ;;
    esac
done

if [[ $# -eq 0 ]]; then
    echo "try: no command specified" >&2
    exit 1
fi

attempt=0
current_delay="$delay"

while true; do
    attempt=$((attempt + 1))

    if $verbose; then
        echo "try: attempt $attempt: $*" >&2
    fi

    if "$@"; then
        if $verbose; then
            echo "try: succeeded on attempt $attempt" >&2
        fi
        exit 0
    fi

    exit_code=$?

    if $verbose; then
        echo "try: attempt $attempt failed (exit code $exit_code)" >&2
    fi

    if [[ $retry_count -gt 0 && $attempt -ge $retry_count ]]; then
        if $verbose; then
            echo "try: giving up after $attempt attempts" >&2
        fi
        exit "$exit_code"
    fi

    if $backoff; then
        sleep "$current_delay"
        current_delay=$((current_delay * 2))
        if [[ $current_delay -gt $max_delay ]]; then
            current_delay=$max_delay
        fi
    else
        sleep "$delay"
    fi
done
