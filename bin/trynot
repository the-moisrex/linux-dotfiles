#!/bin/bash

if [ "$1" == "--help" ]; then
    echo "Usage: $0 [--delay SECONDS] [retry-count=Infinite] [command]"
    echo "  Retry the specified command until it returns failure."
    echo
    echo "Options:"
    echo "  --delay SECONDS  Wait SECONDS between retries (default: 1)"
    exit 0;
fi

delay=1
if [ "$1" == "--delay" ]; then
    delay="${2:-1}"
    shift 2
fi

retry_count=0
if [ -n "$1" ] && [[ "$1" =~ ^[0-9]+$ ]]; then
    retry_count="$1"
    shift
fi

while "$@"; do
    if [ "$retry_count" -gt 0 ]; then
        retry_count=$((retry_count - 1))
        if [ "$retry_count" -eq 0 ]; then
            break
        fi
    fi
    sleep "$delay"s
done
