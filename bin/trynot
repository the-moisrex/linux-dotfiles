#!/bin/bash

if [ "$1" == "--help" ]; then
    echo "Usage: $0 [retry-count=Infinite] [command]"
    echo "  Retry the specified command until it returns failure."
    exit 0;
fi

retry_count=0
if [ -n "$1" ] && [[ "$1" =~ ^[0-9]+$ ]]; then
    retry_count="$1"
    shift
fi

while "$@"; do
    if [ "$retry_count" -gt 0 ]; then
        retry_count=$((retry_count - 1))
        if [ "$retry_count" -eq 0 ]; then
            break
        fi
    fi
    sleep 1s
done
