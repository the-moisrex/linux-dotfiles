#!/bin/bash

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    cat <<'EOF'
Usage: paths [input_string]
       command | paths

Extracts paths of existing files (with optional :line:column) from input.

Only paths that exist on the filesystem are printed. Paths with ~ are expanded.

Options:
  -h, --help    Show this help message

Examples:
  # Pipe compiler/build output to extract source files
  make 2>&1 | paths

  # Extract file:line:col from grep results
  grep -rn 'TODO' src/ | paths

  # Pass a path string directly
  paths src/main.cpp:42:8

  # Extract paths from error messages
  g++ main.cpp 2>&1 | paths

  # Use in a pipeline with other tools
  clang-tidy file.cpp 2>&1 | paths | head -5
EOF
    exit 0
fi

if [ ! -t 0 ]; then
    input=$(cat)
else
    input="$*"
fi

# Match paths with optional :line or :line:column
# [a-zA-Z0-9_./~-]+ matches the file path characters
# (:[0-9]+){0,2} matches up to two colon-number pairs (line and col)
echo "$input" | grep -oE '[a-zA-Z0-9_./~-]+(:[0-9]+){0,2}' | while read -r match; do
    
    # Extract just the file path part (everything before the first colon)
    filepath="${match%%:*}"
    
    # Strip trailing colons just in case
    filepath="${filepath%:}"
    
    # Expand a leading ~ to $HOME
    filepath="${filepath/#\~/$HOME}"
    
    # Only print if the file actually exists on the filesystem
    # (Note: For this to print anything, the files must exist relative to where you run this script)
    if [[ -f "$filepath" ]]; then
        echo "$match"
    fi
done
