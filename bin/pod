#!/bin/bash
# pod - project dev containers: project image + named fragment Dockerfiles,
#       one labeled container per workspace (project / copy / worktree)
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
FRAG_DIR="$ROOT_DIR/pods/dockerfiles"
DFGEN="$SCRIPT_DIR/dockerfile.gen"
WT_ROOT="${POD_WT_ROOT:-$HOME/wt}"
TOOL="pod"

info()  { [[ "${quiet:-0}" == 1 ]] && return 0; printf "${GREEN}✓${NC} %s\n" "$*" >&2; }
debug() { [[ "${verbose:-0}" == 1 && "${quiet:-0}" == 0 ]] || return 0; printf "${CYAN}·${NC} %s\n" "$*" >&2; }
warn()  { printf "${YELLOW}!${NC} %s\n" "$*" >&2; }
die()   { printf "${RED}✗${NC} %s\n" "$*" >&2; exit 1; }

show_help() {
    cat << EOF
Usage: $TOOL [OPTIONS] <COMMAND> [ARGS...]

Project dev containers. $TOOL builds an image for the project in \$PWD (its
own Dockerfile, or one generated by dockerfile.gen for your host OS), layers
optional named fragment Dockerfiles (pods/dockerfiles/*.Dockerfile) on top,
and runs one persistent, labeled container per workspace (project dir, copy,
or git worktree). bin/oc uses the same infrastructure for opencode.

A build's log streams while it runs, then is erased again on success (the
✓ summaries with timing remain); --verbose keeps the log and adds detail.

COMMANDS (first non-option arg; bare "$TOOL [frags...]" = up):
  up [FRAG...]         build if needed, (re)create container, open a shell
  ensure [--quiet] [FRAG...]
                       build + create + start, print the container name only
                       (this is what bin/oc calls)
  oc [args...]         run opencode in the project's container (adds the oc
                       fragment; pass opencode's own flags after --)
  build [--rebuild] [FRAG...]
                       (re)build the image chain; --rebuild drops build cache
  frags                list available fragment Dockerfiles (ports, services, ...)
  shell [-v VARIANT]   shell into the running container (starts it if needed)
  exec [-v VARIANT] [-e K=V]... CMD [args...]
                       run a command in the container (auto-starts it)
  logs [-f] [-v VARIANT]
                       container logs
  service NAME [--fg]  start a fragment service (see # POD_SERVICE headers)
  vscode               = service code-server + print the URL
  ssh                  = service sshd + print (and copy) the ssh command
  ide [--run]          print (or run) the VS Code attach command
  wt NAME [FRAG...]    git worktree add under $WT_ROOT + up
  list                 all dev containers this tool manages (labels)
  down [-v VARIANT]    stop this project's containers ("down all" = every
                       managed dev container, regardless of project)
  rm  [-v VARIANT]     remove this project's containers
  prune [--dry-run] [--images]
                       GC stopped dev containers (+ empty pods); --images also
                       removes images no dev container uses anymore
  help

OPTIONS:
  -c, --copy           workspace = rsync copy of the project in $WT_ROOT
  -t, --worktree NAME  workspace = git worktree \$WT_ROOT/<project>-NAME
                       (an existing path is mounted as-is)
      --src PATH       workspace = PATH (escape hatch)
  -w, --with FRAGS     extra fragments to merge (comma separated), e.g. -w vscode,ssh
      --pod NAME       create/join a shared pod for this container
      --profile NAME   profile volume when a fragment has # POD_PROFILE
                       (default: \$OC_PROFILE or "default")
  -p, --publish SPEC   extra port, docker style: 8080, 8080:8081, ip:h:c
  -b, --build          no-op: builds are always run and cache-checked
      --rebuild        rebuild with --no-cache
  -v, --variant NAME   pick the container when a project has several
      --build-arg K=V  override a fragment build arg (e.g. SSH_PUBKEY)
      --no-git         do not mount ~/.gitconfig
      --no-ssh         do not mount ~/.ssh
      --verbose        keep build logs on screen + debug detail (· lines)
  -h, --help           Show this help

FRAGMENTS (pods/dockerfiles/<name>.Dockerfile, plain Dockerfiles with:
  ARG BASE             substituted with the previous image in the chain
  # POD_PORT P         publish port P (127.0.0.1:P:P) at container create
  # POD_PROFILE 1      mount oc-profile-<name> at /profile (XDG_* set)
  # POD_BUILD_ARG K    forwarded at build (SSH_PUBKEY auto-filled from ~/.ssh)
  # POD_SERVICE n=cmd  a service "pod service n" can start
Bundled: oc (opencode), vscode (code-server), ssh (sshd).

EXAMPLES:
  pod                      # up in the project's own Dockerfile env
  pod up vscode,ssh        # VS Code + sshd in the container
  pod exec cmake --build build --target tests
  pod up --worktree tilt   # own worktree + container
  pod list; pod prune --dry-run

NOTE: service stacks (pods/agents, ...) are managed separately with pods/stack.
EOF
}

# ---------------------------------------------------------------- defaults --
cmd=""
positional=()
with_frags=()
frags=()
ports_cli=()
build_args_cli=()
exec_env=()

copy=0
worktree=""
src_path=""
shared_pod=""
profile="${OC_PROFILE:-default}"
rebuild=0
variant_flag=""
no_git=0
no_ssh=0
dry_run=0
images_flag=0
fg=0
quiet=0
verbose=0
follow=0
run_flag=0

known_commands="up ensure oc build frags shell exec logs service vscode ssh ide wt list down rm prune help"

# ------------------------------------------------------------------ parse ---
while [[ $# -gt 0 ]]; do
    # after "exec CMD", everything is the command's own argv (incl. its flags)
    if [[ "$cmd" == "exec" && ${#positional[@]} -gt 0 ]]; then
        positional+=("$1")
        shift
        continue
    fi
    case "$1" in
        -h|--help) show_help; exit 0 ;;
        -c|--copy) copy=1; shift ;;
        -t|--worktree) worktree="${2:?--worktree needs a name or path}"; shift 2 ;;
        --worktree=*) worktree="${1#*=}"; shift ;;
        -w|--with)
            IFS=',' read -ra _extra <<< "${2:?,--with needs fragments}"
            with_frags+=("${_extra[@]}")
            shift 2 ;;
        --with=*) IFS=',' read -ra _extra <<< "${1#*=}"; with_frags+=("${_extra[@]}"); shift ;;
        --pod) shared_pod="${2:?--pod needs a name}"; shift 2 ;;
        --pod=*) shared_pod="${1#*=}"; shift ;;
        --profile) profile="${2:?--profile needs a name}"; shift 2 ;;
        --profile=*) profile="${1#*=}"; shift ;;
        -p|--publish) ports_cli+=("${2:?,--publish needs a port}"); shift 2 ;;
        --publish=*) ports_cli+=("${1#*=}"); shift ;;
        -b|--build) shift ;;
        --rebuild) rebuild=1; shift ;;
        -v|--variant) variant_flag="${2:?,--variant needs a name}"; shift 2 ;;
        --variant=*) variant_flag="${1#*=}"; shift ;;
        --build-arg) build_args_cli+=("${2:?,--build-arg needs K=V}"); shift 2 ;;
        --build-arg=*) build_args_cli+=("${1#*=}"); shift ;;
        --src) src_path="${2:?--src needs a path}"; shift 2 ;;
        --src=*) src_path="${1#*=}"; shift ;;
        --no-git) no_git=1; shift ;;
        --no-ssh) no_ssh=1; shift ;;
        --dry-run) dry_run=1; shift ;;
        --images) images_flag=1; shift ;;
        --fg) fg=1; shift ;;
        --quiet) quiet=1; shift ;;
        --verbose) verbose=1; shift ;;
        --run) run_flag=1; shift ;;
        -f) follow=1; shift ;;
        -e)
            exec_env+=("${2:?--exec-env needs K=V}"); shift 2 ;;
        -e=*) exec_env+=("${1#*=}"); shift ;;
        --) shift; positional+=("$@"); break ;;
        -*)
            [[ -n "$cmd" ]] && die "unknown option: $1 after '$cmd' (see --help)"
            die "unknown option: $1 (see --help)" ;;
        *)
            if [[ -z "$cmd" ]]; then
                if grep -qw "$1" <<<"$known_commands"; then
                    cmd="$1"
                else
                    cmd="up"
                    positional+=("$1")
                fi
            else
                positional+=("$1")
            fi
            shift ;;
    esac
done
cmd="${cmd:-up}"

command -v podman >/dev/null 2>&1 || die "podman is not installed"

# ------------------------------------------------------------- resolution ---
slugify() { # usable in image repositories, tags and container names
    printf '%s' "$1" \
        | tr '[:upper:]' '[:lower:]' \
        | tr -cs 'a-z0-9' '-' \
        | sed 's/^-//; s/-$//'
}

resolve_project() {
    if [[ -n "$src_path" ]]; then
        [[ -d "$src_path" ]] || die "--src: no such directory: $src_path"
        project_path="$(cd "$src_path" && pwd)"
    else
        project_path="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
        [[ -n "$project_path" ]] || project_path="$PWD"
    fi
    project_name="$(basename "$project_path")"
    project_slug="$(slugify "$project_name")"
    [[ -n "$project_slug" ]] || project_slug="project"
    debug "project: $project_path (slug: $project_slug)"
}

ensure_worktree() { # uses $project_path/$project_slug; sets $source
    local name="$1" path branch
    if [[ "$name" == */* || "$name" == . || "$name" == .. || -d "$name" ]]; then
        if [[ -d "$name" ]]; then
            path="$(cd "$name" && pwd)"
            git -C "$path" rev-parse --git-dir >/dev/null 2>&1 \
                || die "not a git worktree/directory: $path"
            source_path="$path"
            return 0
        fi
        die "--worktree: $name is not an existing directory"
    fi
    path="$WT_ROOT/${project_slug}-${name}"
    if [[ ! -d "$path" ]]; then
        git -C "$project_path" rev-parse --git-dir >/dev/null 2>&1 \
            || die "worktrees need a git project ($project_path is not one)"
        mkdir -p "$WT_ROOT"
        if git -C "$project_path" rev-parse --verify --quiet "refs/heads/$name" >/dev/null; then
            branch="$name"
            info "git worktree add $path (branch $branch)"
            git -C "$project_path" worktree add "$path" "$branch" >&2
        else
            info "git worktree add $path -b $name"
            git -C "$project_path" worktree add -b "$name" "$path" >&2
        fi
    else
        info "reusing worktree $path"
    fi
    source_path="$path"
}

resolve_source() {
    if [[ -n "$src_path" ]]; then
        source_path="$project_path"
    elif [[ -n "$worktree" ]]; then
        ensure_worktree "$worktree"
    elif [[ "$copy" == 1 ]]; then
        local dest="$WT_ROOT/$project_slug" t0
        if [[ ! -d "$dest" ]]; then
            mkdir -p "$WT_ROOT"
            info "copying $project_path -> $dest (rsync -a, dirty state included)"
            t0=$SECONDS
            rsync -a "$project_path/" "$dest/"
            info "copied to $dest in $((SECONDS - t0))s"
        else
            info "reusing copy $dest"
        fi
        source_path="$dest"
    else
        source_path="$project_path"
    fi
    debug "workspace source: $source_path"
}

slug_for_source() {
    local s
    s="$(slugify "$(basename "$source_path")")"
    [[ -n "$s" ]] || s="workspace"
    printf '%s' "$s"
}

# ------------------------------------------------- fragment header parsing ---
frag_header() { # $1=file $2=key -> prints values (one per line)
    sed -n -E "s/^# POD_${2}[[:space:]]+//p" "$1"
}

join_header() { # $1=file $2=key -> values joined with ", " (empty if none)
    local out="" l
    while IFS= read -r l; do
        [[ -n "$l" ]] && out+="${out:+, }$l"
    done < <(frag_header "$1" "$2")
    printf '%s' "$out"
}

resolve_frag_file() { # $1=name -> prints path
    local n="$1"
    if [[ "$n" == */* ]]; then
        [[ -f "$n" ]] || die "fragment not found: $n"
        printf '%s' "$n"
    elif [[ -f "$n" && "$n" == *.Dockerfile ]]; then
        printf '%s' "$n"
    elif [[ -f "$FRAG_DIR/$n.Dockerfile" ]]; then
        printf '%s' "$FRAG_DIR/$n.Dockerfile"
    else
        die "unknown fragment '$n' (expected $FRAG_DIR/<name>.Dockerfile)"
    fi
}

collect_variant_meta() {
    # fills: v_ports v_profile v_build_args v_services
    v_ports=()
    v_profile=0
    v_build_args=()
    v_services=()
    local f file line
    for f in "${frags[@]}"; do
        file="$(resolve_frag_file "$f")"
        while IFS= read -r line; do
            [[ -n "$line" ]] && v_ports+=("$line")
        done < <(frag_header "$file" PORT)
        while IFS= read -r line; do
            [[ -n "$line" ]] && v_build_args+=("$line")
        done < <(frag_header "$file" BUILD_ARG)
        while IFS= read -r line; do
            [[ -n "$line" ]] && v_services+=("$line")
        done < <(frag_header "$file" SERVICE)
        if [[ "$(frag_header "$file" PROFILE)" == 1 ]]; then
            v_profile=1
        fi
    done
}

normalize_ports() { # input specs in, docker -p specs out (127.0.0.1 default)
    local spec n
    for spec in "$@"; do
        n="$(awk -F: '{print NF}' <<<"$spec")"
        case "$n" in
            1) printf '127.0.0.1:%s:%s\n' "$spec" "$spec" ;;
            2) printf '127.0.0.1:%s\n' "$spec" ;;
            *) printf '%s\n' "$spec" ;;
        esac
    done
}

variant_name() {
    if [[ ${#frags[@]} -eq 0 ]]; then
        printf 'base'
    else
        local IFS='-'
        printf '%s' "${frags[*]}"
    fi
}

tag_for_index() { # $1=count of frags included so far (0 = base)
    local n="$1"
    if [[ "$n" -eq 0 ]]; then
        printf 'base'
    else
        local IFS='-'
        printf '%s' "${frags[*]:0:n}"
    fi
}

# ------------------------------------------------------------------ build ---
log_rows() { # visual terminal rows $1 occupies (\r-rewritten lines count once)
    local cols
    cols="$(tput cols 2>/dev/null || true)"
    [[ -n "$cols" && "$cols" -gt 0 ]] || cols=80
    awk -v cols="$cols" '
        {
            m = 0
            n = split($0, a, "\r")
            for (i = 1; i <= n; i++) if (length(a[i]) > m) m = length(a[i])
            r = int((m + cols) / cols)
            if (r < 1) r = 1
            total += r
        }
        END { print total + 0 }
    ' "$1"
}

erase_rows() { # move up N rows and clear them (best effort: capped to the screen)
    local n="$1" max
    max="$(tput lines 2>/dev/null || true)"
    [[ -n "$max" && "$max" -gt 0 ]] || max=24
    max=$((max - 2))
    ((n > max)) && n="$max"
    ((n > 0)) || return 0
    printf '\033[%dA\033[0J' "$n" >&2
}

run_build() { # podman build with mode-aware output handling
    local t0=$SECONDS tag="" log rows i args=("$@")
    i=0
    while [[ $i -lt ${#args[@]} ]]; do
        case "${args[$i]}" in
            -t|--tag) i=$((i + 1)); tag="${args[$i]:-}" ;;
        esac
        i=$((i + 1))
    done

    if [[ "$quiet" == 1 ]]; then
        log="$(mktemp "${TMPDIR:-/tmp}/pod-build.XXXXXX")"
        if ! podman build "$@" >"$log" 2>&1; then
            cat "$log" >&2
            rm -f "$log"
            return 1
        fi
        rm -f "$log"
        return 0
    fi

    if [[ "$verbose" == 1 || ! -t 2 ]]; then
        # keep the log: verbose, or no TTY to erase it from
        if podman build "$@" >&2; then
            info "built ${tag:-image} in $((SECONDS - t0))s"
            return 0
        fi
        return 1
    fi

    # default TTY: stream live, erase on success, keep on failure
    log="$(mktemp "${TMPDIR:-/tmp}/pod-build.XXXXXX")"
    if podman build "$@" 2>&1 | tee "$log" >&2; then
        rows="$(log_rows "$log")"
        [[ -n "$(tail -c1 "$log" 2>/dev/null || true)" ]] && printf '\n' >&2
        erase_rows "$rows"
        rm -f "$log"
        info "built ${tag:-image} in $((SECONDS - t0))s"
        return 0
    fi
    rm -f "$log"
    return 1
}

build_chain() {
    local base_df base_tag prev tag i=0 f file args=() nocache=()
    if [[ "$rebuild" == 1 ]]; then
        nocache=(--no-cache)
    fi

    if [[ -f "$project_path/Dockerfile" ]]; then
        base_df="$project_path/Dockerfile"
        info "base Dockerfile: $base_df"
    else
        if [[ "$quiet" == 1 ]]; then
            # rationale goes to stderr; keep it out of oc's view unless it fails
            local gen_log
            gen_log="$(mktemp "${TMPDIR:-/tmp}/pod-gen.XXXXXX")"
            base_df="$("$DFGEN" --info "$project_path" 2>"$gen_log")" || {
                cat "$gen_log" >&2
                rm -f "$gen_log"
                die "dockerfile.gen failed for $project_path"
            }
            rm -f "$gen_log"
        else
            base_df="$("$DFGEN" --info "$project_path")" \
                || die "dockerfile.gen failed for $project_path"
        fi
        info "generated base Dockerfile: $base_df"
    fi

    base_tag="localhost/pod-$project_slug:base"
    info "building $base_tag"
    run_build "${nocache[@]}" \
        --label pod.cmd=1 --label "pod.project=$project_slug" \
        -t "$base_tag" -f "$base_df" "$project_path" \
        || die "base image build failed (log above)"

    prev="$base_tag"
    for f in "${frags[@]}"; do
        i=$((i + 1))
        file="$(resolve_frag_file "$f")"
        tag="localhost/pod-$project_slug:$(tag_for_index "$i")"
        args=(--build-arg "BASE=$prev")

        local ba bval
        while IFS= read -r ba; do
            [[ -n "$ba" ]] || continue
            if [[ "$ba" == "SSH_PUBKEY" ]]; then
                bval="${SSH_PUBKEY:-${POD_SSH_PUBKEY:-}}"
                if [[ -z "$bval" ]]; then
                    bval="$(cat "$HOME"/.ssh/*.pub 2>/dev/null || true)"
                fi
                if [[ -z "$bval" ]]; then
                    warn "SSH_PUBKEY: nothing to bake in (no ~/.ssh/*.pub, no SSH_PUBKEY env); set SSH_PUBKEY=... or --build-arg SSH_PUBKEY=..."
                fi
            else
                bval="${!ba:-}"
            fi
            args+=(--build-arg "$ba=$bval")
        done < <(frag_header "$file" BUILD_ARG)

        local kv
        for kv in "${build_args_cli[@]}"; do
            args+=(--build-arg "$kv")
        done

        info "layering fragment '$f' -> $tag"
        run_build "${nocache[@]}" \
            --label pod.cmd=1 --label "pod.project=$project_slug" --label "pod.fragment=$f" \
            "${args[@]}" -t "$tag" -f "$file" "$project_path" \
            || die "fragment build failed: $f (log above)"
        prev="$tag"
    done
    final_image="$prev"
    debug "final image: $final_image"
}

# --------------------------------------------------------------- container ---
container_name() {
    local slug candidate alt ptag=""
    slug="$(slug_for_source)"
    [[ -n "$profile" && "$profile" != "default" ]] && ptag="-$profile"
    candidate="pod-$slug$ptag-$variant"
    if ! podman container exists "$candidate" 2>/dev/null; then
        debug "container name: $candidate (free)"
        printf '%s' "$candidate"
        return 0
    fi
    local c_source c_variant c_profile
    c_source="$(podman container inspect -f '{{index .Config.Labels "pod.source"}}' "$candidate" 2>/dev/null || true)"
    c_variant="$(podman container inspect -f '{{index .Config.Labels "pod.variant"}}' "$candidate" 2>/dev/null || true)"
    c_profile="$(podman container inspect -f '{{index .Config.Labels "pod.profile"}}' "$candidate" 2>/dev/null || true)"
    if [[ "$c_source" == "$source_path" && "$c_variant" == "$variant" && "$c_profile" == "$profile" ]]; then
        debug "container name: $candidate (labels match)"
        printf '%s' "$candidate"
        return 0
    fi
    alt="pod-$slug-$(printf '%s' "$source_path" | sha1sum | cut -c1-6)$ptag-$variant"
    debug "container name: $candidate (taken by another workspace; trying $alt)"
    if podman container exists "$alt" 2>/dev/null; then
        c_source="$(podman container inspect -f '{{index .Config.Labels "pod.source"}}' "$alt" 2>/dev/null || true)"
        c_variant="$(podman container inspect -f '{{index .Config.Labels "pod.variant"}}' "$alt" 2>/dev/null || true)"
        c_profile="$(podman container inspect -f '{{index .Config.Labels "pod.profile"}}' "$alt" 2>/dev/null || true)"
        if [[ "$c_source" == "$source_path" && "$c_variant" == "$variant" && "$c_profile" == "$profile" ]]; then
            printf '%s' "$alt"
            return 0
        fi
        die "container name collision: $candidate and $alt are taken by other workspaces"
    fi
    printf '%s' "$alt"
}

create_container() { # $1=name
    local name="$1" p
    local run_args=(
        run -d
        --name "$name"
        --init
        --user 0
        --label pod.cmd=1
        --label "pod.project=$project_slug"
        --label "pod.path=$project_path"
        --label "pod.source=$source_path"
        --label "pod.variant=$variant"
        --label "pod.profile=$profile"
        --label "pod.created=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        --entrypoint /bin/sh
        -v "$source_path:/workspace:rw"
        -w /workspace
    )

    local specs=() p
    while IFS= read -r p; do
        [[ -n "$p" ]] && specs+=("$p")
    done < <(normalize_ports "${v_ports[@]}" "${ports_cli[@]}")

    if [[ -n "$shared_pod" ]]; then
        # in a pod the netns is shared: add-host + ports must live on the pod
        if podman pod exists "$shared_pod" 2>/dev/null; then
            if [[ ${#specs[@]} -gt 0 ]]; then
                warn "pod $shared_pod already exists (its ports are fixed at creation); ${specs[*]} not published for $name"
            fi
        else
            local pod_args=(
                pod create --label pod.cmd=1 --label "pod.project=$project_slug"
                --add-host host.containers.internal:host-gateway
            )
            for p in ${specs[@]+"${specs[@]}"}; do
                pod_args+=(--publish "$p")
            done
            podman "${pod_args[@]}" "$shared_pod" >/dev/null \
                || die "pod create failed: $shared_pod"
        fi
        run_args+=(--pod "$shared_pod")
    else
        run_args+=(--add-host=host.containers.internal:host-gateway)
        for p in ${specs[@]+"${specs[@]}"}; do
            run_args+=(-p "$p")
        done
    fi

    if [[ "$v_profile" == 1 ]]; then
        podman volume exists "oc-profile-$profile" 2>/dev/null \
            || podman volume create "oc-profile-$profile" >/dev/null
        # pre-create the XDG skeleton on the host so later in-container writes
        # land inside host-owned dirs (keeps host-side oc-seed able to write)
        local vmp
        vmp="$(podman volume inspect "oc-profile-$profile" --format '{{.Mountpoint}}' 2>/dev/null || true)"
        if [[ -n "$vmp" && -d "$vmp" ]]; then
            mkdir -p "$vmp/config/opencode" "$vmp/data/opencode" 2>/dev/null || true
        fi
        run_args+=(
            -v "oc-profile-$profile:/profile"
            -e XDG_CONFIG_HOME=/profile/config
            -e XDG_DATA_HOME=/profile/data
            -e XDG_CACHE_HOME=/profile/cache
            -e XDG_STATE_HOME=/profile/state
        )
    fi

    if [[ "$no_git" == 0 && -f "$HOME/.gitconfig" ]]; then
        run_args+=(-v "$HOME/.gitconfig:/root/.gitconfig:ro")
    fi
    if [[ "$no_ssh" == 0 && -d "$HOME/.ssh" ]]; then
        run_args+=(-v "$HOME/.ssh:/root/.ssh:ro")
    fi

    local var
    for var in ANTHROPIC_API_KEY OPENAI_API_KEY GOOGLE_GENERATIVE_AI_API_KEY \
               XAI_API_KEY GROQ_API_KEY OPENROUTER_API_KEY DEEPSEEK_API_KEY \
               OPENCODE_API_KEY; do
        [[ -n "${!var:-}" ]] && run_args+=(-e "$var")
    done

    info "creating container $name (image $final_image, workspace $source_path)"
    podman "${run_args[@]}" "$final_image" -c 'exec sleep infinity' >/dev/null \
        || die "container create failed"
    container="$name"
}

ensure_container() {
    build_chain
    container="$(container_name)"
    if podman container exists "$container" 2>/dev/null; then
        debug "reusing container $container"
        if [[ -n "$shared_pod" ]]; then
            local want have
            want="$(podman pod inspect "$shared_pod" --format '{{.Id}}' 2>/dev/null || true)"
            have="$(podman container inspect -f '{{.Pod}}' "$container" 2>/dev/null || true)"
            if [[ -n "$want" && "$have" != "$want" ]]; then
                warn "container $container is not in pod $shared_pod; remove it first to recreate there"
            fi
        fi
        if [[ "$(podman container inspect -f '{{.State.Running}}' "$container")" != "true" ]]; then
            info "starting $container"
            podman start "$container" >/dev/null
        fi
    else
        create_container "$container"
    fi
}

resolve_container() { # $1=variant filter ("" = auto); prints name or ""
    local want="$1" path
    local -a matches=() matches_cont=() running=()
    while IFS= read -r path; do
        [[ -n "$path" ]] && matches+=("$path")
    done < <(podman container ls -a --filter label=pod.cmd=1 --filter label=pod.source --format '{{.Names}}')
    local m c_path c_variant
    for m in "${matches[@]}"; do
        c_path="$(podman container inspect -f '{{index .Config.Labels "pod.path"}}' "$m" 2>/dev/null || true)"
        [[ "$c_path" == "$project_path" ]] || continue
        if [[ -n "$want" ]]; then
            c_variant="$(podman container inspect -f '{{index .Config.Labels "pod.variant"}}' "$m" 2>/dev/null || true)"
            [[ "$c_variant" == "$want" ]] || continue
        fi
        if [[ "$(podman container inspect -f '{{.State.Running}}' "$m" 2>/dev/null)" == "true" ]]; then
            running+=("$m")
        fi
        matches_cont+=("$m")
    done
    if [[ -n "$want" ]]; then
        if [[ ${#matches_cont[@]} -gt 0 ]]; then
            printf '%s' "${matches_cont[0]}"
        else
            die "no container with variant '$want' for $project_path"
        fi
        return 0
    fi
    if [[ ${#running[@]} -eq 1 ]]; then
        printf '%s' "${running[0]}"
    elif [[ ${#running[@]} -gt 1 ]]; then
        printf '%s\n' "${running[@]}" >&2
        die "several containers are running for this project; pick one with -v VARIANT"
    elif [[ ${#matches_cont[@]} -eq 1 ]]; then
        printf '%s' "${matches_cont[0]}"
    elif [[ ${#matches_cont[@]} -gt 1 ]]; then
        printf '%s\n' "${matches_cont[@]}" >&2
        die "several containers for this project; pick one with -v VARIANT"
    fi
}

ensure_ready() { # project+source+frags resolved; ensures variant meta + container
    variant="$(variant_name)"
    debug "variant: $variant (frags: ${frags[*]:-none})"
    collect_variant_meta
    ensure_container
}

service_cmd() { # $1=service name -> prints cmd (searches variant services)
    local s
    for s in "${v_services[@]}"; do
        if [[ "${s%%=*}" == "$1" ]]; then
            printf '%s' "${s#*=}"
            return 0
        fi
    done
    return 1
}

service_running() { # $1=container $2=first word of cmd (POSIX-sh safe)
    podman exec "$1" /bin/sh -c \
        'for p in /proc/[0-9]*/cmdline; do
             a=$(tr "\000" "\n" < "$p" 2>/dev/null | head -n1) || continue
             [ -z "$a" ] && continue
             case "$a" in "$1"|*/"$1") exit 0 ;; esac
         done
         exit 1' \
        sh "$2" 2>/dev/null
}

find_frag_for_service() { # $1=service name -> prints fragment name
    local f file line
    for f in "${with_frags[@]}" "${frags[@]}"; do
        file="$(resolve_frag_file "$f" 2>/dev/null)" || continue
        while IFS= read -r line; do
            if [[ "${line%%=*}" == "$1" ]]; then
                printf '%s' "$f"
                return 0
            fi
        done < <(frag_header "$file" SERVICE)
    done
    # last resort: search the whole fragment library
    for file in "$FRAG_DIR"/*.Dockerfile; do
        while IFS= read -r line; do
            if [[ "${line%%=*}" == "$1" ]]; then
                basename "$file" .Dockerfile
                return 0
            fi
        done < <(frag_header "$file" SERVICE)
    done
    return 1
}

# ---------------------------------------------------------------- commands ---
append_frags() { # words (possibly comma separated) -> appends to frags
    local w parts
    for w in "$@"; do
        IFS=',' read -ra parts <<<"$w"
        frags+=("${parts[@]}")
    done
}

frags_from_variant() { # -v VARIANT on up/ensure/build: variant name = joined frags
    [[ -n "$variant_flag" && ${#frags[@]} -eq 0 ]] || return 0
    local IFS='-'
    read -ra frags <<<"$variant_flag"
}

cmd_frags() {
    local files=() f n ports prof bargs snames sl desc markstr
    shopt -s nullglob
    files=("$FRAG_DIR"/*.Dockerfile)
    shopt -u nullglob
    if [[ ${#files[@]} -eq 0 ]]; then
        info "no fragment Dockerfiles in $FRAG_DIR"
        return 0
    fi

    printf 'FRAGMENTS (%s):\n' "$FRAG_DIR"
    printf 'use: pod <name> | pod up <name>,<other> | --with <name> | oc --with <name>\n\n'
    for f in "${files[@]}"; do
        n="$(basename "$f" .Dockerfile)"
        ports="$(join_header "$f" PORT)"
        prof="$(join_header "$f" PROFILE)"
        bargs="$(join_header "$f" BUILD_ARG)"
        snames=""
        while IFS= read -r sl; do
            [[ -n "$sl" ]] && snames+="${snames:+, }${sl%%=*}"
        done < <(frag_header "$f" SERVICE)

        markstr=""
        [[ -n "$ports" ]] && markstr+="port $ports  "
        [[ -n "$prof" ]] && markstr+="profile  "
        [[ -n "$bargs" ]] && markstr+="build-arg $bargs  "
        [[ -n "$snames" ]] && markstr+="service $snames"
        markstr="${markstr%  }"

        desc="$(awk -v n="$n" '
            index($0, "# " n " - ") == 1 { g = 1; sub("^# " n " - ", ""); printf "%s", $0; next }
            g && /^# / && !/^# POD_/ { sub(/^# /, ""); printf " %s", $0; next }
            g { exit }
            END { print "" }
        ' "$f")"

        printf '  %-8s %s\n' "$n" "${markstr:+$markstr  }$desc"
    done
}

cmd_up() {
    frags=()
    append_frags "${with_frags[@]}" "${positional[@]}"
    frags_from_variant
    resolve_project
    resolve_source
    ensure_ready
    info "container $container is up ($source_path -> /workspace)"
    if [[ -t 0 && -t 1 ]]; then
        local -a tty=(-it)
        podman exec "${tty[@]}" "$container" \
            /bin/sh -c 'command -v bash >/dev/null 2>&1 && exec bash || exec sh'
    else
        info "not a TTY; run: $TOOL exec <cmd>   or   $TOOL shell"
    fi
}

cmd_ensure() {
    frags=()
    append_frags "${with_frags[@]}" "${positional[@]}"
    frags_from_variant
    resolve_project
    resolve_source
    ensure_ready
    if [[ "$quiet" == 1 ]]; then
        printf '%s\n' "$container"
    else
        info "container $container is up"
        printf '%s\n' "$container"
    fi
}

cmd_oc() {
    frags=()
    append_frags "${with_frags[@]}" oc
    resolve_project
    resolve_source
    ensure_ready
    if [[ "$v_profile" == 1 && -x "$SCRIPT_DIR/oc-seed" ]]; then
        "$SCRIPT_DIR/oc-seed" "oc-profile-$profile"
    fi
    local -a tty=(-i) eargs=()
    [[ -t 0 && -t 1 ]] && tty+=(-t)
    local var
    for var in ANTHROPIC_API_KEY OPENAI_API_KEY GOOGLE_GENERATIVE_AI_API_KEY \
               XAI_API_KEY GROQ_API_KEY OPENROUTER_API_KEY DEEPSEEK_API_KEY \
               OPENCODE_API_KEY TERM COLORTERM LANG; do
        [[ -n "${!var:-}" ]] && eargs+=(-e "$var")
    done
    podman exec "${tty[@]}" ${eargs[@]+"${eargs[@]}"} \
        "$container" opencode ${positional[@]+"${positional[@]}"}
}

cmd_build() {
    frags=()
    append_frags "${with_frags[@]}" "${positional[@]}"
    frags_from_variant
    resolve_project
    resolve_source
    variant="$(variant_name)"
    build_chain
    info "image ready: $final_image"
}

cmd_shell() {
    resolve_project
    resolve_source
    local c
    c="$(resolve_container "$variant_flag")"
    if [[ -z "$c" ]]; then
        frags=("${with_frags[@]}")
        variant="$(variant_name)"
        collect_variant_meta
        ensure_container
        c="$container"
    fi
    if [[ -t 0 && -t 1 ]]; then
        podman exec -it "$c" /bin/sh -c 'command -v bash >/dev/null 2>&1 && exec bash || exec sh'
    else
        info "container $c is up; not a TTY"
        printf '%s\n' "$c"
    fi
}

cmd_exec() {
    [[ ${#positional[@]} -gt 0 ]] || die "exec needs a command (pod exec CMD ...)"
    resolve_project
    resolve_source
    local c
    c="$(resolve_container "$variant_flag")"
    if [[ -z "$c" ]]; then
        frags=("${with_frags[@]}")
        variant="$(variant_name)"
        collect_variant_meta
        ensure_container
        c="$container"
    fi
    local -a args=()
    [[ -t 0 && -t 1 ]] && args+=(-t)
    local e
    for e in "${exec_env[@]}"; do
        args+=(-e "$e")
    done
    local v
    for v in TERM COLORTERM LANG; do
        [[ -n "${!v:-}" ]] && args+=(-e "$v")
    done
    podman exec "${args[@]}" "$c" "${positional[@]}"
}

cmd_logs() {
    resolve_project
    resolve_source
    local c
    c="$(resolve_container "$variant_flag")"
    [[ -n "$c" ]] || die "no container for $project_path"
    local -a args=(logs)
    [[ "$follow" == 1 ]] && args+=(-f)
    podman "${args[@]}" "$c"
}

cmd_service() {
    local name="${positional[0]:?usage: pod service NAME [--fg]}"
    resolve_project
    resolve_source
    # make sure the variant includes the fragment that declares this service
    local frag=""
    frag="$(find_frag_for_service "$name")" \
        || die "no fragment declares a service named '$name'"
    local has=0 f
    for f in "${with_frags[@]}"; do
        [[ "$f" == "$frag" ]] && has=1
    done
    [[ "$has" == 1 ]] || with_frags+=("$frag")
    frags=()
    append_frags "${with_frags[@]}" "${positional[@]:1}"
    variant="$(variant_name)"
    collect_variant_meta
    ensure_container

    local cmd
    cmd="$(service_cmd "$name")" || die "service '$name' vanished from variant meta"
    if service_running "$container" "${cmd%% *}"; then
        info "service '$name' already running in $container"
    elif [[ "$fg" == 1 ]]; then
        info "running '$cmd' in $container (foreground)"
        podman exec -it "$container" /bin/sh -c "$cmd"
    else
        info "starting '$name' in $container: $cmd"
        podman exec -d "$container" /bin/sh -c "$cmd" >/dev/null
    fi
}

cmd_vscode() {
    local port=""
    resolve_project
    resolve_source
    local frag=""
    frag="$(find_frag_for_service code-server)" || die "vscode fragment not found"
    local has=0 f file
    for f in "${with_frags[@]}"; do [[ "$f" == "$frag" ]] && has=1; done
    [[ "$has" == 1 ]] || with_frags+=("$frag")
    frags=("${with_frags[@]}")
    variant="$(variant_name)"
    collect_variant_meta
    ensure_container
    port="$(frag_header "$(resolve_frag_file "$frag")" PORT | head -n1)"
    port="${port%%:*}"
    cmd_service_run code-server
    info "code-server: http://127.0.0.1:${port:-8080}/   (workspace /workspace)"
}

cmd_service_run() { # like cmd_service but assumes frags/variant/collect done
    local name="$1" cmd
    cmd="$(service_cmd "$name")" || die "service '$name' not in variant"
    if service_running "$container" "${cmd%% *}"; then
        info "service '$name' already running in $container"
    elif [[ "$fg" == 1 ]]; then
        podman exec -it "$container" /bin/sh -c "$cmd"
    else
        info "starting '$name': $cmd"
        podman exec -d "$container" /bin/sh -c "$cmd" >/dev/null
    fi
}

cmd_ssh() {
    local frag port
    frag="$(find_frag_for_service sshd)" || die "ssh fragment not found"
    port="$(frag_header "$(resolve_frag_file "$frag")" PORT | head -n1)"
    port="${port%%:*}"
    port="${port:-2222}"
    local sshcmd="ssh -p $port root@127.0.0.1"
    resolve_project
    resolve_source
    local has=0 f
    for f in "${with_frags[@]}"; do [[ "$f" == "$frag" ]] && has=1; done
    [[ "$has" == 1 ]] || with_frags+=("$frag")
    frags=("${with_frags[@]}")
    variant="$(variant_name)"
    collect_variant_meta
    ensure_container
    cmd_service_run sshd
    printf '%s\n' "$sshcmd"
    if command -v c.c >/dev/null 2>&1; then
        c.c "$sshcmd" && info "copied to clipboard"
    fi
    info "scp: scp -P $port file root@127.0.0.1:/workspace/"
}

cmd_ide() {
    resolve_project
    resolve_source
    local c
    c="$(resolve_container "$variant_flag")"
    if [[ -z "$c" ]]; then
        frags=("${with_frags[@]}")
        variant="$(variant_name)"
        collect_variant_meta
        ensure_container
        c="$container"
    fi
    local hex uri
    hex="$(printf '%s' "$c" | od -An -v -t x1 | tr -d ' \n')"
    uri="vscode-remote://attached-container+$hex/workspace"
    local sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
    local -a lines=(
        "export DOCKER_HOST=unix://$sock   # if the Dev Containers ext needs it"
        "code --folder-uri \"$uri\""
        "# or in VS Code: F1 -> \"Dev Containers: Attach to Running Container...\" -> $c"
    )
    if [[ "$run_flag" == 1 ]]; then
        command -v code >/dev/null 2>&1 || die "code (VS Code CLI) not found"
        DOCKER_HOST="unix://$sock" code --folder-uri "$uri"
    else
        printf '%s\n' "${lines[@]}"
        if command -v c.c >/dev/null 2>&1; then
            c.c "code --folder-uri \"$uri\"" && info "command copied to clipboard"
        fi
    fi
}

cmd_wt() {
    local name="${positional[0]:?usage: pod wt NAME [FRAG...]}"
    positional=("${positional[@]:1}")
    resolve_project
    worktree="$name"
    resolve_source
    frags=()
    append_frags "${with_frags[@]}" "${positional[@]}"
    variant="$(variant_name)"
    collect_variant_meta
    ensure_container
    info "worktree container $container is up ($source_path)"
    if [[ -t 0 && -t 1 ]]; then
        podman exec -it "$container" /bin/sh -c 'command -v bash >/dev/null 2>&1 && exec bash || exec sh'
    fi
}

cmd_list() {
    local m
    printf '%-44s %-10s %-14s %-30s %s\n' "CONTAINER" "STATE" "VARIANT" "PROJECT" "WORKSPACE"
    while IFS= read -r m; do
        [[ -n "$m" ]] || continue
        local state path source variant ports
        state="$(podman container inspect -f '{{.State.Status}}' "$m")"
        path="$(podman container inspect -f '{{index .Config.Labels "pod.path"}}' "$m")"
        source="$(podman container inspect -f '{{index .Config.Labels "pod.source"}}' "$m")"
        variant="$(podman container inspect -f '{{index .Config.Labels "pod.variant"}}' "$m")"
        ports="$(podman port "$m" --all 2>/dev/null | paste -sd, - || true)"
        printf '%-44s %-10s %-14s %-30s %s\n' "$m" "$state" "$variant" "$(basename "$path")" "$source"
        if [[ -n "$ports" ]]; then
            printf '%44s ports: %s\n' "" "$ports"
        fi
    done < <(podman container ls -a --filter label=pod.cmd=1 --filter label=pod.source --format '{{.Names}}' | sort)
}

containers_for_project() { # $1=project_path; $2=optional variant; prints names
    local m c_path c_variant want="${2:-}"
    while IFS= read -r m; do
        [[ -n "$m" ]] || continue
        c_path="$(podman container inspect -f '{{index .Config.Labels "pod.path"}}' "$m" 2>/dev/null || true)"
        [[ "$c_path" == "$1" ]] || continue
        if [[ -n "$want" ]]; then
            c_variant="$(podman container inspect -f '{{index .Config.Labels "pod.variant"}}' "$m" 2>/dev/null || true)"
            [[ "$c_variant" == "$want" ]] || continue
        fi
        printf '%s\n' "$m"
    done < <(podman container ls -a --filter label=pod.cmd=1 --filter label=pod.source --format '{{.Names}}')
}

cmd_down() {
    local m n=0 list
    if [[ ${#positional[@]} -gt 0 ]]; then
        [[ ${#positional[@]} -eq 1 && "${positional[0]}" == "all" && -z "$variant_flag" ]] \
            || die "usage: $TOOL down [-v VARIANT] | $TOOL down all"
    fi
    if [[ "${positional[0]:-}" == "all" ]]; then
        list="$(podman container ls -a --filter label=pod.cmd=1 --filter label=pod.source --format '{{.Names}}' | sort)"
    else
        resolve_project
        list="$(containers_for_project "$project_path" "$variant_flag")"
    fi
    while IFS= read -r m; do
        [[ -n "$m" ]] || continue
        if [[ "$(podman container inspect -f '{{.State.Running}}' "$m")" == "true" ]]; then
            info "stopping $m"
            podman stop "$m" >/dev/null
        fi
        n=$((n + 1))
    done <<<"$list"
    if [[ "$n" == 0 ]]; then
        if [[ "${positional[0]:-}" == "all" ]]; then
            info "no dev containers to stop"
        else
            info "nothing to stop for $project_path"
        fi
    fi
}

cmd_rm() {
    resolve_project
    local m n=0
    while IFS= read -r m; do
        [[ -n "$m" ]] || continue
        info "removing $m"
        podman rm -f "$m" >/dev/null
        n=$((n + 1))
    done < <(containers_for_project "$project_path" "$variant_flag")
    if [[ "$n" == 0 ]]; then
        info "nothing to remove for $project_path"
    fi
}

cmd_prune() {
    local -a victims=()
    local m state
    while IFS= read -r m; do
        [[ -n "$m" ]] || continue
        state="$(podman container inspect -f '{{.State.Status}}' "$m")"
        if [[ "$state" != "running" ]]; then
            victims+=("$m")
        fi
    done < <(podman container ls -a --filter label=pod.cmd=1 --filter label=pod.source --format '{{.Names}}')

    if [[ ${#victims[@]} -gt 0 ]]; then
        if [[ "$dry_run" == 1 ]]; then
            printf 'would remove containers:\n'
            printf '  %s\n' "${victims[@]}"
        else
            for m in "${victims[@]}"; do
                info "pruning container $m"
                podman rm -f "$m" >/dev/null
            done
        fi
    else
        info "no stopped dev containers"
    fi

    if [[ "$images_flag" == 1 ]]; then
        local -a used=() imgs=() left=()
        local m img id u hit removed
        while IFS= read -r m; do
            used+=("$(podman container inspect -f '{{.Image}}' "$m" 2>/dev/null || true)")
        done < <(podman container ls -a --filter label=pod.cmd=1 --filter label=pod.source --format '{{.Names}}')

        # stale buildah working containers (from interrupted builds) pin images
        local idset=" " ext ext_name
        while IFS= read -r img; do
            [[ -n "$img" ]] && idset+="${img%% *} "
        done < <(podman image ls --filter label=pod.cmd=1 --format '{{.ID}} {{.Repository}}:{{.Tag}}')
        while IFS=' ' read -r ext _ ext_name; do
            [[ -n "$ext" ]] || continue
            if [[ "$ext_name" == pod-*-working-container* ]] \
               || [[ "$idset" == *" ${ext_name%%-*} "* ]]; then
                if [[ "$dry_run" == 1 ]]; then
                    printf 'would remove stale build container: %s\n' "$ext_name"
                else
                    info "removing stale build container $ext_name"
                    podman rm -f "$ext" >/dev/null 2>&1 || true
                fi
            fi
        done < <(podman ps -a --external --format '{{.ID}} {{.Image}} {{.Names}}')

        # chains reference each other and freed images surface as new danglers:
        # re-list every round and stop once a round makes no progress
        while :; do
            imgs=()
            while IFS= read -r img; do
                [[ -n "$img" ]] || continue
                id="${img%% *}"
                hit=0
                for u in "${used[@]}"; do
                    [[ "$u" == "$id" ]] && hit=1
                done
                [[ "$hit" == 1 ]] && continue
                imgs+=("$img")
            done < <(podman image ls --filter label=pod.cmd=1 --format '{{.ID}} {{.Repository}}:{{.Tag}}')

            if [[ "$dry_run" == 1 ]]; then
                for img in ${imgs[@]+"${imgs[@]}"}; do
                    printf 'would remove image: %s (%s)\n' "${img#* }" "${img%% *}"
                done
                break
            fi

            [[ ${#imgs[@]} -gt 0 ]] || break
            removed=0
            left=()
            for img in "${imgs[@]}"; do
                if podman rmi "${img%% *}" >/dev/null 2>&1; then
                    info "pruned image ${img#* }"
                    removed=1
                else
                    left+=("$img")
                fi
            done
            [[ ${#left[@]} -eq 0 ]] && break
            if [[ "$removed" == 0 ]]; then
                for img in "${left[@]}"; do
                    warn "could not remove ${img#* }"
                done
                break
            fi
        done
    fi

    # empty managed pods (their infra container always exists: ignore it)
    local pod podid real
    while IFS= read -r pod; do
        [[ -n "$pod" ]] || continue
        podid="$(podman pod inspect "$pod" --format '{{.Id}}' 2>/dev/null || true)"
        [[ -n "$podid" ]] || continue
        real="$(podman container ls -a --filter label=pod.cmd=1 --filter label=pod.source \
                    --format '{{.Pod}}' | grep -cx "$podid" || true)"
        [[ "$real" == "0" ]] || continue
        if [[ "$dry_run" == 1 ]]; then
            printf 'would remove empty pod: %s\n' "$pod"
        else
            info "removing empty pod $pod"
            podman pod rm "$pod" >/dev/null 2>&1 || true
        fi
    done < <(podman pod ls --filter label=pod.cmd=1 --format '{{.Name}}' 2>/dev/null)
}

# ---------------------------------------------------------------- dispatch ---
case "$cmd" in
    up)      cmd_up ;;
    ensure)  cmd_ensure ;;
    oc)      cmd_oc ;;
    build)   cmd_build ;;
    frags)   cmd_frags ;;
    shell)   cmd_shell ;;
    exec)    cmd_exec ;;
    logs)    cmd_logs ;;
    service) cmd_service ;;
    vscode)  cmd_vscode ;;
    ssh)     cmd_ssh ;;
    ide)     cmd_ide ;;
    wt)      cmd_wt ;;
    list)    cmd_list ;;
    down)    cmd_down ;;
    rm)      cmd_rm ;;
    prune)   cmd_prune ;;
    help)    show_help ;;
    *)       die "unknown command: $cmd (see --help)" ;;
esac
