#!/bin/bash
# pod - project dev containers: recipe-built images (pods/recipes/), one
#       labeled container per workspace (project / copy / worktree)
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
RECIPES_DIR="$ROOT_DIR/pods/recipes"
WT_ROOT="${POD_WT_ROOT:-$HOME/wt}"
DEFAULT_BASE="${POD_DEFAULT_BASE:-docker.io/library/archlinux:base}"
TOOL="pod"

info()  { [[ "${quiet:-0}" == 1 ]] && return 0; printf "${GREEN}✓${NC} %s\n" "$*" >&2; }
debug() { [[ "${verbose:-0}" == 1 && "${quiet:-0}" == 0 ]] || return 0; printf "${CYAN}·${NC} %s\n" "$*" >&2; }
warn()  { printf "${YELLOW}!${NC} %s\n" "$*" >&2; }
die()   { printf "${RED}✗${NC} %s\n" "$*" >&2; exit 1; }

show_help() {
    cat << EOF
Usage: $TOOL [OPTIONS] [COMMAND] [SELECTION...] [ARGS...]

Project dev containers. Recipes (pods/recipes/) print a Dockerfile each; pod
builds them as a chain and keeps one persistent, labeled container per
workspace (project dir, copy, or git worktree) with the workspace at
/workspace. bin/oc runs opencode through the same machinery.

A build's log streams while it runs, then is erased again on success (the
✓ summaries with timing remain); --verbose keeps the log and adds detail.

CONCEPTS:
  recipe     executable script in pods/recipes/<name> that prints a complete
             Dockerfile to stdout. Its argv = the recipe's options, and
             POD_PROJECT_DIR=<project> is set; the host environment is
             inherited. Bundled: base, oc, vscode, ssh
             (each prints its own help: $TOOL .<name> --help).
  selection  ".recipe [opts ...] ..." tokens applied in order; a bare word is
             an existing image to start FROM (a project dish like base-oc, or
             a full ref like docker.io/library/alpine:latest). Bare words
             after a .recipe are that recipe's options, until the next
             .recipe. No selection = .base (the project's own image).
  dish       the selection distilled into a name (options included): it is
             the image tag (localhost/pod-<project>:<dish>) and the
             container's identity. --as NAME overrides the derived name.
             pod .base .oc work  ->  image localhost/pod-<project>:base-oc-work
  workspace  what is bind-mounted at /workspace: \$PWD (default), --copy,
             --worktree NAME, --src PATH, or "pod wt NAME" (git worktree).
  container  pod-<workspace>[-<nametag>]-<dish>: one per workspace+dish,
             labeled (dish, selection, image id, ports, services, hints) and
             recreated automatically when its image changes (--recreate
             forces it). Different dishes of one project coexist.

COMMANDS (first non-option arg; bare "$TOOL [SELECTION...]" = run):
  [SELECTION...]        build if needed, (re)create the container, shell in
  name    [SELECTION]   build + create + start, print the container name only
                        (this is what bin/oc calls)
  build   [SELECTION]   images only; --rebuild = --no-cache
  recipes               list recipes with their ports/services/build args
                        ("frags" is an alias)
  info    [DISH|SELECTION]
                        show a container's labels, or the planned chain
  services [DISH]       services the container's recipes declare
  service NAME [DISH] [--fg]
                        start a service, print its hint (URL/command)
  shell   [DISH|SELECTION]
                        shell into the container (builds/starts it if needed)
  exec    [--dish DISH] [-e K=V]... CMD [args...]
                        run a command in the container (auto-starts it)
  logs    [-f] [DISH]   container logs
  ide     [--run] [DISH]   print (or run) the VS Code attach command
  wt      NAME [SELECTION...]   git worktree under $WT_ROOT + run
  list / ps             all dev containers this tool manages (labels)
  down    [DISH|all]    stop containers ("down all" = every managed one)
  rm      [DISH]        remove this project's containers
  prune [--dry-run] [--images]
                        GC stopped dev containers (+ empty pods); --images
                        also drops images no dev container uses anymore
  help

OPTIONS:
  -c, --copy            workspace = rsync copy of the project in $WT_ROOT
  -t, --worktree NAME   workspace = git worktree $WT_ROOT/<project>-NAME
                        (an existing path is mounted as-is)
      --src PATH        workspace = PATH (escape hatch)
      --as NAME         override the derived dish name
      --pod NAME        create/join a shared pod for this container
      --recreate        recreate the container even if the image is unchanged
  -p, --publish SPEC    extra port, docker style: 8080, 8080:8081, ip:h:c
      --build-arg K=V   forward a build arg to stages declaring ARG K
      --dish DISH       pick the container where no arg fits (exec)
  -b, --build           no-op: builds always run and are cache-checked
      --rebuild         rebuild with --no-cache
      --verbose         keep build logs on screen + debug detail (· lines)
      --quiet           no info output (what bin/oc uses)
  -h, --help            show this help

RECIPE CONTRACT (stdout = one complete Dockerfile, headers are comment lines):
  ARG BASE             recipe starts FROM the previous image; pod passes
                       --build-arg BASE=... only when declared (first stage
                       gets \$POD_DEFAULT_BASE, default archlinux:base).
                       Other declared ARGs are forwarded from the host
                       environment, --build-arg wins over it.
  # POD_PORT P         publish 127.0.0.1:P:P (also H:C and ip:H:C)
  # POD_SERVICE n=cmd  "pod service n" runs cmd in the container
  # POD_VOLUME v:/p    bind host path v (~ expands) at /p, or create the
                       named volume v when v has no slash
  # POD_ENV K[=V]      pass K through from the host when set, or set K=V
  # POD_NAMETAG s      container-name suffix: pod-<workspace>-s-<dish>
  # POD_HINT [service=n]text   printed by info/service; {port} {container}
                       {dish} are substituted
  # POD_BUILD_ARG K    listed by "pod recipes" (forwarding follows ARG lines)
  # POD_DESC ...       one-liner shown by "pod recipes"

EXAMPLES:
  pod                        # project image (.base) + shell
  pod .base .vscode .ssh     # code-server + sshd on the project image
  pod .base .oc work         # opencode agent + option "work" (pod .oc --help)
  pod build .base .oc        # images only
  pod base-oc .vscode        # fork: start FROM an earlier dish, add vscode
  pod .base .vscode --as dev # name the dish yourself
  pod service code-server    # start a service, print its hint (the URL)
  pod shell base-vscode      # attach to an existing dish
  pod exec cmake --build build --target tests
  pod wt tilt .base .vscode  # worktree workspace
  pod info; pod list; pod prune --images

NOTE: service stacks (pods/agents, ...) are managed separately with pods/stack.
EOF
}

# ---------------------------------------------------------------- defaults --
cmd=""
positional=()
ports_cli=()
build_args_cli=()
exec_env=()

copy=0
worktree=""
src_path=""
shared_pod=""
dish_flag=""
as_flag=""
rebuild=0
recreate=0
dry_run=0
images_flag=0
fg=0
quiet=0
verbose=0
follow=0
run_flag=0

known_commands="run name build recipes frags info services service shell exec logs ide wt list ps down rm prune help"
removed_commands="up ensure oc vscode ssh"

# ------------------------------------------------------------------ parse ---
while [[ $# -gt 0 ]]; do
    # after "exec CMD", everything is the command's own argv (incl. its flags)
    if [[ "$cmd" == "exec" && ${#positional[@]} -gt 0 ]]; then
        positional+=("$1")
        shift
        continue
    fi
    case "$1" in
        -h|--help)
            # after a .recipe in the selection, --help is that recipe's help
            rh=""
            for tok in ${positional[@]+"${positional[@]}"}; do
                [[ "$tok" == .* ]] && rh="${tok#.}"
            done
            if [[ -n "$rh" ]]; then
                rp="$RECIPES_DIR/$rh"
                if [[ -f "$rp" && -x "$rp" ]]; then
                    exec "$rp" --help
                fi
                avail=""
                for f in "$RECIPES_DIR"/*; do
                    [[ -f "$f" && -x "$f" ]] && avail+=" ${f##*/}"
                done
                die "unknown recipe '$rh' (available:${avail:- none})"
            fi
            show_help; exit 0 ;;
        -c|--copy) copy=1; shift ;;
        -t|--worktree) worktree="${2:?--worktree needs a name or path}"; shift 2 ;;
        --worktree=*) worktree="${1#*=}"; shift ;;
        --pod) shared_pod="${2:?--pod needs a name}"; shift 2 ;;
        --pod=*) shared_pod="${1#*=}"; shift ;;
        --dish) dish_flag="${2:?--dish needs a name}"; shift 2 ;;
        --dish=*) dish_flag="${1#*=}"; shift ;;
        --as) as_flag="${2:?--as needs a name}"; shift 2 ;;
        --as=*) as_flag="${1#*=}"; shift ;;
        -p|--publish) ports_cli+=("${2:?,--publish needs a port}"); shift 2 ;;
        --publish=*) ports_cli+=("${1#*=}"); shift ;;
        -b|--build) shift ;;
        --rebuild) rebuild=1; shift ;;
        --recreate) recreate=1; shift ;;
        --build-arg) build_args_cli+=("${2:?--build-arg needs K=V}"); shift 2 ;;
        --build-arg=*) build_args_cli+=("${1#*=}"); shift ;;
        --src) src_path="${2:?--src needs a path}"; shift 2 ;;
        --src=*) src_path="${1#*=}"; shift ;;
        --dry-run) dry_run=1; shift ;;
        --images) images_flag=1; shift ;;
        --fg) fg=1; shift ;;
        --quiet) quiet=1; shift ;;
        --verbose) verbose=1; shift ;;
        --run) run_flag=1; shift ;;
        -f) follow=1; shift ;;
        -e)
            exec_env+=("${2:?--exec-env needs K=V}"); shift 2 ;;
        -e=*) exec_env+=("${1#*=}"); shift ;;
        -w|--with)
            die "'$1' was replaced by selection tokens: $TOOL .base .vscode .ssh (see '$TOOL help')" ;;
        --with=*)
            die "'--with' was replaced by selection tokens: $TOOL .base .vscode .ssh (see '$TOOL help')" ;;
        --profile|--profile=*)
            die "'--profile' is now an option of the oc recipe: $TOOL .base .oc <profile> (see '$TOOL help')" ;;
        -v|--variant|--variant=*)
            die "'$1 VARIANT' was replaced by a dish argument: $TOOL shell <dish> (see '$TOOL help')" ;;
        --) shift; positional+=("$@"); break ;;
        -*)
            [[ -n "$cmd" ]] && die "unknown option: $1 after '$cmd' (see --help)"
            die "unknown option: $1 (see --help)" ;;
        *)
            if [[ -z "$cmd" ]]; then
                case " $known_commands " in
                    *" $1 "*) cmd="$1" ;;
                esac
                if [[ -z "$cmd" ]]; then
                    case " $removed_commands " in
                        *" $1 "*)
                            case "$1" in
                                up)     die "'$TOOL up' was replaced by: $TOOL [SELECTION] (e.g. $TOOL .base .vscode) -- see '$TOOL help'" ;;
                                ensure) die "'$TOOL ensure' was replaced by: $TOOL name [SELECTION] -- see '$TOOL help'" ;;
                                oc)     die "'$TOOL oc' was replaced by: oc (bin/oc), or $TOOL .base .oc -- see '$TOOL help'" ;;
                                vscode) die "'$TOOL vscode' was replaced by: $TOOL service code-server -- see '$TOOL help'" ;;
                                ssh)    die "'$TOOL ssh' was replaced by: $TOOL service sshd -- see '$TOOL help'" ;;
                            esac
                            ;;
                    esac
                    cmd="run"
                    positional+=("$1")
                fi
            else
                positional+=("$1")
            fi
            shift ;;
    esac
done
cmd="${cmd:-run}"

command -v podman >/dev/null 2>&1 || die "podman is not installed"

# ------------------------------------------------------------- resolution ---
slugify() { # usable in image repositories, tags and container names
    printf '%s' "$1" \
        | tr '[:upper:]' '[:lower:]' \
        | tr -cs 'a-z0-9' '-' \
        | sed 's/^-//; s/-$//'
}

join_by() { # $1=sep rest=items
    local IFS="$1"
    shift
    printf '%s' "$*"
}

resolve_project() {
    if [[ -n "$src_path" ]]; then
        [[ -d "$src_path" ]] || die "--src: no such directory: $src_path"
        project_path="$(cd "$src_path" && pwd)"
    else
        project_path="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
        [[ -n "$project_path" ]] || project_path="$PWD"
    fi
    project_name="$(basename "$project_path")"
    project_slug="$(slugify "$project_name")"
    [[ -n "$project_slug" ]] || project_slug="project"
    debug "project: $project_path (slug: $project_slug)"
}

ensure_worktree() { # uses $project_path/$project_slug; sets $source_path
    local name="$1" path branch
    if [[ "$name" == */* || "$name" == . || "$name" == .. || -d "$name" ]]; then
        if [[ -d "$name" ]]; then
            path="$(cd "$name" && pwd)"
            git -C "$path" rev-parse --git-dir >/dev/null 2>&1 \
                || die "not a git worktree/directory: $path"
            source_path="$path"
            return 0
        fi
        die "--worktree: $name is not an existing directory"
    fi
    path="$WT_ROOT/${project_slug}-${name}"
    if [[ ! -d "$path" ]]; then
        git -C "$project_path" rev-parse --git-dir >/dev/null 2>&1 \
            || die "worktrees need a git project ($project_path is not one)"
        mkdir -p "$WT_ROOT"
        if git -C "$project_path" rev-parse --verify --quiet "refs/heads/$name" >/dev/null; then
            branch="$name"
            info "git worktree add $path (branch $branch)"
            git -C "$project_path" worktree add "$path" "$branch" >&2
        else
            info "git worktree add $path -b $name"
            git -C "$project_path" worktree add -b "$name" "$path" >&2
        fi
    else
        info "reusing worktree $path"
    fi
    source_path="$path"
}

resolve_source() {
    if [[ -n "$src_path" ]]; then
        source_path="$project_path"
    elif [[ -n "$worktree" ]]; then
        ensure_worktree "$worktree"
    elif [[ "$copy" == 1 ]]; then
        local dest="$WT_ROOT/$project_slug" t0
        if [[ ! -d "$dest" ]]; then
            mkdir -p "$WT_ROOT"
            info "copying $project_path -> $dest (rsync -a, dirty state included)"
            t0=$SECONDS
            rsync -a "$project_path/" "$dest/"
            info "copied to $dest in $((SECONDS - t0))s"
        else
            info "reusing copy $dest"
        fi
        source_path="$dest"
    else
        source_path="$project_path"
    fi
    debug "workspace source: $source_path"
}

slug_for_source() {
    local s
    s="$(slugify "$(basename "$source_path")")"
    [[ -n "$s" ]] || s="workspace"
    printf '%s' "$s"
}

# --------------------------------------------------------- recipe + selection -
WORK_DIR=""
cleanup() { [[ -n "$WORK_DIR" ]] && rm -rf "$WORK_DIR"; return 0; }
trap cleanup EXIT

work_dir() {
    if [[ -z "$WORK_DIR" ]]; then
        WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/pod.XXXXXX")"
    fi
    printf '%s' "$WORK_DIR"
}

recipe_names_str() {
    local out="" f
    for f in "$RECIPES_DIR"/*; do
        [[ -f "$f" && -x "$f" ]] || continue
        out+="${out:+ }$(basename "$f")"
    done
    printf '%s' "$out"
}

resolve_recipe() { # $1=name -> prints script path
    local n="$1" p
    if [[ "$n" == */* ]]; then
        p="$n"
    else
        p="$RECIPES_DIR/$n"
    fi
    [[ -f "$p" ]] || die "unknown recipe '$n' (available: $(recipe_names_str))"
    [[ -x "$p" ]] || die "recipe is not executable: $p"
    printf '%s' "$p"
}

# parallel arrays describing the parsed selection
sel_kind=()   # recipe | image
sel_name=()
sel_opts=()   # recipe options joined with \x1f
dish=""
selection_str=""

parse_selection() {
    sel_kind=()
    sel_name=()
    sel_opts=()
    local n=${#positional[@]} i=0 tok
    local -a opts=()
    if [[ $n -eq 0 ]]; then
        sel_kind=(recipe) sel_name=(base) sel_opts=("")
    else
        while [[ $i -lt $n ]]; do
            tok="${positional[$i]}"
            if [[ "$tok" == .* ]]; then
                [[ ${#tok} -gt 1 ]] || die "empty recipe name in selection (wanted '.<recipe>')"
                sel_kind+=(recipe)
                sel_name+=("${tok:1}")
                sel_opts+=("")
                opts=()
                while [[ $((i + 1)) -lt $n && "${positional[$((i + 1))]}" != .* ]]; do
                    opts+=("${positional[$((i + 1))]}")
                    i=$((i + 1))
                done
                if [[ ${#opts[@]} -gt 0 ]]; then
                    sel_opts[${#sel_opts[@]} - 1]="$(join_by $'\x1f' "${opts[@]}")"
                fi
            else
                sel_kind+=(image)
                sel_name+=("$tok")
                sel_opts+=("")
            fi
            i=$((i + 1))
        done
    fi
    # validate recipes early (before any side effects like worktrees)
    local j
    for j in "${!sel_kind[@]}"; do
        [[ "${sel_kind[$j]}" == "recipe" ]] && resolve_recipe "${sel_name[$j]}" >/dev/null
    done
    derive_dish
    build_selection_str
    debug "selection: $selection_str (dish: $dish)"
}

stage_desc() { # $1=kind $2=name $3=opts -> slug fragment
    local part slug="" opt
    part="$(slugify "$2")"
    [[ -n "$part" ]] || part="stage"
    slug="$part"
    if [[ "$1" == "recipe" && -n "$3" ]]; then
        local -a o=()
        IFS=$'\x1f' read -ra o <<<"$3"
        for opt in ${o[@]+"${o[@]}"}; do
            [[ -n "$opt" ]] || continue
            slug+="-$(slugify "$opt")"
        done
    fi
    printf '%s' "$slug"
}

derive_dish() {
    local d="" j part
    for j in "${!sel_kind[@]}"; do
        part="$(stage_desc "${sel_kind[$j]}" "${sel_name[$j]}" "${sel_opts[$j]}")"
        d+="${d:+-}$part"
    done
    [[ -n "$d" ]] || d="base"
    if [[ -n "$as_flag" ]]; then
        d="$(slugify "$as_flag")"
        [[ -n "$d" ]] || die "--as: unusable name: $as_flag"
    elif [[ ${#d} -gt 48 ]]; then
        local h
        h="$(printf '%s' "$d" | sha256sum | cut -c1-8)"
        d="$(printf '%.40s' "$d")"
        d="${d%-}"
        d+="-$h"
    fi
    dish="$d"
}

build_selection_str() {
    local out="" s j x
    local -a o=()
    for j in "${!sel_kind[@]}"; do
        if [[ "${sel_kind[$j]}" == "recipe" ]]; then
            s=".${sel_name[$j]}"
            o=()
            if [[ -n "${sel_opts[$j]}" ]]; then
                IFS=$'\x1f' read -ra o <<<"${sel_opts[$j]}"
            fi
            for x in ${o[@]+"${o[@]}"}; do s+=" $x"; done
        else
            s="${sel_name[$j]}"
        fi
        out+="${out:+ }$s"
    done
    selection_str="$out"
}

gen_df() { # $1=kind $2=name $3=opts $4=index -> prints path (recipe stages only)
    local kind="$1" name="$2" opts_arg="$3" idx="$4"
    local out script err
    local -a oarr=()
    [[ -n "$opts_arg" ]] && IFS=$'\x1f' read -ra oarr <<<"$opts_arg"
    script="$(resolve_recipe "$name")"
    out="$(work_dir)/stage-$idx.df"
    if [[ "$quiet" == 1 ]]; then
        err="$(work_dir)/stage-$idx.err"
        if ! POD_PROJECT_DIR="$project_path" "$script" ${oarr[@]+"${oarr[@]}"} >"$out" 2>"$err"; then
            cat "$err" >&2
            rm -f "$err"
            die "recipe '$name' failed"
        fi
        rm -f "$err"
    else
        POD_PROJECT_DIR="$project_path" "$script" ${oarr[@]+"${oarr[@]}"} >"$out" \
            || die "recipe '$name' failed"
    fi
    [[ -s "$out" ]] || die "recipe '$name' printed no Dockerfile"
    printf '%s' "$out"
}

image_ref_for() { # bare selection token -> image reference
    local n="$1"
    if [[ "$n" == */* || "$n" == *:* ]]; then
        printf '%s' "$n"
    else
        printf 'localhost/pod-%s:%s' "$project_slug" "$n"
    fi
}

# ------------------------------------------------- recipe header parsing -----
df_header() { # $1=file $2=key -> prints values (one per line)
    sed -n -E "s/^# POD_${2}[[:space:]]+//p" "$1"
}

join_header() { # $1=file $2=key -> values joined with ", " (empty if none)
    local out="" l
    while IFS= read -r l; do
        [[ -n "$l" ]] && out+="${out:+, }$l"
    done < <(df_header "$1" "$2")
    printf '%s' "$out"
}

# create-time metadata gathered from every generated Dockerfile
v_ports=()
v_services=()
v_volumes=()
v_envs=()
v_hints=()
v_build_args=()
v_nametag=""

collect_meta() { # $1=df file
    local f="$1" line
    while IFS= read -r line; do [[ -n "$line" ]] && v_ports+=("$line"); done < <(df_header "$f" PORT)
    while IFS= read -r line; do [[ -n "$line" ]] && v_services+=("$line"); done < <(df_header "$f" SERVICE)
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        line="${line/#\~/$HOME}"   # ~/... in a host path binds from $HOME
        v_volumes+=("$line")
    done < <(df_header "$f" VOLUME)
    while IFS= read -r line; do [[ -n "$line" ]] && v_envs+=("$line"); done < <(df_header "$f" ENV)
    while IFS= read -r line; do [[ -n "$line" ]] && v_hints+=("$line"); done < <(df_header "$f" HINT)
    while IFS= read -r line; do [[ -n "$line" ]] && v_build_args+=("$line"); done < <(df_header "$f" BUILD_ARG)
    if [[ -z "$v_nametag" ]]; then
        line="$(df_header "$f" NAMETAG | head -n1)"
        if [[ -n "$line" ]]; then
            v_nametag="$(slugify "$line")"
        fi
    fi
}

normalize_ports() { # input specs in, docker -p specs out (127.0.0.1 default)
    local spec n
    for spec in "$@"; do
        n="$(awk -F: '{print NF}' <<<"$spec")"
        case "$n" in
            1) printf '127.0.0.1:%s:%s\n' "$spec" "$spec" ;;
            2) printf '127.0.0.1:%s\n' "$spec" ;;
            *) printf '%s\n' "$spec" ;;
        esac
    done
}

host_port() { # $1=port spec -> the host-side port
    local spec="$1" n
    local -a p=()
    n="$(awk -F: '{print NF}' <<<"$spec")"
    case "$n" in
        1) printf '%s' "$spec" ;;
        2) printf '%s' "${spec%%:*}" ;;
        *)
            IFS=: read -ra p <<<"$spec"
            printf '%s' "${p[$((${#p[@]} - 2))]}"
            ;;
    esac
}

# ------------------------------------------------------------------ build ---
log_rows() { # visual terminal rows $1 occupies (\r-rewritten lines count once)
    local cols
    cols="$(tput cols 2>/dev/null || true)"
    [[ -n "$cols" && "$cols" -gt 0 ]] || cols=80
    awk -v cols="$cols" '
        {
            m = 0
            n = split($0, a, "\r")
            for (i = 1; i <= n; i++) if (length(a[i]) > m) m = length(a[i])
            r = int((m + cols) / cols)
            if (r < 1) r = 1
            total += r
        }
        END { print total + 0 }
    ' "$1"
}

erase_rows() { # move up N rows and clear them (best effort: capped to the screen)
    local n="$1" max
    max="$(tput lines 2>/dev/null || true)"
    [[ -n "$max" && "$max" -gt 0 ]] || max=24
    max=$((max - 2))
    ((n > max)) && n="$max"
    ((n > 0)) || return 0
    printf '\033[%dA\033[0J' "$n" >&2
}

run_build() { # podman build with mode-aware output handling
    local t0=$SECONDS tag="" log rows i args=("$@")
    i=0
    while [[ $i -lt ${#args[@]} ]]; do
        case "${args[$i]}" in
            -t|--tag) i=$((i + 1)); tag="${args[$i]:-}" ;;
        esac
        i=$((i + 1))
    done

    if [[ "$quiet" == 1 ]]; then
        log="$(mktemp "${TMPDIR:-/tmp}/pod-build.XXXXXX")"
        if ! podman build "$@" >"$log" 2>&1; then
            cat "$log" >&2
            rm -f "$log"
            return 1
        fi
        rm -f "$log"
        return 0
    fi

    if [[ "$verbose" == 1 || ! -t 2 ]]; then
        # keep the log: verbose, or no TTY to erase it from
        if podman build "$@" >&2; then
            info "built ${tag:-image} in $((SECONDS - t0))s"
            return 0
        fi
        return 1
    fi

    # default TTY: stream live, erase on success, keep on failure
    log="$(mktemp "${TMPDIR:-/tmp}/pod-build.XXXXXX")"
    if podman build "$@" 2>&1 | tee "$log" >&2; then
        rows="$(log_rows "$log")"
        [[ -n "$(tail -c1 "$log" 2>/dev/null || true)" ]] && printf '\n' >&2
        erase_rows "$rows"
        rm -f "$log"
        info "built ${tag:-image} in $((SECONDS - t0))s"
        return 0
    fi
    rm -f "$log"
    return 1
}

plan_only=0       # 1 = compute the chain without building (pod info)
final_image=""
final_id=""
chain_lines=()

build_chain() {
    local i kind name opts df prev="" tag has_base a v kv h key
    local -a args nocache=()
    [[ "$rebuild" == 1 ]] && nocache=(--no-cache)

    v_ports=()
    v_services=()
    v_volumes=()
    v_envs=()
    v_hints=()
    v_build_args=()
    v_nametag=""
    chain_lines=()
    work_dir >/dev/null

    for i in "${!sel_kind[@]}"; do
        kind="${sel_kind[$i]}"
        name="${sel_name[$i]}"
        opts="${sel_opts[$i]}"

        if [[ "$kind" == "image" ]]; then
            prev="$(image_ref_for "$name")"
            if podman image exists "$prev" 2>/dev/null; then
                chain_lines+=("start FROM $prev")
            elif [[ "$plan_only" == 1 ]]; then
                chain_lines+=("start FROM $prev (not built locally)")
            else
                die "image not found: $prev (build it with: $TOOL build <selection>, or podman pull it)"
            fi
            debug "starting FROM $prev"
            continue
        fi

        df="$(gen_df "$kind" "$name" "$opts" "$i")"
        collect_meta "$df"

        has_base=0
        grep -qE '^ARG[[:space:]]+BASE([[:space:]=]|$)' "$df" && has_base=1
        args=()
        if [[ "$has_base" == 1 ]]; then
            if [[ -z "$prev" && "$plan_only" == 1 ]]; then
                chain_lines+=("start FROM $DEFAULT_BASE (default base; POD_DEFAULT_BASE overrides)")
            fi
            args+=(--build-arg "BASE=${prev:-$DEFAULT_BASE}")
        elif [[ -n "$prev" ]]; then
            die "recipe '$name' does not accept a base image (no ARG BASE), so it cannot be chained after another stage"
        fi

        # declared ARGs: --build-arg wins, else the host environment, else skip
        while IFS= read -r a; do
            [[ -n "$a" && "$a" != "BASE" ]] || continue
            v=""
            for kv in ${build_args_cli[@]+"${build_args_cli[@]}"}; do
                [[ "${kv%%=*}" == "$a" ]] && v="${kv#*=}"
            done
            [[ -n "$v" ]] || v="${!a:-}"
            [[ -n "$v" ]] && args+=(--build-arg "$a=$v")
        done < <(sed -n -E 's/^ARG[[:space:]]+([A-Za-z_][A-Za-z0-9_]*).*/\1/p' "$df" | sort -u)

        if [[ $((i + 1)) -eq ${#sel_kind[@]} ]]; then
            tag="localhost/pod-$project_slug:$dish"
        else
            key="$prev|${args[*]}|${build_args_cli[*]-}"
            h="$( { cat "$df"; printf '%s' "$key"; } | sha256sum | cut -c1-12)"
            tag="localhost/pod-$project_slug:i$((i + 1))-$h"
        fi

        chain_lines+=("recipe .$name${opts:+ ${opts//$'\x1f'/ }} -> $tag")

        if [[ "$plan_only" == 1 ]]; then
            prev="$tag"
            continue
        fi

        info "building $tag  (.$name${opts:+ ${opts//$'\x1f'/ }})"
        run_build "${nocache[@]}" \
            --label pod.cmd=1 --label "pod.project=$project_slug" \
            --label "pod.dish=$dish" --label "pod.selection=$selection_str" \
            ${args[@]+"${args[@]}"} -t "$tag" -f "$df" "$project_path" \
            || die "build failed: .$name (log above)"
        prev="$tag"
    done

    final_image="$prev"
    if [[ "$plan_only" == 1 ]]; then
        final_id=""
        debug "planned image: $final_image"
        return 0
    fi
    [[ -n "$final_image" ]] || die "selection produced no image"
    final_id="$(podman image inspect -f '{{.Id}}' "$final_image" 2>/dev/null | head -n1)"
    final_id="${final_id#sha256:}"
    [[ -n "$final_id" ]] || die "built image vanished: $final_image"
    debug "final image: $final_image ($final_id)"
}

# --------------------------------------------------------------- container ---
container_name() {
    local wslug candidate alt c_source c_dish
    wslug="$(slug_for_source)"
    candidate="pod-$wslug${v_nametag:+-$v_nametag}-$dish"
    if ! podman container exists "$candidate" 2>/dev/null; then
        debug "container name: $candidate (free)"
        printf '%s' "$candidate"
        return 0
    fi
    c_source="$(podman container inspect -f '{{index .Config.Labels "pod.source"}}' "$candidate" 2>/dev/null || true)"
    c_dish="$(podman container inspect -f '{{index .Config.Labels "pod.dish"}}' "$candidate" 2>/dev/null || true)"
    if [[ "$c_source" == "$source_path" && "$c_dish" == "$dish" ]]; then
        debug "container name: $candidate (labels match)"
        printf '%s' "$candidate"
        return 0
    fi
    alt="pod-$wslug-$(printf '%s' "$source_path" | sha1sum | cut -c1-6)${v_nametag:+-$v_nametag}-$dish"
    debug "container name: $candidate is taken by another workspace; trying $alt"
    if podman container exists "$alt" 2>/dev/null; then
        c_source="$(podman container inspect -f '{{index .Config.Labels "pod.source"}}' "$alt" 2>/dev/null || true)"
        c_dish="$(podman container inspect -f '{{index .Config.Labels "pod.dish"}}' "$alt" 2>/dev/null || true)"
        if [[ "$c_source" == "$source_path" && "$c_dish" == "$dish" ]]; then
            printf '%s' "$alt"
            return 0
        fi
        die "container name collision: $candidate and $alt belong to other workspaces (rename with --as)"
    fi
    printf '%s' "$alt"
}

create_container() { # $1=name
    local name="$1" p vol e svc sname scmd
    local -a run_args=(
        run -d
        --name "$name"
        --init
        --user 0
        --label pod.cmd=1
        --label "pod.project=$project_slug"
        --label "pod.path=$project_path"
        --label "pod.source=$source_path"
        --label "pod.dish=$dish"
        --label "pod.selection=$selection_str"
        --label "pod.image=$final_image"
        --label "pod.image-id=$final_id"
        --label "pod.created=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        --entrypoint /bin/sh
        -v "$source_path:/workspace:rw"
        -w /workspace
    )

    # recipe-declared metadata, kept as labels for info/service lookups
    [[ -n "$v_nametag" ]] && run_args+=(--label "pod.nametag=$v_nametag")
    local -a all_ports=("${v_ports[@]}" "${ports_cli[@]}")
    if [[ ${#all_ports[@]} -gt 0 ]]; then
        run_args+=(--label "pod.ports=$(join_by , "${all_ports[@]}")")
    fi
    if [[ ${#v_services[@]} -gt 0 ]]; then
        local -a snames=()
        for svc in "${v_services[@]}"; do
            snames+=("${svc%%=*}")
        done
        run_args+=(--label "pod.services=$(join_by , "${snames[@]}")")
        for svc in "${v_services[@]}"; do
            sname="${svc%%=*}"
            scmd="${svc#*=}"
            run_args+=(--label "pod.service.$sname=$scmd")
        done
    fi
    [[ ${#v_volumes[@]} -gt 0 ]] && run_args+=(--label "pod.volumes=$(printf '%s\n' "${v_volumes[@]}")")
    [[ ${#v_envs[@]} -gt 0 ]] && run_args+=(--label "pod.env=$(join_by , "${v_envs[@]}")")
    [[ ${#v_hints[@]} -gt 0 ]] && run_args+=(--label "pod.hints=$(printf '%s\n' "${v_hints[@]}")")

    local specs=()
    while IFS= read -r p; do
        [[ -n "$p" ]] && specs+=("$p")
    done < <(normalize_ports ${v_ports[@]+"${v_ports[@]}"} ${ports_cli[@]+"${ports_cli[@]}"})

    if [[ -n "$shared_pod" ]]; then
        # in a pod the netns is shared: add-host + ports must live on the pod
        if podman pod exists "$shared_pod" 2>/dev/null; then
            if [[ ${#specs[@]} -gt 0 ]]; then
                warn "pod $shared_pod already exists (its ports are fixed at creation); ${specs[*]} not published for $name"
            fi
        else
            local -a pod_args=(
                pod create --label pod.cmd=1 --label "pod.project=$project_slug"
                --add-host host.containers.internal:host-gateway
            )
            for p in ${specs[@]+"${specs[@]}"}; do
                pod_args+=(--publish "$p")
            done
            podman "${pod_args[@]}" "$shared_pod" >/dev/null \
                || die "pod create failed: $shared_pod"
        fi
        run_args+=(--pod "$shared_pod")
    else
        run_args+=(--add-host=host.containers.internal:host-gateway)
        for p in ${specs[@]+"${specs[@]}"}; do
            run_args+=(-p "$p")
        done
    fi

    # recipe-declared volumes: named volumes are created on demand
    for vol in ${v_volumes[@]+"${v_volumes[@]}"}; do
        local src="${vol%%:*}"
        if [[ "$src" != */* ]]; then
            podman volume exists "$src" 2>/dev/null || podman volume create "$src" >/dev/null
        fi
        run_args+=(-v "$vol")
    done

    # recipe-declared env: K=V literal, bare K passed through when set
    for e in ${v_envs[@]+"${v_envs[@]}"}; do
        if [[ "$e" == *=* ]]; then
            run_args+=(-e "$e")
        elif [[ -n "${!e:-}" ]]; then
            run_args+=(-e "$e")
        fi
    done

    info "creating container $name (image $final_image, workspace $source_path)"
    podman "${run_args[@]}" "$final_image" -c 'exec sleep infinity' >/dev/null \
        || die "container create failed"
    container="$name"
}

start_if_needed() { # $1=container
    if [[ "$(podman container inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" != "true" ]]; then
        info "starting $1"
        podman start "$1" >/dev/null
    fi
}

ensure_container() {
    local c_image c_vols want_vols
    container="$(container_name)"
    if podman container exists "$container" 2>/dev/null; then
        if [[ "$recreate" == 1 ]]; then
            info "recreating $container (--recreate)"
            podman rm -f "$container" >/dev/null
            create_container "$container"
            return 0
        fi
        c_image="$(podman container inspect -f '{{index .Config.Labels "pod.image-id"}}' "$container" 2>/dev/null || true)"
        if [[ "$c_image" != "$final_id" ]]; then
            info "image updated (${c_image:-none} -> $final_id): recreating $container"
            podman rm -f "$container" >/dev/null
            create_container "$container"
            return 0
        fi
        want_vols=""
        [[ ${#v_volumes[@]} -gt 0 ]] && want_vols="$(printf '%s\n' "${v_volumes[@]}")"
        c_vols="$(podman container inspect -f '{{index .Config.Labels "pod.volumes"}}' "$container" 2>/dev/null || true)"
        if [[ "$c_vols" != "$want_vols" ]]; then
            info "mounts changed: recreating $container"
            podman rm -f "$container" >/dev/null
            create_container "$container"
            return 0
        fi
        debug "reusing container $container"
        if [[ -n "$shared_pod" ]]; then
            local want have
            want="$(podman pod inspect "$shared_pod" --format '{{.Id}}' 2>/dev/null || true)"
            have="$(podman container inspect -f '{{.Pod}}' "$container" 2>/dev/null || true)"
            if [[ -n "$want" && "$have" != "$want" ]]; then
                warn "container $container is not in pod $shared_pod; remove it first to recreate there"
            fi
        fi
        start_if_needed "$container"
    else
        create_container "$container"
    fi
}

ensure_ready() { # selection parsed, project+source resolved
    build_chain
    ensure_container
    debug "container ready: $container"
}

resolve_container() { # $1=dish filter ("" = auto); prints name or "" (dies on ambiguity)
    local want="$1" m c_path c_dish
    local -a matches=() running=()
    while IFS= read -r m; do
        [[ -n "$m" ]] || continue
        c_path="$(podman container inspect -f '{{index .Config.Labels "pod.path"}}' "$m" 2>/dev/null || true)"
        [[ "$c_path" == "$project_path" ]] || continue
        if [[ -n "$want" ]]; then
            c_dish="$(podman container inspect -f '{{index .Config.Labels "pod.dish"}}' "$m" 2>/dev/null || true)"
            [[ "$c_dish" == "$want" ]] || continue
        fi
        matches+=("$m")
        if [[ "$(podman container inspect -f '{{.State.Running}}' "$m" 2>/dev/null)" == "true" ]]; then
            running+=("$m")
        fi
    done < <(podman container ls -a --filter label=pod.cmd=1 --filter label=pod.source --format '{{.Names}}')

    if [[ -n "$want" ]]; then
        if [[ ${#matches[@]} -gt 1 ]]; then
            printf '%s\n' "${matches[@]}" >&2
            die "several containers with dish '$want' for $project_path; pick the workspace: --src/--worktree"
        fi
        printf '%s' "${matches[0]:-}"
        return 0
    fi
    if [[ ${#running[@]} -gt 1 ]]; then
        printf '%s\n' "${running[@]}" >&2
        die "several containers are running for this project; pick one: $TOOL shell <dish>"
    elif [[ ${#running[@]} -eq 1 ]]; then
        printf '%s' "${running[0]}"
    elif [[ ${#matches[@]} -gt 1 ]]; then
        printf '%s\n' "${matches[@]}" >&2
        die "several containers for this project; pick one: $TOOL shell <dish>"
    else
        printf '%s' "${matches[0]:-}"
    fi
}

project_dishes() { # prints this project's dishes, comma separated
    local m d out=""
    while IFS= read -r m; do
        [[ -n "$m" ]] || continue
        d="$(podman container inspect -f '{{index .Config.Labels "pod.dish"}}' "$m" 2>/dev/null || true)"
        [[ -n "$d" ]] || continue
        case ", $out," in
            *", $d,"*) ;;
            *) out+="${out:+, }$d" ;;
        esac
    done < <(podman container ls -a --filter label=pod.cmd=1 --filter label=pod.path="$project_path" --format '{{.Names}}')
    printf '%s' "$out"
}

dishes_hint() { # " (dishes: a, b)" when known, empty otherwise
    local d
    d="$(project_dishes)"
    [[ -n "$d" ]] && printf ' (dishes: %s)' "$d"
    return 0
}

# --------------------------------------------------------------- services ---
service_cmd() { # $1=container $2=name -> prints cmd, fails when undeclared
    local v
    v="$(podman container inspect -f "{{index .Config.Labels \"pod.service.$2\"}}" "$1" 2>/dev/null || true)"
    [[ -n "$v" && "$v" != "<no value>" ]] || return 1
    printf '%s' "$v"
}

service_running() { # $1=container $2=first word of cmd (POSIX-sh safe)
    podman exec "$1" /bin/sh -c \
        'for p in /proc/[0-9]*/cmdline; do
             a=$(tr "\000" "\n" < "$p" 2>/dev/null | head -n1) || continue
             [ -z "$a" ] && continue
             case "$a" in "$1"|*/"$1") exit 0 ;; esac
         done
         exit 1' \
        sh "$2" 2>/dev/null
}

run_service() { # $1=container $2=name $3=cmd
    if service_running "$1" "${3%% *}"; then
        info "service '$2' already running in $1"
    elif [[ "$fg" == 1 ]]; then
        info "running '$2' in $1 (foreground)"
        podman exec -it "$1" /bin/sh -c "$3"
    else
        info "starting '$2' in $1: $3"
        podman exec -d "$1" /bin/sh -c "$3" >/dev/null
    fi
}

service_hint() { # $1=service name -> suggestion when no container exists
    local f n
    for f in "$RECIPES_DIR"/*; do
        [[ -f "$f" && -x "$f" ]] || continue
        if grep -q "# POD_SERVICE[[:space:]]$1=" "$f" 2>/dev/null; then
            n="$(basename "$f")"
            printf 'try: %s .base .%s' "$TOOL" "$n"
            return 0
        fi
    done
    printf 'no recipe declares a service named %s (see %s recipes)' "$1" "$TOOL"
}

containers_with_service() { # $1=project_path $2=service name; prints names
    local m p svcs
    while IFS= read -r m; do
        [[ -n "$m" ]] || continue
        p="$(podman container inspect -f '{{index .Config.Labels "pod.path"}}' "$m" 2>/dev/null || true)"
        [[ "$p" == "$1" ]] || continue
        svcs="$(podman container inspect -f '{{index .Config.Labels "pod.services"}}' "$m" 2>/dev/null || true)"
        case ", $svcs," in
            *", $2,"*) printf '%s\n' "$m" ;;
        esac
    done < <(podman container ls -a --filter label=pod.cmd=1 --filter label=pod.source --format '{{.Names}}')
}

subst_hint() { # $1=text $2=ports $3=dish $4=container
    local text="$1" ports="$2" host=""
    if [[ -n "$ports" ]]; then
        host="$(host_port "${ports%%,*}")"
    fi
    text="${text//\{port\}/$host}"
    text="${text//\{dish\}/$3}"
    text="${text//\{container\}/$4}"
    printf '%s' "$text"
}

print_hints() { # $1=container $2=optional service filter (stdout)
    local c="$1" filter="${2:-}" hints ports line hsvc
    hints="$(podman container inspect -f '{{index .Config.Labels "pod.hints"}}' "$c" 2>/dev/null || true)"
    [[ -n "$hints" ]] || return 0
    ports="$(podman container inspect -f '{{index .Config.Labels "pod.ports"}}' "$c" 2>/dev/null || true)"
    local dish_l
    dish_l="$(podman container inspect -f '{{index .Config.Labels "pod.dish"}}' "$c" 2>/dev/null || true)"
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        if [[ "$line" == "service="* ]]; then
            hsvc="${line#service=}"
            hsvc="${hsvc%% *}"
            line="${line#service="$hsvc"}"
            line="${line# }"
            if [[ -n "$filter" ]]; then
                [[ "$hsvc" == "$filter" ]] || continue
            else
                printf '[%s] ' "$hsvc"
            fi
        elif [[ -n "$filter" ]]; then
            continue
        fi
        subst_hint "$line" "$ports" "$dish_l" "$c"
        printf '\n'
    done <<<"$hints"
}

print_hints_plan() { # planned: no container yet (stdout)
    local ports line hsvc
    ports="$(join_by , ${v_ports[@]+"${v_ports[@]}"})"
    for line in ${v_hints[@]+"${v_hints[@]}"}; do
        if [[ "$line" == "service="* ]]; then
            hsvc="${line#service=}"
            hsvc="${hsvc%% *}"
            line="${line#service="$hsvc"}"
            line="${line# }"
            printf '[%s] ' "$hsvc"
        fi
        subst_hint "$line" "$ports" "$dish" "(not created yet)"
        printf '\n'
    done
}

# ---------------------------------------------------------------- commands ---
attach_shell() { # $1=container
    if [[ -t 0 && -t 1 ]]; then
        podman exec -it "$1" /bin/sh -c 'command -v bash >/dev/null 2>&1 && exec bash || exec sh'
    else
        info "container $1 is up; not a TTY -- run: $TOOL exec <cmd>"
        printf '%s\n' "$1"
    fi
}

cmd_run() {
    resolve_project
    parse_selection
    resolve_source
    ensure_ready
    info "container $container is up ($source_path -> /workspace)"
    print_hints "$container" >&2
    attach_shell "$container"
}

cmd_name() {
    resolve_project
    parse_selection
    resolve_source
    ensure_ready
    if [[ "$quiet" == 1 ]]; then
        printf '%s\n' "$container"
    else
        info "container $container is up"
        printf '%s\n' "$container"
    fi
}

cmd_build() {
    resolve_project
    parse_selection
    plan_only=0
    build_chain
    info "image ready: $final_image ($final_id)"
}

cmd_recipes() {
    local f n desc markstr ports snames sl bargs vols out
    printf 'RECIPES (%s):\n' "$RECIPES_DIR"
    printf 'use: pod .<name> [opts...] | pod .base .<name> | --as NAME\n\n'
    shopt -s nullglob
    local -a files=("$RECIPES_DIR"/*)
    shopt -u nullglob
    if [[ ${#files[@]} -eq 0 ]]; then
        printf '  (none)\n'
        return 0
    fi
    for f in "${files[@]}"; do
        [[ -f "$f" && -x "$f" ]] || continue
        n="$(basename "$f")"
        if ! out="$(POD_PROJECT_DIR="$PWD" "$f" 2>/dev/null)"; then
            printf '  %-10s %s\n' "$n" "${RED}✗ failed to run${NC}"
            continue
        fi
        desc="$(printf '%s\n' "$out" | sed -n -E 's/^# POD_DESC[[:space:]]+//p' | head -n1)"
        ports="$(printf '%s\n' "$out" | sed -n -E 's/^# POD_PORT[[:space:]]+//p' | paste -sd, -)"
        bargs="$(printf '%s\n' "$out" | sed -n -E 's/^# POD_BUILD_ARG[[:space:]]+//p' | paste -sd, -)"
        vols="$(printf '%s\n' "$out" | sed -n -E 's/^# POD_VOLUME[[:space:]]+//p' | paste -sd, -)"
        snames=""
        while IFS= read -r sl; do
            [[ -n "$sl" ]] && snames+="${snames:+, }${sl%%=*}"
        done < <(printf '%s\n' "$out" | sed -n -E 's/^# POD_SERVICE[[:space:]]+//p')

        markstr=""
        [[ -n "$ports" ]] && markstr+="port $ports  "
        [[ -n "$snames" ]] && markstr+="service $snames  "
        [[ -n "$vols" ]] && markstr+="volume $vols  "
        [[ -n "$bargs" ]] && markstr+="build-arg $bargs  "
        markstr="${markstr%  }"

        printf '  %-10s %s\n' "$n" "${markstr:+$markstr  }$desc"
    done
}

print_info_container() { # $1=container
    local c="$1" state dish_l sel_l img imgid ports svc vol env hints pub
    state="$(podman container inspect -f '{{.State.Status}}' "$c" 2>/dev/null || true)"
    dish_l="$(podman container inspect -f '{{index .Config.Labels "pod.dish"}}' "$c" 2>/dev/null || true)"
    sel_l="$(podman container inspect -f '{{index .Config.Labels "pod.selection"}}' "$c" 2>/dev/null || true)"
    img="$(podman container inspect -f '{{index .Config.Labels "pod.image"}}' "$c" 2>/dev/null || true)"
    imgid="$(podman container inspect -f '{{index .Config.Labels "pod.image-id"}}' "$c" 2>/dev/null || true)"
    ports="$(podman container inspect -f '{{index .Config.Labels "pod.ports"}}' "$c" 2>/dev/null || true)"
    svc="$(podman container inspect -f '{{index .Config.Labels "pod.services"}}' "$c" 2>/dev/null || true)"
    vol="$(podman container inspect -f '{{index .Config.Labels "pod.volumes"}}' "$c" 2>/dev/null || true)"
    env="$(podman container inspect -f '{{index .Config.Labels "pod.env"}}' "$c" 2>/dev/null || true)"
    hints="$(podman container inspect -f '{{index .Config.Labels "pod.hints"}}' "$c" 2>/dev/null || true)"
    pub="$(podman port "$c" 2>/dev/null | paste -sd'; ' - || true)"

    printf 'project:    %s\n' "$project_path"
    printf 'workspace:  %s -> /workspace\n' "$source_path"
    printf 'selection:  %s\n' "$sel_l"
    printf 'dish:       %s\n' "$dish_l"
    printf 'image:      %s (%s)\n' "$img" "${imgid:0:12}"
    printf 'container:  %s (%s)\n' "$c" "${state:-unknown}"
    printf 'ports:      %s\n' "${ports:-(none)}"
    [[ -n "$pub" ]] && printf 'published:  %s\n' "$pub"
    printf 'services:   %s\n' "${svc:-(none)}"
    [[ -n "$vol" ]] && printf 'volumes:    %s\n' "$(printf '%s' "$vol" | paste -sd'; ' -)"
    [[ -n "$env" ]] && printf 'env:        %s\n' "$env"
    if [[ -n "$hints" ]]; then
        printf 'hints:\n'
        local line hsvc
        while IFS= read -r line; do
            [[ -n "$line" ]] || continue
            if [[ "$line" == "service="* ]]; then
                hsvc="${line#service=}"
                hsvc="${hsvc%% *}"
                line="${line#service="$hsvc"}"
                line="${line# }"
                printf '  [%s] %s\n' "$hsvc" "$(subst_hint "$line" "$ports" "$dish_l" "$c")"
            else
                printf '  %s\n' "$(subst_hint "$line" "$ports" "$dish_l" "$c")"
            fi
        done <<<"$hints"
    fi
    # stale image?
    local live_id
    live_id="$(podman image inspect -f '{{.Id}}' "$img" 2>/dev/null | head -n1)"
    live_id="${live_id#sha256:}"
    if [[ -n "$live_id" && -n "$imgid" && "$live_id" != "$imgid" ]]; then
        printf 'note:       image changed since the container was created\n'
        printf '            (next %s run recreates it, or use --recreate)\n' "$TOOL"
    fi
}

print_info_plan() {
    local line svc_out="" s
    printf 'project:    %s\n' "$project_path"
    printf 'workspace:  %s -> /workspace\n' "$source_path"
    printf 'selection:  %s\n' "$selection_str"
    printf 'dish:       %s\n' "$dish"
    printf 'chain:\n'
    for line in ${chain_lines[@]+"${chain_lines[@]}"}; do
        printf '  %s\n' "$line"
    done
    printf 'image:      %s%s\n' "$final_image" \
        "$(podman image exists "$final_image" 2>/dev/null && printf ' (built)' || printf ' (not built yet)')"
    printf 'container:  none yet -- run: %s %s\n' "$TOOL" "$selection_str"
    printf 'ports:      %s\n' "$(join_by , ${v_ports[@]+"${v_ports[@]}"} ${ports_cli[@]+"${ports_cli[@]}"})"
    for s in ${v_services[@]+"${v_services[@]}"}; do
        svc_out+="${svc_out:+, }${s%%=*}"
    done
    printf 'services:   %s\n' "${svc_out:-(none)}"
    [[ ${#v_volumes[@]} -gt 0 ]] && printf 'volumes:    %s\n' "$(printf '%s\n' "${v_volumes[@]}" | paste -sd'; ' -)"
    [[ ${#v_envs[@]} -gt 0 ]] && printf 'env:        %s\n' "$(join_by , "${v_envs[@]}")"
    if [[ ${#v_hints[@]} -gt 0 ]]; then
        printf 'hints:\n'
        print_hints_plan | sed 's/^/  /'
    fi
}

cmd_info() {
    resolve_project
    resolve_source
    local tok0="${positional[0]:-}" c=""
    if [[ -z "$tok0" ]]; then
        c="$(resolve_container "")"
        [[ -n "$c" ]] || parse_selection      # no container: plan the default
    elif [[ "$tok0" == .* || ${#positional[@]} -gt 1 ]]; then
        parse_selection
        c="$(resolve_container "$dish")"      # its dish's container, if any
    else
        c="$(resolve_container "$tok0")"
        # no such dish: plan starting FROM that image instead
        [[ -n "$c" ]] || parse_selection
    fi
    if [[ -n "$c" ]]; then
        print_info_container "$c"
    else
        plan_only=1
        build_chain
        print_info_plan
    fi
}

cmd_services() {
    resolve_project
    resolve_source
    local c snames s out=""
    c="$(resolve_container "${positional[0]:-$dish_flag}")"
    if [[ -z "$c" ]]; then
        die "no container for $project_path yet$(dishes_hint); see '$TOOL recipes'"
    fi
    snames="$(podman container inspect -f '{{index .Config.Labels "pod.services"}}' "$c" 2>/dev/null || true)"
    if [[ -z "$snames" ]]; then
        info "no services declared by the recipes behind $c"
        return 0
    fi
    printf 'services in %s:\n' "$c"
    local -a names=()
    IFS=',' read -ra names <<<"$snames"
    for s in "${names[@]}"; do
        out="$(service_cmd "$c" "$s" || true)"
        printf '  %-14s %s\n' "$s" "${out:-?}"
    done
}

cmd_service() {
    local name="${positional[0]:-}" dish_sel="${positional[1]:-}"
    [[ -n "$name" ]] || die "usage: $TOOL service NAME [DISH] [--fg]"
    if [[ ${#positional[@]} -gt 2 ]]; then
        die "usage: $TOOL service NAME [DISH] [--fg]"
    fi
    resolve_project
    resolve_source
    local c cmd cand
    if [[ -n "$dish_sel" ]]; then
        c="$(resolve_container "$dish_sel")"
    else
        # prefer the container that actually declares this service
        cand="$(containers_with_service "$project_path" "$name")"
        if [[ -n "$cand" && "$cand" != *$'\n'* ]]; then
            c="$cand"
        else
            c="$(resolve_container "")"
        fi
    fi
    if [[ -z "$c" ]]; then
        die "no container for $project_path yet -- $(service_hint "$name")"
    fi
    start_if_needed "$c"
    cmd="$(service_cmd "$c" "$name")" \
        || die "container $c has no service '$name' (declared: $(podman container inspect -f '{{index .Config.Labels "pod.services"}}' "$c" 2>/dev/null || true); see '$TOOL info')"
    run_service "$c" "$name" "$cmd"
    print_hints "$c" "$name"
}

selection_in_positional() {
    local t
    for t in ${positional[@]+"${positional[@]}"}; do
        [[ "$t" == .* ]] && return 0
    done
    return 1
}

cmd_shell() {
    resolve_project
    local c=""
    if selection_in_positional; then
        parse_selection
        resolve_source
        ensure_ready
        attach_shell "$container"
        return 0
    fi
    if [[ ${#positional[@]} -gt 1 ]]; then
        die "usage: $TOOL shell [DISH|SELECTION...]"
    fi
    resolve_source
    c="$(resolve_container "${positional[0]:-$dish_flag}")"
    if [[ -z "$c" ]]; then
        parse_selection      # no container yet: build the default selection
        ensure_ready
        c="$container"
    else
        start_if_needed "$c"
    fi
    attach_shell "$c"
}

cmd_exec() {
    [[ ${#positional[@]} -gt 0 ]] || die "exec needs a command (pod exec CMD ...)"
    resolve_project
    resolve_source
    local c
    c="$(resolve_container "$dish_flag")"
    if [[ -z "$c" ]]; then
        parse_selection      # no container yet: build the default selection
        ensure_ready
        c="$container"
    else
        start_if_needed "$c"
    fi
    local -a args=()
    [[ -t 0 && -t 1 ]] && args+=(-t)
    local e
    for e in ${exec_env[@]+"${exec_env[@]}"}; do
        args+=(-e "$e")
    done
    local v
    for v in TERM COLORTERM LANG; do
        [[ -n "${!v:-}" ]] && args+=(-e "$v")
    done
    podman exec "${args[@]}" "$c" "${positional[@]}"
}

cmd_logs() {
    resolve_project
    resolve_source
    local c sel="${positional[0]:-$dish_flag}"
    c="$(resolve_container "$sel")"
    if [[ -z "$c" ]]; then
        die "no container for $project_path$(dishes_hint)"
    fi
    local -a args=(logs)
    [[ "$follow" == 1 ]] && args+=(-f)
    podman "${args[@]}" "$c"
}

cmd_ide() {
    resolve_project
    local c=""
    if selection_in_positional; then
        parse_selection
        resolve_source
        ensure_ready
        c="$container"
    else
        if [[ ${#positional[@]} -gt 1 ]]; then
            die "usage: $TOOL ide [--run] [DISH|SELECTION...]"
        fi
        resolve_source
        c="$(resolve_container "${positional[0]:-$dish_flag}")"
        if [[ -z "$c" ]]; then
            parse_selection
            ensure_ready
            c="$container"
        else
            start_if_needed "$c"
        fi
    fi
    local hex uri
    hex="$(printf '%s' "$c" | od -An -v -t x1 | tr -d ' \n')"
    uri="vscode-remote://attached-container+$hex/workspace"
    local sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
    local -a lines=(
        "export DOCKER_HOST=unix://$sock   # if the Dev Containers ext needs it"
        "code --folder-uri \"$uri\""
        "# or in VS Code: F1 -> \"Dev Containers: Attach to Running Container...\" -> $c"
    )
    if [[ "$run_flag" == 1 ]]; then
        command -v code >/dev/null 2>&1 || die "code (VS Code CLI) not found"
        DOCKER_HOST="unix://$sock" code --folder-uri "$uri"
    else
        printf '%s\n' "${lines[@]}"
        if command -v c.c >/dev/null 2>&1; then
            c.c "code --folder-uri \"$uri\"" && info "command copied to clipboard"
        fi
    fi
}

cmd_wt() {
    local name="${positional[0]:?usage: $TOOL wt NAME [SELECTION...]}"
    positional=("${positional[@]:1}")
    resolve_project
    parse_selection
    worktree="$name"
    resolve_source
    ensure_ready
    info "worktree container $container is up ($source_path)"
    print_hints "$container" >&2
    attach_shell "$container"
}

cmd_list() {
    local m
    printf '%-44s %-10s %-24s %-30s %s\n' "CONTAINER" "STATE" "DISH" "PROJECT" "WORKSPACE"
    while IFS= read -r m; do
        [[ -n "$m" ]] || continue
        local state path source dish ports
        state="$(podman container inspect -f '{{.State.Status}}' "$m")"
        path="$(podman container inspect -f '{{index .Config.Labels "pod.path"}}' "$m")"
        source="$(podman container inspect -f '{{index .Config.Labels "pod.source"}}' "$m")"
        dish="$(podman container inspect -f '{{index .Config.Labels "pod.dish"}}' "$m")"
        ports="$(podman port "$m" 2>/dev/null | paste -sd, - || true)"
        printf '%-44s %-10s %-24s %-30s %s\n' "$m" "$state" "$dish" "$(basename "$path")" "$source"
        if [[ -n "$ports" ]]; then
            printf '%44s ports: %s\n' "" "$ports"
        fi
    done < <(podman container ls -a --filter label=pod.cmd=1 --filter label=pod.source --format '{{.Names}}' | sort)
}

containers_for_project() { # $1=project_path; $2=optional dish; prints names
    local m c_path c_dish want="${2:-}"
    while IFS= read -r m; do
        [[ -n "$m" ]] || continue
        c_path="$(podman container inspect -f '{{index .Config.Labels "pod.path"}}' "$m" 2>/dev/null || true)"
        [[ "$c_path" == "$1" ]] || continue
        if [[ -n "$want" ]]; then
            c_dish="$(podman container inspect -f '{{index .Config.Labels "pod.dish"}}' "$m" 2>/dev/null || true)"
            [[ "$c_dish" == "$want" ]] || continue
        fi
        printf '%s\n' "$m"
    done < <(podman container ls -a --filter label=pod.cmd=1 --filter label=pod.source --format '{{.Names}}')
}

cmd_down() {
    local m n=0 list sel="${positional[0]:-$dish_flag}"
    if [[ ${#positional[@]} -gt 1 ]]; then
        die "usage: $TOOL down [DISH] | $TOOL down all"
    fi
    if [[ "$sel" == "all" && -n "$dish_flag" ]]; then
        die "usage: $TOOL down [DISH] | $TOOL down all"
    fi
    if [[ "$sel" == "all" ]]; then
        list="$(podman container ls -a --filter label=pod.cmd=1 --filter label=pod.source --format '{{.Names}}' | sort)"
    else
        resolve_project
        list="$(containers_for_project "$project_path" "$sel")"
    fi
    while IFS= read -r m; do
        [[ -n "$m" ]] || continue
        if [[ "$(podman container inspect -f '{{.State.Running}}' "$m")" == "true" ]]; then
            info "stopping $m"
            podman stop "$m" >/dev/null
        fi
        n=$((n + 1))
    done <<<"$list"
    if [[ "$n" == 0 ]]; then
        if [[ "${positional[0]:-}" == "all" ]]; then
            info "no dev containers to stop"
        else
            resolve_project
            info "nothing to stop for $project_path"
        fi
    fi
}

cmd_rm() {
    resolve_project
    local m n=0
    if [[ ${#positional[@]} -gt 1 ]]; then
        die "usage: $TOOL rm [DISH]"
    fi
    while IFS= read -r m; do
        [[ -n "$m" ]] || continue
        info "removing $m"
        podman rm -f "$m" >/dev/null
        n=$((n + 1))
    done < <(containers_for_project "$project_path" "${positional[0]:-$dish_flag}")
    if [[ "$n" == 0 ]]; then
        info "nothing to remove for $project_path"
    fi
}

cmd_prune() {
    local -a victims=()
    local m state
    while IFS= read -r m; do
        [[ -n "$m" ]] || continue
        state="$(podman container inspect -f '{{.State.Status}}' "$m")"
        if [[ "$state" != "running" ]]; then
            victims+=("$m")
        fi
    done < <(podman container ls -a --filter label=pod.cmd=1 --filter label=pod.source --format '{{.Names}}')

    if [[ ${#victims[@]} -gt 0 ]]; then
        if [[ "$dry_run" == 1 ]]; then
            printf 'would remove containers:\n'
            printf '  %s\n' "${victims[@]}"
        else
            for m in "${victims[@]}"; do
                info "pruning container $m"
                podman rm -f "$m" >/dev/null
            done
        fi
    else
        info "no stopped dev containers"
    fi

    if [[ "$images_flag" == 1 ]]; then
        local -a used=() imgs=() left=()
        local img id u hit removed
        while IFS= read -r m; do
            used+=("$(podman container inspect -f '{{.Image}}' "$m" 2>/dev/null || true)")
        done < <(podman container ls -a --filter label=pod.cmd=1 --filter label=pod.source --format '{{.Names}}')

        # stale buildah working containers (from interrupted builds) pin images
        local idset=" " ext ext_name
        while IFS= read -r img; do
            [[ -n "$img" ]] && idset+="${img%% *} "
        done < <(podman image ls --filter label=pod.cmd=1 --format '{{.ID}} {{.Repository}}:{{.Tag}}')
        while IFS=' ' read -r ext _ ext_name; do
            [[ -n "$ext" ]] || continue
            if [[ "$ext_name" == pod-*-working-container* ]] \
               || [[ "$idset" == *" ${ext_name%%-*} "* ]]; then
                if [[ "$dry_run" == 1 ]]; then
                    printf 'would remove stale build container: %s\n' "$ext_name"
                else
                    info "removing stale build container $ext_name"
                    podman rm -f "$ext" >/dev/null 2>&1 || true
                fi
            fi
        done < <(podman ps -a --external --format '{{.ID}} {{.Image}} {{.Names}}')

        # chains reference each other and freed images surface as new danglers:
        # re-list every round and stop once a round makes no progress
        while :; do
            imgs=()
            while IFS= read -r img; do
                [[ -n "$img" ]] || continue
            id="${img%% *}"
            id="${id#sha256:}"
            hit=0
            for u in "${used[@]}"; do
                u="${u#sha256:}"
                # inspect reports full 64-char ids, image ls 12-char prefixes
                [[ "${u:0:12}" == "${id:0:12}" ]] && hit=1
            done
                [[ "$hit" == 1 ]] && continue
                imgs+=("$img")
            done < <(podman image ls --filter label=pod.cmd=1 --format '{{.ID}} {{.Repository}}:{{.Tag}}')

            if [[ "$dry_run" == 1 ]]; then
                for img in ${imgs[@]+"${imgs[@]}"}; do
                    printf 'would remove image: %s (%s)\n' "${img#* }" "${img%% *}"
                done
                break
            fi

            [[ ${#imgs[@]} -gt 0 ]] || break
            removed=0
            left=()
            for img in "${imgs[@]}"; do
                if podman rmi "${img%% *}" >/dev/null 2>&1; then
                    info "pruned image ${img#* }"
                    removed=1
                else
                    left+=("$img")
                fi
            done
            [[ ${#left[@]} -eq 0 ]] && break
            if [[ "$removed" == 0 ]]; then
                for img in "${left[@]}"; do
                    warn "could not remove ${img#* }"
                done
                break
            fi
        done
    fi

    # empty managed pods (their infra container always exists: ignore it)
    local pod podid real
    while IFS= read -r pod; do
        [[ -n "$pod" ]] || continue
        podid="$(podman pod inspect "$pod" --format '{{.Id}}' 2>/dev/null || true)"
        [[ -n "$podid" ]] || continue
        real="$(podman container ls -a --filter label=pod.cmd=1 --filter label=pod.source \
                    --format '{{.Pod}}' | grep -cx "$podid" || true)"
        [[ "$real" == "0" ]] || continue
        if [[ "$dry_run" == 1 ]]; then
            printf 'would remove empty pod: %s\n' "$pod"
        else
            info "removing empty pod $pod"
            podman pod rm "$pod" >/dev/null 2>&1 || true
        fi
    done < <(podman pod ls --filter label=pod.cmd=1 --format '{{.Name}}' 2>/dev/null)
}

# ---------------------------------------------------------------- dispatch ---
case "$cmd" in
    run)            cmd_run ;;
    name)           cmd_name ;;
    build)          cmd_build ;;
    recipes|frags)  cmd_recipes ;;
    info)           cmd_info ;;
    services)       cmd_services ;;
    service)        cmd_service ;;
    shell)          cmd_shell ;;
    exec)           cmd_exec ;;
    logs)           cmd_logs ;;
    ide)            cmd_ide ;;
    wt)             cmd_wt ;;
    list|ps)        cmd_list ;;
    down)           cmd_down ;;
    rm)             cmd_rm ;;
    prune)          cmd_prune ;;
    help)           show_help ;;
    *)              die "unknown command: $cmd (see --help)" ;;
esac
