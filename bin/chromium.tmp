#!/bin/bash

if ! command -v chromium >/dev/null; then
    echo "Chromium is not installed or it's not in the PATH";
    exit 1;
fi

show_help() {
    cat <<'EOF'
Usage: chromium.tmp [--tor [PORT]] [-- URL...]

Launch Chromium with a temporary profile in incognito mode (deleted on exit).

Options:
  --tor [PORT]  Route traffic through a local Tor SOCKS5 proxy (default: 9050)
  -h, --help    Show this help message

All other arguments are passed directly to Chromium.
EOF
}

tor_cmds=()
case "${1:-}" in
    -h|--help) show_help; exit 0 ;;
	--tor|tor)
        if [ -z "$2" ]; then
            port="9050";
        else
            port="$2";
            shift;
        fi;
        # --host-resolver-rules='MAP * ~NOTFOUND , EXCLUDE 127.0.0.1'
		tor_cmds=(--proxy-server="socks5://127.0.0.1:$port")
		shift
		;;
esac

dir=$(mktemp -d)
echo "Chromium Config Directory: $dir"
chromium --incognito --no-first-run --user-data-dir="$dir" "${tor_cmds[@]}" "$@"
rm -rf "$dir"
echo "Chromium Config Directory $dir Deleted."