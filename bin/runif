#!/bin/sh

show_help() {
    cat <<'EOF'
Usage: runif COMMAND [ARGS...]

Run a command in an interactive shell only if it exists in PATH.

Options:
  -h, --help    Show this help message

If the command is found, it is launched via $SHELL -i -c.
Otherwise, an error message is printed and the script exits with code 1.
EOF
}

case "${1:-}" in
    -h|--help) show_help; exit 0 ;;
esac

cmd="$1"

if [ -z "$cmd" ]; then
    echo "Usage: runif COMMAND [ARGS...]" >&2
    echo "Run a command in an interactive shell only if it exists in PATH." >&2
    exit 1
fi

if command -v "$cmd" >/dev/null 2>&1; then
    if [ -n "$SHELL" ]; then
        eval "$SHELL" -i -c "$*"
    else
        eval "$@"
    fi
else
    echo "Command '$cmd' doesn't exist." >&2
    exit 1
fi
