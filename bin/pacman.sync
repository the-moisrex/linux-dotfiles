#!/bin/bash

action="$1"
host="$2"

function print_help {
    echo "Usage: $0 [to/from] [host]"
}

function syncto {
    scp -r /var/cache/pacman/pkg "$host":/var/cache/pacman/.
}

function syncfrom {
    scp -r "$host":/var/cache/pacman/pkg /var/cache/pacman/.
}

if [[ "$action" == "to" || "$action" == "from" ]]; then
    if [[ -z "$host" ]]; then
        echo "Error: '$action' requires a host." >&2
        print_help
        exit 1
    fi
    if ! command -v scp >/dev/null 2>&1; then
        echo "Error: 'scp' is required but not installed." >&2
        exit 1
    fi
fi

case $action in
    to)
        syncto
        ;;
    from)
        syncfrom
        ;;
    --help|-h|help)
        print_help
        echo
        echo "  Sync the pacman package cache (/var/cache/pacman/pkg) between"
        echo "  two systems over scp."
        echo
        echo "Commands:"
        echo "  to <host>           Send the local cache to <host>"
        echo "  from <host>         Fetch the cache from <host>"
        echo "  -h, --help          Show this help message"
        ;;
    *)
        echo "$action can only be 'to' or 'from'."
        print_help
        ;;
esac


