#!/bin/bash

if ! command -v vivaldi >/dev/null; then
    echo "Vivaldi is not installed or it's not in the PATH";
    exit 1;
fi

# Vivaldi-specific command line options
vivaldi_default_opts=(
    --no-remote
    --no-first-run
    --no-referrers
    --save-page-as-mhtml
    --no-default-browser-check
    --disable-sync
    --ignore-certificate-errors
    --disable-webrtc
    --disable-extensions
    --disable-first-run-ui
)

show_help() {
    cat <<'EOF'
Usage: vivaldi.tmp [--tor [PORT]] [-- URL...]

Launch Vivaldi with a temporary profile (deleted on exit).

Options:
  --tor [PORT]  Route traffic through a local Tor SOCKS5 proxy (default: 9050)
  -h, --help    Show this help message

All other arguments are passed directly to Vivaldi.
EOF
}

tor_cmds=()
case "${1:-}" in
    -h|--help) show_help; exit 0 ;;
	--tor|tor)
        if [ -z "$2" ]; then
            port="9050";
        else
            port="$2";
            shift;
        fi;
		tor_cmds=(--proxy-server="socks5://127.0.0.1:$port")
		shift
		;;
esac

dir=$(mktemp -d)
echo "Vivaldi Config Directory: $dir"

# Pre-seed Preferences to skip Vivaldi's onboarding/welcome page.
# vivaldi.startup.has_seen_welcome_page tells Vivaldi the welcome was already seen.
# vivaldi.startup.has_seen_feature must be >= "mail" (1) or Vivaldi resets the welcome
# page pref on major version upgrades (see vivaldi_profile_impl.cc PerformUpdates).
mkdir -p "$dir/Default"
cat > "$dir/Default/Preferences" <<'EOF'
{
  "browser": {
    "has_seen_welcome_page": true,
    "check_default_browser": false
  },
  "vivaldi": {
    "startup": {
      "has_seen_welcome_page": true,
      "has_seen_feature": 1
    }
  }
}
EOF

vivaldi "${vivaldi_default_opts[@]}" --user-data-dir="$dir" "${tor_cmds[@]}" "$@"
rm -rf "$dir"
echo "Vivaldi Config Directory $dir Deleted."
