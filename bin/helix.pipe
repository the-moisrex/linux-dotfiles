#!/usr/bin/env bash
#
# helix.pipe - Interactively edit text in Helix (hx) and stream the result to stdout.
#

set -eo pipefail

VERSION="1.0.0"
PROGRAM_NAME="$(basename "$0")"

# Print help message
show_help() {
  cat << EOF
Usage: $PROGRAM_NAME [OPTIONS] [HELIX_ARGS...]

Interactively edit text in Helix (hx) and pipe the resulting buffer directly to stdout.

Arguments & Options:
  -h, --help       Show this help message and exit.
  -v, --version    Show version information and exit.
  --               Treat all subsequent arguments as Helix arguments.
  [HELIX_ARGS...]  Any arguments or files to pass directly to Helix (hx).

How It Works:
  1. If standard input (stdin) is piped in, it is loaded into a temporary buffer.
  2. If an existing file is passed as an argument, it is opened directly.
  3. Helix's interactive TUI renders directly to /dev/tty so terminal pipes do not break.
  4. Upon saving and exiting (:w then :q / :wq), the content is written to stdout.
  5. If you exit without saving (:q!), the original buffer state is output.

Examples:
  # 1. Edit an empty buffer interactively and copy to clipboard:
  $PROGRAM_NAME | pbcopy    # macOS
  $PROGRAM_NAME | wl-copy   # Wayland
  $PROGRAM_NAME | xclip -selection clipboard  # X11

  # 2. Pipe JSON from curl, inspect/edit interactively, and pretty-print:
  curl -s https://api.github.com | $PROGRAM_NAME | jq .

  # 3. Edit an existing file interactively and pass output to another tool:
  $PROGRAM_NAME config.toml | taplo fmt -

  # 4. Use Helix in a downstream pipe chain:
  cat data.csv | $PROGRAM_NAME | tr ',' '\t' > output.tsv
EOF
}

# Print version
show_version() {
  echo "$PROGRAM_NAME version $VERSION"
}

# Ensure /dev/tty exists and is accessible
if [ ! -r /dev/tty ] || [ ! -w /dev/tty ]; then
  echo "Error: /dev/tty is not available. $PROGRAM_NAME requires an interactive terminal." >&2
  exit 1
fi

# Locate the Helix binary (check 'hx' first, fallback to 'helix')
HELIX_BIN=""
if command -v hx >/dev/null 2>&1; then
  HELIX_BIN="hx"
elif command -v helix >/dev/null 2>&1; then
  HELIX_BIN="helix"
else
  echo "Error: Neither 'hx' nor 'helix' command was found in PATH." >&2
  exit 1
fi

# Parse initial flags
HELIX_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      show_help
      exit 0
      ;;
    -v|--version)
      show_version
      exit 0
      ;;
    --)
      shift
      HELIX_ARGS+=("$@")
      break
      ;;
    *)
      HELIX_ARGS+=("$1")
      shift
      ;;
  esac
done

# Create a secure temporary file
TMP_FILE="$(mktemp "${TMPDIR:-/tmp}/helix-pipe.XXXXXX")" || {
  echo "Error: Failed to create temporary file." >&2
  exit 1
}

# Ensure temporary file is always deleted on exit or interrupt
cleanup() {
  local exit_code=$?
  rm -f "$TMP_FILE"
  exit "$exit_code"
}
trap cleanup EXIT INT TERM HUP

# If data was piped via stdin, write it into the temporary file
if [ ! -t 0 ]; then
  cat > "$TMP_FILE"
fi

# Launch Helix
# If no files were passed in HELIX_ARGS, target the temporary file
if [ ${#HELIX_ARGS[@]} -eq 0 ]; then
  "$HELIX_BIN" "$TMP_FILE" < /dev/tty > /dev/tty
else
  "$HELIX_BIN" "${HELIX_ARGS[@]}" < /dev/tty > /dev/tty
fi

HELIX_STATUS=$?

# If Helix exited with an error status, propagate the failure
if [ $HELIX_STATUS -ne 0 ]; then
  exit $HELIX_STATUS
fi

# Stream output to stdout
if [ ${#HELIX_ARGS[@]} -eq 0 ]; then
  cat "$TMP_FILE"
else
  # If a specific file was edited as the first non-flag arg, output that file,
  # otherwise output the temp file.
  TARGET_FILE=""
  for arg in "${HELIX_ARGS[@]}"; do
    if [[ "$arg" != -* ]] && [ -f "$arg" ]; then
      TARGET_FILE="$arg"
      break
    fi
  done

  if [ -n "$TARGET_FILE" ]; then
    cat "$TARGET_FILE"
  else
    cat "$TMP_FILE"
  fi
fi

