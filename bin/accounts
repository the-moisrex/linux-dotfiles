class HelpFormatter(argparse.RawDescriptionHelpFormatter):
    """Wrap prose normally, but leave indented example lines exactly as written."""

    def _fill_text(self, text, width, indent):
        lines = []
        for line in text.splitlines():
            if line.startswith("  ") or not line.strip():
                lines.append(line)
            else:
                lines.extend(textwrap.wrap(line, width) or [""])
        return "".join(indent + line + "\n" for line in lines)


def examples_epilog(rows):
    """``examples:`` block for one command, commands left-aligned."""
    width = max(len(command) for command, _ in rows)
    lines = [f"  {command:<{width}}  {comment}".rstrip() for command, comment in rows]
    return "examples:\n" + "\n".join(lines)


def set_help(parser, *parts):
    parser.formatter_class = HelpFormatter
    parser.epilog = "\n\n".join(part for part in parts if part)
    return parser


def build_parser():
    p = argparse.ArgumentParser(prog="accounts", description=MODEL)
    sub = p.add_subparsers(dest="command", metavar="COMMAND")

    add = sub.add_parser("add", help="capture a login into an account (or log in)")
    add.add_argument("site", help="site or URL, e.g. x.com")
    add.add_argument("label", help="account name, e.g. work")
    add.add_argument("--login", action="store_true",
                     help="log in instead of capturing (also used automatically)")
    add.add_argument("--url", default=None,
                     help="page to open (default https://SITE/)")
    add.add_argument("--keep-session", action="store_true",
                     help="log in without clearing the site's state first")
    add.add_argument("--keep-scratch", action="store_true",
                     help="keep the throwaway login profile on disk")
    add.add_argument("--notes", default="")
    add.add_argument("--site-override", default=None, metavar="DOMAIN")
    _add_profile_args(add)

    for name, help_text in (("install", "install an account into a profile"),
                            ("open", "install an account and open the browser")):
        sp = sub.add_parser(name, help=help_text)
        sp.add_argument("site")
        sp.add_argument("label")
        sp.add_argument("--merge", action="store_true",
                        help="keep cookies/localStorage not present in the bundle")
        sp.add_argument("--dry-run", action="store_true", help="show changes only")
        sp.add_argument("--strict", action="store_true",
                        help="fail when localStorage could not be applied")
        sp.add_argument("--dedicated", action="store_true",
                        help="create a dedicated accounts-LABEL profile and use it")
        sp.add_argument("--storage", choices=["auto", "cookies"], default="auto",
                        help="'cookies' skips localStorage entirely")
        sp.add_argument("--site-override", default=None, metavar="DOMAIN")
        _add_profile_args(sp)

    logout = sub.add_parser("logout", help="delete a site's state from a profile")
    logout.add_argument("site")
    logout.add_argument("--dry-run", action="store_true")
    logout.add_argument("--strict", action="store_true")
    logout.add_argument("--storage", choices=["auto", "cookies"], default="auto")
    logout.add_argument("--site-override", default=None, metavar="DOMAIN")
    _add_profile_args(logout)

    listing = sub.add_parser("list", help="list saved accounts")
    listing.add_argument("site", nargs="?", default=None)
    listing.add_argument("--site-override", default=None, metavar="DOMAIN")
    listing.add_argument("--json", action="store_true")

    show = sub.add_parser("show", help="inspect one account")
    show.add_argument("site")
    show.add_argument("label")
    show.add_argument("--reveal", action="store_true", help="print secret values")
    show.add_argument("--site-override", default=None, metavar="DOMAIN")
    show.add_argument("--json", action="store_true")

    profiles = sub.add_parser("profiles",
                              help="show which profile holds which account")
    profiles.add_argument("--json", action="store_true")

    diff = sub.add_parser("diff", help="compare an account with a profile")
    diff.add_argument("site")
    diff.add_argument("label")
    diff.add_argument("--site-override", default=None, metavar="DOMAIN")
    _add_profile_args(diff)

    forget = sub.add_parser("forget", help="delete a saved account")
    forget.add_argument("site")
    forget.add_argument("label")
    forget.add_argument("--site-override", default=None, metavar="DOMAIN")

    new_profile = sub.add_parser("new-profile",
                                 help="create a dedicated profile for an account")
    new_profile.add_argument("browser")
    new_profile.add_argument("label")
    new_profile.add_argument("--site", default=None)
    new_profile.add_argument("--json", action="store_true")

    undo = sub.add_parser("undo", help="restore the last write to a profile")
    _add_profile_args(undo)

    export = sub.add_parser("export", help="write an account bundle as JSON")
    export.add_argument("site")
    export.add_argument("label")
    export.add_argument("-o", "--output", default=None)
    export.add_argument("--site-override", default=None, metavar="DOMAIN")

    imp = sub.add_parser("import", help="read an account bundle from JSON")
    imp.add_argument("file")
    imp.add_argument("--site", default=None)
    imp.add_argument("--label", default=None)
    imp.add_argument("--site-override", default=None, metavar="DOMAIN")

    set_help(p, PROFILE_NOTE, examples_epilog(MAIN_EXAMPLES))
    for name, parser in sub.choices.items():
        rows = EXAMPLES.get(name)
        if rows:
            set_help(parser, examples_epilog(rows))
    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.command:
        parser.print_help(sys.stderr)
        return 2
    handlers = {
        "add": cmd_add,
        "install": cmd_install,
        "open": cmd_open,
        "logout": cmd_logout,
        "list": cmd_list,
        "show": cmd_show,
        "profiles": cmd_profiles,
        "diff": cmd_diff,
        "forget": cmd_forget,
        "new-profile": cmd_new_profile,
        "undo": cmd_undo,
        "export": cmd_export,
        "import": cmd_import,
    }
    try:
        return handlers[args.command](args) or 0
    except UsageError as exc:
        print(f"accounts: {exc}", file=sys.stderr)
        return 2
    except Refused as exc:
        print(f"accounts: {exc}", file=sys.stderr)
        return 1
    except AccountsError as exc:
        print(f"accounts: {exc}", file=sys.stderr)
        return 1
    except BrokenPipeError:
        return 0
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
