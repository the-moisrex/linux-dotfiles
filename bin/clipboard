#!/bin/bash

# Clipboard utility that works across Wayland/KDE/X11.

# Function to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Function to detect desktop environment
detect_desktop_environment() {
    if [[ -n "${KDE_SESSION_VERSION:-}" ]]; then
        echo "kde"
    elif [[ -n "${GNOME_DESKTOP_SESSION_ID:-}" ]] || [[ "${XDG_CURRENT_DESKTOP:-}" == *"GNOME"* ]] || [[ "${XDG_SESSION_DESKTOP:-}" == *"gnome"* ]]; then
        echo "gnome"
    elif [[ "${XDG_CURRENT_DESKTOP:-}" == *"SWAY"* ]] || [[ "${XDG_SESSION_DESKTOP:-}" == *"sway"* ]]; then
        echo "wayland"
    elif [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
        echo "wayland"
    else
        echo "x11"
    fi
}

desktop_env=$(detect_desktop_environment)

show_help() {
    cat <<'EOF'
Usage: clipboard COMMAND

Copy/paste across Wayland/KDE/X11 clipboard tools.

Commands:
  paste, --paste, p     Paste from clipboard to stdout
  copy, --copy, cp, c   Copy stdin to clipboard
  clear, --clear        Clear the clipboard
  history, --history    Show clipboard history (Klipper only)
  -h, --help            Show this help message

Examples:
  echo "hello" | clipboard copy     # Copy text to clipboard
  clipboard paste                    # Print clipboard contents
  echo "text" | c.c                  # Shorthand for copy (via c.c)
  c.p                                # Shorthand for paste (via c.p)

Supported backends:
  - Wayland: wl-copy, wl-paste
  - KDE: qdbus (klipper)
  - X11: xclip, xsel
EOF
}

do_paste() {
    # Try Wayland clipboard utilities first (works for GNOME on Wayland)
    if [[ "$desktop_env" == "wayland" ]] || [[ "$desktop_env" == "gnome" ]]; then
        if command_exists wl-paste; then
            timeout 2 wl-paste 2>/dev/null && return 0
            echo "wl-paste failed" >&2
        fi
    fi

    # Try KDE klipper
    if command_exists qdbus; then
        if qdbus org.kde.klipper >/dev/null 2>&1; then
            qdbus org.kde.klipper /klipper org.kde.klipper.klipper.getClipboardContents && return 0
        fi
    fi

    # Fallback to X11 clipboard utilities
    if command_exists xclip; then
        xclip -selection clipboard -o && return 0
    elif command_exists xsel; then
        xsel --clipboard --output && return 0
    fi

    echo "No supported clipboard utility found for pasting." >&2
    return 1
}

do_copy() {
    local content
    content="$(cat)"

    # Try Wayland clipboard utilities first
    if [[ "$desktop_env" == "wayland" ]] || [[ "$desktop_env" == "gnome" ]]; then
        if command_exists wl-copy; then
            local retries=3
            local delay=0.2
            local i
            for (( i=0; i<retries; i++ )); do
                if printf '%s' "$content" | timeout 2 wl-copy --type text/plain 2>/dev/null; then
                    return 0
                fi
                sleep "$delay"
            done
            echo "wl-copy failed after $retries attempts" >&2
        fi
    fi

    # Try X11 clipboard utilities
    if command_exists xclip; then
        printf '%s' "$content" | xclip -selection clipboard -i && return 0
    elif command_exists xsel; then
        printf '%s' "$content" | xsel --clipboard --input && return 0
    # Fallback to KDE klipper for copy (with workaround)
    elif command_exists qdbus; then
        if qdbus org.kde.klipper >/dev/null 2>&1; then
            printf '%s' "$content" | xargs -0 -I{} qdbus org.kde.klipper /klipper org.kde.klipper.klipper.setClipboardContents {} && return 0
        fi
    fi

    echo "No supported clipboard utility found for copying." >&2
    return 1
}

do_clear() {
    if [[ "$desktop_env" == "wayland" ]] || [[ "$desktop_env" == "gnome" ]]; then
        if command_exists wl-copy; then
            timeout 2 wl-copy --clear 2>/dev/null && return 0
            echo "wl-copy --clear failed" >&2
        fi
    fi

    if command_exists xclip; then
        echo -n "" | xclip -selection clipboard && return 0
    elif command_exists xsel; then
        xsel --clipboard --delete && return 0
    elif command_exists qdbus; then
        if qdbus org.kde.klipper >/dev/null 2>&1; then
            qdbus org.kde.klipper /klipper org.kde.klipper.klipper.clearClipboardHistory && return 0
        fi
    fi

    echo "No supported clipboard utility found for clearing." >&2
    return 1
}

do_history() {
    if command_exists qdbus; then
        if qdbus org.kde.klipper >/dev/null 2>&1; then
            qdbus org.kde.klipper /klipper org.kde.klipper.klipper.getClipboardHistoryMenu
            return 0
        fi
    fi
    echo "Clipboard history is only supported with klipper." >&2
    return 1
}

case "${1:-}" in
    -h|--help)
        show_help
        exit 0
    ;;
    paste|--paste|p|pst|-p|--p)
        do_paste
    ;;
    copy|--copy|cp|c|--c|--cp|-cp)
        do_copy
    ;;
    clear|--clear)
        do_clear
    ;;
    history|--history)
        do_history
    ;;
    *)
        echo "Usage: $0 {paste|copy|clear|history}" >&2
        exit 1
    ;;
esac

exit 0
