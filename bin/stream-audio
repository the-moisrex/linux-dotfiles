#!/bin/bash

# https://www.freedesktop.org/wiki/Software/PulseAudio/Documentation/User/Modules/

show_help() {
    echo "Usage: stream-audio [OPTIONS] <start|stop>"
    echo
    echo "  Stream the system audio over TCP using PulseAudio."
    echo
    echo "Commands:"
    echo "  start               Start streaming the audio"
    echo "  stop                Stop streaming"
    echo
    echo "Options:"
    echo "  -h, --help          Show this help message"
    echo "  -p, --port PORT     Port to stream on (default: 8000)"
    exit 0
}

PORT=8000
ACTION=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) show_help ;;
        -p|--port) PORT="$2"; shift 2 ;;
        start|stop) ACTION="$1"; shift ;;
        *) echo "Unknown option: $1" >&2; show_help ;;
    esac
done

case "$ACTION" in
  start)
    $0 stop 
    source=$(pactl list | grep "Monitor Source" | awk '{print $3}')
    pactl load-module module-simple-protocol-tcp channels=2 format=s16 source="$source" port="$PORT" record=true
    ;;
  stop)
    mods=$(pactl list 2>/dev/null | grep -E -B1 'module-simple-protocol-tcp' | grep -oE '^Module #[0-9]+' | grep -oE '[0-9]+' | sort -u || true)
    if [ -z "$mods" ]; then
        echo "No stream-audio module is currently loaded." >&2
        exit 0
    fi
    for m in $mods; do
        pactl unload-module "$m"
    done
    ;;
  *)
    echo "Error: specify 'start' or 'stop'" >&2
    show_help
    ;;
esac
