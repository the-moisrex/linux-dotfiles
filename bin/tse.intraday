#!/usr/bin/env python3
"""tse.intraday — intraday (per-minute) OHLCV bars for a TSETMC instrument.

TSETMC publishes no historical intraday aggregate: the finest source for a past
session is the per-trade tape (``Trade/GetTradeHistory``), which this tool
fetches (the CDN gzips it, so a busy day is ~0.5 MB on the wire) and aggregates
locally into N-minute OHLCV bars. The live session comes from the raw live tape
(``Trade/GetTrade``), so it aggregates the same way, with
``Trade/GetTradeIntraDay`` (native 2-minute bars) only as a fallback.

Consecutive bars with identical OHLC are collapsed — automatically, only once a
run grows past ``--collapse-threshold`` rows (a trailing ``bars`` column records
how many bars each row merged) — and the bar interval is chosen automatically to
keep the output within ``--max-rows``, the finest interval that still fits, so
the least data is lost. The daily حقیقی/حقوقی (individual/legal) breakdown —
share volume, rial value and trader counts — is attached per day; TSETMC does
not publish that per bar.

Every bar carries its own volume-weighted average price (``vwap_rial``, computed
from the tape) and every completed session its official daily row — قیمت پایانی,
last trade, first/low/high, trade/volume/value totals — so the tape can be read
against TSETMC's own numbers. قیمت پایانی is the day's VWAP capped by حجم مبنا,
not a closing-auction print: TSETMC publishes no auction detail, no per-minute
حقیقی/حقوقی and no per-instrument NAV history.

The same tape yields each session's structure: the high/low with their times,
the close's position inside the day's range (CLV), the share of volume at or
above the tape VWAP, the 5/15/30-minute opening ranges, the market-profile
value area (POC/VAH/VAL) and the largest prints by rial value. Today's static
price limits are printed too, so a locked session (صف) is recognizable.

``--depth`` adds the order book to every bar and ``--depth-ladder`` prints the
whole 5-level ladder. TSETMC publishes five levels and no more, and the per-day
level-update stream only after the close, so the live session shows just its
current snapshot.
"""

import argparse
import csv
import importlib.util
import io
import json
import os
import re
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from importlib.machinery import SourceFileLoader

HERE = os.path.dirname(os.path.abspath(__file__))
_loader = SourceFileLoader("tse", os.path.join(HERE, "tse"))
_spec = importlib.util.spec_from_loader("tse", _loader)
tse = importlib.util.module_from_spec(_spec)
_loader.exec_module(tse)
sys.modules.setdefault("tse", tse)

API = tse.TSETMC
MAX_BYTES = 64 * 1024 * 1024
INTERVAL_LADDER = (1, 2, 3, 5, 6, 10, 15, 30, 60)
DEFAULT_MAX_ROWS = 2000
DEFAULT_COLLAPSE_THRESHOLD = 120
LAG_WARN_MINUTES = 1
MAX_DAYS = 30
FETCH_WORKERS = 4
TRADING_WEEKDAYS = (5, 6, 0, 1, 2)  # Sat, Sun, Mon, Tue, Wed
BAR_COLUMNS = (
    "from",
    "to",
    "open_rial",
    "high_rial",
    "low_rial",
    "close_rial",
    "vwap_rial",
    "volume_shares",
    "trades",
)
COLLAPSED_BAR_COLUMNS = BAR_COLUMNS + ("bars",)
TICK_COLUMNS = ("time", "price_rial", "volume_shares", "trade_no", "canceled")
PROFILE_COLUMNS = ("price_rial", "volume_shares", "trades", "first_time", "last_time")
DEPTH_LEVELS = 5
DEPTH_CUTOFF = 123000  # 12:30:00; later book updates are post-close churn
DEPTH_COVER_SLACK_MINUTES = 15  # how far a stream may stop short of the close
DEPTH_COLUMNS = (
    "bid_rial",
    "bid_shares",
    "ask_rial",
    "ask_shares",
    "spread_rial",
    "bid_depth_shares",
    "ask_depth_shares",
    "depth_imbalance_pct",
)
LADDER_COLUMNS = (
    "time",
    "level",
    "bid_rial",
    "bid_shares",
    "bid_orders",
    "bid_cum_shares",
    "ask_rial",
    "ask_shares",
    "ask_orders",
    "ask_cum_shares",
)
FLOW_COLUMNS = (
    "buy_initiated_shares",
    "sell_initiated_shares",
    "net_shares",
    "cum_net_shares",
    "buy_pct",
)
SESSION_OPEN_RANGES = (5, 15, 30)  # minutes from the session's first trade
VALUE_AREA_SHARE = 0.70  # the classic 70% value area around the POC
# The extra sources a run can carry, their default, and what they cost. `auto`
# settles once the sessions are known: the index only exists live, and breadth
# costs ~175 KB per session so it is dropped past a handful of them.
EXTRA_NAMES = ("book", "orders", "opening", "stats", "index", "breadth", "flow")
EXTRA_DEFAULTS = {
    "book": True,
    "orders": True,
    "opening": True,
    "stats": True,
    "index": None,
    "breadth": None,
    "flow": False,
}
EXTRA_CATALOG = (
    ("book", "on", "end-of-session order book summary", "~440 KB per session"),
    ("orders", "on", "order counts and average order size in that summary", "free"),
    ("opening", "on", "the opening-auction book next to the close", "free"),
    ("stats", "on", "3-month averages vs the latest published session", "~1 KB once"),
    ("index", "auto", "live market index, breadth of the index and totals", "~0.3 KB, live only"),
    ("breadth", "auto", "whole-market advancers/decliners per session", "~175 KB per session"),
    ("flow", "off", "buy/sell-initiated volume (tape x book estimate)", "free"),
)
BREADTH_AUTO_MAX_DAYS = 5


def minute_of(hhmmss):
    """An HHMMSS int -> minutes since midnight."""
    return (hhmmss // 10000) * 60 + (hhmmss // 100) % 100


def fmt_minute(minute):
    return f"{minute // 60:02d}:{minute % 60:02d}"


def minute_hhmmss(minute):
    """Minutes since midnight -> the HHMMSS of that minute's last second."""
    return (minute // 60) * 10000 + (minute % 60) * 100 + 59


def text_hhmmss(text):
    """A rendered ``HH:MM`` row boundary -> the same HHMMSS boundary."""
    hour, minute = text.split(":")
    return int(hour) * 10000 + int(minute) * 100 + 59


def payload_rows(payload, key):
    if isinstance(payload, list):
        return payload
    if isinstance(payload, dict):
        rows = payload.get(key)
        if isinstance(rows, list):
            return rows
        if len(payload) == 1:
            only = next(iter(payload.values()))
            if isinstance(only, list):
                return only
    return []


def parse_jalali(parser, text, label):
    """A Jalali date argument -> zero-padded (jalali, gregorian_compact)."""
    match = re.fullmatch(r"(\d{4})[/\-.](\d{1,2})[/\-.](\d{1,2})", tse.normal(text))
    if not match:
        parser.error(f"{label}: invalid Jalali date {text!r} (expected YYYY/MM/DD)")
    year, month, day = (int(part) for part in match.groups())
    if not 1 <= month <= 12 or not 1 <= day <= 31:
        parser.error(f"{label}: invalid Jalali date {text!r}")
    gy, gm, gd = tse.jalali_to_gregorian(year, month, day)
    return f"{year:04d}/{month:02d}/{day:02d}", f"{gy:04d}{gm:02d}{gd:02d}"


# --- fetching -------------------------------------------------------------


def official_from_row(row):
    """TSETMC's official daily row for one session.

    ``pClosing`` is قیمت پایانی — the day's volume-weighted average price capped
    by حجم مبنا — and ``pDrCotVal`` the last continuous trade; ``hEven`` is the
    timestamp TSETMC stamps that close with (a few seconds past the tape's last
    trade, because no closing-auction print is ever published in the tape).
    ``priceChange`` compares the last trade with the previous close.
    """
    if not isinstance(row, dict):
        return None
    last_price = tse.price(tse.pick(row, "pDrCotVal"))
    yesterday = tse.price(tse.pick(row, "priceYesterday"))
    official = {
        "close": tse.price(tse.pick(row, "pClosing")),
        "last_price": last_price,
        "first": tse.price(tse.pick(row, "priceFirst")),
        "low": tse.price(tse.pick(row, "priceMin")),
        "high": tse.price(tse.pick(row, "priceMax")),
        "yesterday": yesterday,
        "change": last_price - yesterday
        if last_price is not None and yesterday is not None
        else tse.value(row, "priceChange"),
        "close_time": tse.trade_time(tse.pick(row, "hEven")),
        "trades": tse.value(row, "zTotTran"),
        "volume": tse.value(row, "qTotTran5J"),
        "value_rial": tse.value(row, "qTotCap"),
    }
    return official if any(item is not None for item in official.values()) else None


def fetch_sessions(client, code):
    """Every trading session, oldest first, with its official daily aggregates.

    ``zTotTran``/``qTotTran5J`` are TSETMC's own trade count and volume for the
    day; they validate the tick tape (which sometimes carries duplicate rows).
    The same rows carry the official daily figures, so no extra request is
    needed to report them.
    """
    rows = client.api(
        f"ClosingPrice/GetClosingPriceDailyList/{code}/0", "closingPriceDaily"
    )
    sessions = {}
    for row in rows or []:
        if not isinstance(row, dict):
            continue
        greg = tse.normal(tse.pick(row, "dEven"))
        if re.fullmatch(r"\d{8}", greg):
            sessions[greg] = {
                "jalali": tse.trade_date(greg),
                "trades": tse.value(row, "zTotTran"),
                "volume": tse.value(row, "qTotTran5J"),
                "official": official_from_row(row),
            }
    return [{"greg": greg, **sessions[greg]} for greg in sorted(sessions)]


def fetch_ticks(client, code, greg, retries=6):
    """Every trade for one session; retries while the endpoint flakily returns empty."""
    url = f"{API}/Trade/GetTradeHistory/{code}/{greg}/false"
    for attempt in range(retries):
        payload = None
        try:
            payload = client.json(url, max_bytes=MAX_BYTES)
        except tse.DataError:
            payload = None
        rows = payload_rows(payload, "tradeHistory")
        if rows:
            return rows
        if attempt < retries - 1:
            time.sleep(1.5 * (attempt + 1))
    return []


def fetch_live_ticks(client, code):
    """Today's live tape (``Trade/GetTrade``), empty when the session has none.

    A live tape can never contain trades later than the wall clock, so a feed
    whose last trade time is in the future is a stale previous-session snapshot
    (TSETMC serves one before the open) and is treated as "no data yet".
    """
    payload = client.json(f"{API}/Trade/GetTrade/{code}", max_bytes=MAX_BYTES)
    rows = payload_rows(payload, "trade")
    now = tse.tehran_now()
    clock = now.hour * 10000 + now.minute * 100 + now.second
    if clock < 80000:
        return []
    last = 0
    for row in rows:
        if isinstance(row, dict):
            raw = tse.normal(tse.pick(row, "hEven"))
            if re.fullmatch(r"\d{1,6}", raw or ""):
                last = max(last, int(raw))
    if rows and last > clock + 300:
        return []
    return rows


def dedup_ticks(rows, include_canceled):
    """Drop canceled rows (unless kept) and repeated trade numbers.

    ``GetTradeHistory``/``GetTrade`` occasionally repeat a handful of ``nTran``
    rows at replica boundaries, inflating the trade count and volume; keeping one
    row per trade number makes every session match TSETMC's daily aggregate.
    """
    seen = set()
    kept = []
    for row in rows:
        if not isinstance(row, dict):
            continue
        if not include_canceled and tse.value(row, "canceled"):
            continue
        key = tse.normal(tse.pick(row, "nTran"))
        if key:
            if key in seen:
                continue
            seen.add(key)
        kept.append(row)
    return kept


def fetch_live_bars(client, code):
    """The live session's native 2-minute OHLCV bars."""
    payload = client.json(f"{API}/Trade/GetTradeIntraDay/{code}")
    bars = []
    for row in payload_rows(payload, "tradeIntraDay"):
        if not isinstance(row, dict):
            continue
        raw = tse.normal(tse.pick(row, "hEven"))
        if not re.fullmatch(r"\d{1,6}", raw or ""):
            continue
        bars.append(
            {
                "minute": minute_of(int(raw)),
                "open": tse.price(tse.pick(row, "openPrice")),
                "high": tse.price(tse.pick(row, "maxPrice")),
                "low": tse.price(tse.pick(row, "minPrice")),
                "close": tse.price(tse.pick(row, "closePrice")),
                "volume": tse.value(row, "volume") or 0,
                "trades": None,
                "turnover": None,  # TSETMC's native bars publish no turnover
            }
        )
    bars.sort(key=lambda bar: bar["minute"])
    return bars


def fetch_live_quote(client, code):
    """The real-time quote, which stays current while the live tape lags.

    ``GetTrade`` is served from CDN replicas that can sit minutes behind the
    exchange, so its last row is not "now"; ``ClosingPriceInfo`` is refreshed to
    the second and carries the running totals, so it anchors the live session.
    """
    info = client.api(f"ClosingPrice/GetClosingPriceInfo/{code}", "closingPriceInfo")
    if not isinstance(info, dict):
        return None
    raw = tse.normal(tse.pick(info, "lastHEven"))
    minute = minute_of(int(raw)) if re.fullmatch(r"\d{1,6}", raw or "") else None
    if not minute:
        return None
    last_price = tse.price(tse.pick(info, "pDrCotVal"))
    yesterday = tse.price(tse.pick(info, "priceYesterday"))
    return {
        "minute": minute,
        "time": fmt_minute(minute),
        "last_price": last_price,
        "trades": tse.value(info, "zTotTran"),
        "volume": tse.value(info, "qTotTran5J"),
        "first": tse.price(tse.pick(info, "priceFirst")),
        "low": tse.price(tse.pick(info, "priceMin")),
        "high": tse.price(tse.pick(info, "priceMax")),
        "vwap": tse.price(tse.pick(info, "pClosing")),
        "change": last_price - yesterday
        if last_price is not None and yesterday is not None
        else tse.value(info, "priceChange"),
        "yesterday": yesterday,
        "value_rial": tse.value(info, "qTotCap"),
    }


# --- order book -----------------------------------------------------------


def book_update(row):
    """One ``BestLimits`` row -> a normalized level update, or None."""
    level = tse.value(row, "number")
    if level is None or not 1 <= level <= DEPTH_LEVELS:
        return None
    hhmmss = tse.value(row, "hEven")
    return {
        "level": int(level),
        "hhmmss": int(hhmmss) if hhmmss is not None else None,
        "bid_rial": tse.price(tse.pick(row, "pMeDem")),
        "bid_shares": tse.value(row, "qTitMeDem"),
        "bid_orders": tse.value(row, "zOrdMeDem"),
        "ask_rial": tse.price(tse.pick(row, "pMeOf")),
        "ask_shares": tse.value(row, "qTitMeOf"),
        "ask_orders": tse.value(row, "zOrdMeOf"),
    }


def fetch_book_stream(client, code, greg, retries=4):
    """One completed session's 5-level book updates, ascending.

    TSETMC publishes the live day's stream only after the close and keeps
    roughly two months of history, so anything outside that returns no rows.
    Updates after 12:30 are dropped: the exchange keeps replacing levels
    individually after the close, so a later "book" mixes stale levels.
    """
    url = f"{API}/BestLimits/{code}/{greg}"
    for attempt in range(retries):
        try:
            payload = client.json(url, max_bytes=MAX_BYTES)
        except tse.DataError:
            payload = None
        updates = []
        for row in payload_rows(payload, "bestLimitsHistory"):
            update = book_update(row) if isinstance(row, dict) else None
            if update and update["hhmmss"] is not None:
                if update["hhmmss"] <= DEPTH_CUTOFF:
                    updates.append(update)
        if updates:
            updates.sort(key=lambda update: (update["hhmmss"], update["level"]))
            return updates
        if attempt < retries - 1:
            time.sleep(1.5 * (attempt + 1))
    return []


def fetch_live_book(client, code):
    """The current 5-level book — the live session's only depth source."""
    payload = client.json(f"{API}/BestLimits/{code}", max_bytes=MAX_BYTES)
    updates = []
    for row in payload_rows(payload, "bestLimits"):
        update = book_update(row) if isinstance(row, dict) else None
        if update:
            updates.append(update)
    updates.sort(key=lambda update: update["level"])
    return updates


def advance_book(updates, cursor, state, hhmmss):
    """Advance a running book to ``hhmmss``, returning the new cursor.

    The stream holds per-level deltas, so the book at a time is the last
    update received for each level; one ascending pass serves every row.
    """
    while cursor < len(updates) and updates[cursor]["hhmmss"] <= hhmmss:
        update = updates[cursor]
        state[update["level"]] = update
        cursor += 1
    return cursor


def depth_snapshot(state):
    """The depth columns for one book state (level -> update)."""
    ordered = [state[key] for key in sorted(state)]
    if not ordered:
        return {}
    best = ordered[0]
    bid_depth = sum(item["bid_shares"] or 0 for item in ordered)
    ask_depth = sum(item["ask_shares"] or 0 for item in ordered)
    total = bid_depth + ask_depth
    bid_rial, ask_rial = best["bid_rial"], best["ask_rial"]
    return {
        "bid_rial": bid_rial,
        "bid_shares": best["bid_shares"],
        "bid_orders": best["bid_orders"],
        "ask_rial": ask_rial,
        "ask_shares": best["ask_shares"],
        "ask_orders": best["ask_orders"],
        "spread_rial": ask_rial - bid_rial
        if ask_rial is not None and bid_rial is not None
        else None,
        "bid_depth_shares": bid_depth,
        "ask_depth_shares": ask_depth,
        "depth_imbalance_pct": round((bid_depth - ask_depth) / total * 100, 1)
        if total
        else None,
    }


def depth_summary(updates, hhmmss=None):
    """The end-of-row book snapshot; ``hhmmss`` None means the live snapshot."""
    state = {}
    if hhmmss is None:
        for update in updates:
            state[update["level"]] = update
    else:
        advance_book(updates, 0, state, hhmmss)
    snapshot = depth_snapshot(state)
    if not snapshot:
        return None
    snapshot["time"] = fmt_minute(minute_of(hhmmss)) if hhmmss is not None else None
    return snapshot


def row_boundaries(rows, interval, last_minute):
    """Each row's last covered second, clamped to the session's last trade.

    A merged row is labelled with its bucket start, so its real end is
    ``to + interval - 1``; the final row is clamped so a halted session is not
    sampled against book updates that happened after its last trade.
    """
    span = max(0, interval - 1)
    for row in rows:
        minute = minute_of(text_hhmmss(row["to"])) + span
        if last_minute is not None:
            minute = min(minute, last_minute)
        yield minute


def attach_depth(rows, updates, interval=1, last_minute=None):
    """Add the depth columns, sampled at the end of each row's span."""
    if not updates or not rows:
        return
    state = {}
    cursor = 0
    for row, minute in zip(rows, row_boundaries(rows, interval, last_minute)):
        cursor = advance_book(updates, cursor, state, minute_hhmmss(minute))
        row.update(depth_snapshot(state))


def ladder_block(state, time_label):
    """One rendered 5-level ladder block, with running cumulative depth."""
    rows = []
    bid_cum = 0
    ask_cum = 0
    for level in sorted(state):
        item = state[level]
        bid_cum += item["bid_shares"] or 0
        ask_cum += item["ask_shares"] or 0
        rows.append(
            {
                "time": time_label,
                "level": level,
                "bid_rial": item["bid_rial"],
                "bid_shares": item["bid_shares"],
                "bid_orders": item["bid_orders"],
                "bid_cum_shares": bid_cum,
                "ask_rial": item["ask_rial"],
                "ask_shares": item["ask_shares"],
                "ask_orders": item["ask_orders"],
                "ask_cum_shares": ask_cum,
            }
        )
    return rows


def ladder_rows(rows, updates, interval=1, last_minute=None):
    """A flat ladder at the end of every row's span."""
    ladder = []
    state = {}
    cursor = 0
    for _row, minute in zip(rows, row_boundaries(rows, interval, last_minute)):
        cursor = advance_book(updates, cursor, state, minute_hhmmss(minute))
        ladder.extend(ladder_block(state, fmt_minute(minute)))
    return ladder


# --- aggregation ----------------------------------------------------------


def tick_samples(rows, include_canceled):
    """Deduplicated trades as ``(seconds, trade_no, price_rial, shares)``.

    One normalised, time-ordered pass over the tape feeds every consumer (bars,
    the price profile, flow classification and the session summary) instead of
    each re-deduplicating and re-sorting the raw rows.
    """
    samples = []
    for row in dedup_ticks(rows, include_canceled):
        raw = tse.normal(tse.pick(row, "hEven"))
        if not re.fullmatch(r"\d{1,6}", raw or ""):
            continue
        samples.append(
            (
                int(raw),
                tse.value(row, "nTran") or 0,
                tse.price(tse.pick(row, "pTran")),
                tse.value(row, "qTitTran") or 0,
            )
        )
    samples.sort(key=lambda sample: (sample[0], sample[1]))
    return samples


def samples_to_bars(samples):
    """Trade samples -> 1-minute OHLCV bars."""
    bars = {}
    for secs, _trade_no, price, volume in samples:
        minute = minute_of(secs)
        bar = bars.get(minute)
        if bar is None:
            bar = {
                "minute": minute,
                "open": price,
                "high": price,
                "low": price,
                "close": price,
                "volume": 0,
                "trades": 0,
                "turnover": 0,
            }
            bars[minute] = bar
        if price is not None:
            bar["high"] = price if bar["high"] is None else max(bar["high"], price)
            bar["low"] = price if bar["low"] is None else min(bar["low"], price)
            bar["close"] = price
            if bar["open"] is None:
                bar["open"] = price
        bar["volume"] += volume
        bar["turnover"] += (price or 0) * volume
        bar["trades"] += 1
    return [bars[minute] for minute in sorted(bars)]


def merge_turnover(total, extra):
    """Accumulate trade turnover, or None when either side has none."""
    if total is None or extra is None:
        return None
    return total + extra


def bar_vwap(bar):
    """A bar's volume-weighted average price, or None without turnover data."""
    turnover, volume = bar.get("turnover"), bar.get("volume")
    if turnover is None or not volume:
        return None
    return round(turnover / volume)


def session_vwap(bars):
    """The tape's own volume-weighted average price for a whole session."""
    volume = 0
    turnover = 0
    for bar in bars:
        if bar.get("turnover") is None:
            return None
        volume += bar.get("volume") or 0
        turnover += bar["turnover"]
    return round(turnover / volume) if volume else None


def merge_bars(bars, interval):
    """Merge ordered bars up to ``interval`` minutes (interval 1 returns them as-is)."""
    if interval <= 1:
        return list(bars)
    merged = {}
    for bar in bars:
        key = (bar["minute"] // interval) * interval
        target = merged.get(key)
        if target is None:
            merged[key] = dict(bar, minute=key)
            continue
        if bar["high"] is not None:
            target["high"] = (
                bar["high"] if target["high"] is None else max(target["high"], bar["high"])
            )
        if bar["low"] is not None:
            target["low"] = (
                bar["low"] if target["low"] is None else min(target["low"], bar["low"])
            )
        if bar["close"] is not None:
            target["close"] = bar["close"]
        target["volume"] = (target["volume"] or 0) + (bar["volume"] or 0)
        target["turnover"] = merge_turnover(
            target.get("turnover"), bar.get("turnover")
        )
        if bar["trades"] is not None:
            target["trades"] = (target["trades"] or 0) + bar["trades"]
    return [merged[key] for key in sorted(merged)]


def collapse_bars(bars):
    """Merge consecutive bars whose OHLC is identical into one ``from``-``to`` row.

    Each merged row records ``count`` — how many bars it swallowed — so the
    output can show that a row is a collapsed run, not a single bar.
    """
    collapsed = []
    for bar in bars:
        if collapsed:
            previous = collapsed[-1]
            if previous["ohlc"] == (bar["open"], bar["high"], bar["low"], bar["close"]):
                previous["to"] = bar["minute"]
                previous["volume"] += bar["volume"] or 0
                previous["turnover"] = merge_turnover(
                    previous["turnover"], bar.get("turnover")
                )
                previous["count"] += 1
                if previous["trades"] is not None:
                    previous["trades"] += bar["trades"] or 0
                continue
        collapsed.append(
            {
                "from": bar["minute"],
                "to": bar["minute"],
                "open": bar["open"],
                "high": bar["high"],
                "low": bar["low"],
                "close": bar["close"],
                "volume": bar["volume"] or 0,
                "trades": bar["trades"],
                "turnover": bar.get("turnover"),
                "ohlc": (bar["open"], bar["high"], bar["low"], bar["close"]),
                "count": 1,
            }
        )
    return collapsed


def choose_interval(day_bars, max_rows, collapse):
    """The finest ladder interval whose (collapsed) row count fits the budget."""
    for interval in INTERVAL_LADDER:
        total = 0
        for bars in day_bars:
            merged = merge_bars(bars, interval)
            total += len(collapse_bars(merged)) if collapse else len(merged)
        if total <= max_rows:
            return interval
    return INTERVAL_LADDER[-1]


def profile_rows(samples):
    """Trade samples -> a price-level volume profile."""
    agg = {}
    for secs, _trade_no, price, volume in samples:
        if price is None:
            continue
        record = agg.get(price)
        if record is None:
            agg[price] = {
                "price": price,
                "volume": volume,
                "trades": 1,
                "first": secs,
                "last": secs,
            }
            continue
        record["volume"] += volume
        record["trades"] += 1
        record["first"] = min(record["first"], secs)
        record["last"] = max(record["last"], secs)
    return [agg[price] for price in sorted(agg)]


def value_area(levels, share=VALUE_AREA_SHARE):
    """The point of control and the narrowest band around it holding ``share``.

    ``levels`` maps price -> traded shares. Starting at the POC, the band grows
    outward one price level at a time, always absorbing the heavier neighbour,
    until it covers the requested share of the volume — the standard market
    profile value area.
    """
    if not levels:
        return None
    prices = sorted(levels)
    total = sum(levels.values())
    if not total:
        return None
    poc = max(prices, key=lambda price: levels[price])
    low = high = prices.index(poc)
    covered = levels[poc]
    target = total * share
    while covered < target and (low > 0 or high < len(prices) - 1):
        below = levels[prices[low - 1]] if low > 0 else -1
        above = levels[prices[high + 1]] if high < len(prices) - 1 else -1
        if above >= below:
            high += 1
            covered += levels[prices[high]]
        else:
            low -= 1
            covered += levels[prices[low]]
    return {
        "poc_rial": poc,
        "val_rial": prices[low],
        "vah_rial": prices[high],
        "levels": high - low + 1,
        "share_pct": round(covered / total * 100, 1),
    }


def session_summary(samples):
    """The price structure of one session, from its trade samples.

    Everything here is measured on the tape itself: the high/low and when they
    happened, the close's position inside the day's range (CLV), how much volume
    traded at or above the tape VWAP, the opening ranges, the market-profile
    value area and the largest prints. The gap against the previous close is
    added at render time, once the official row (or the live quote) is known.
    """
    if not samples:
        return None
    priced = [sample for sample in samples if sample[2] is not None]
    if not priced:
        return None
    first_secs = samples[0][0]
    high = low = None
    high_secs = low_secs = None
    last = None
    volume = 0
    turnover = 0
    levels = {}
    largest = []
    for secs, _trade_no, price, shares in samples:
        if price is not None:
            if high is None or price > high:
                high, high_secs = price, secs
            if low is None or price < low:
                low, low_secs = price, secs
            last = price
            levels[price] = levels.get(price, 0) + shares
            largest.append((price * shares, secs, price, shares))
        volume += shares
        turnover += (price or 0) * shares
    vwap = round(turnover / volume) if volume else None
    above = (
        sum(
            shares
            for _secs, _no, price, shares in samples
            if price is not None and price >= vwap
        )
        if vwap is not None
        else 0
    )
    summary = {
        "first_rial": priced[0][2],
        "high_rial": high,
        "high_time": fmt_minute(minute_of(high_secs)) if high_secs is not None else None,
        "low_rial": low,
        "low_time": fmt_minute(minute_of(low_secs)) if low_secs is not None else None,
        "last_rial": last,
        "close_location_pct": round((last - low) / (high - low) * 100, 1)
        if last is not None and high > low
        else None,
        "vwap_rial": vwap,
        "above_vwap_pct": round(above / volume * 100, 1)
        if vwap is not None and volume
        else None,
        "volume_shares": volume,
        "value_rial": turnover,
        "trades": len(samples),
        "opening_range": {},
        "value_area": value_area(levels),
        "largest_prints": [],
    }
    for window in SESSION_OPEN_RANGES:
        end = first_secs + window * 60
        prices = [
            price
            for secs, _no, price, _shares in samples
            if secs <= end and price is not None
        ]
        if prices:
            summary["opening_range"][f"{window}m"] = {
                "high_rial": max(prices),
                "low_rial": min(prices),
            }
    top = sorted(largest, reverse=True)[:3]
    top.sort(key=lambda item: item[1])
    summary["largest_prints"] = [
        {
            "time": fmt_minute(minute_of(secs)),
            "price_rial": price,
            "volume_shares": shares,
            "value_rial": price * shares,
        }
        for _value, secs, price, shares in top
    ]
    return summary


# --- day loading ----------------------------------------------------------


def book_covers_session(day, updates):
    """True when the level stream spans the session it will be replayed against.

    A published day's stream opens with the pre-open book (~08:45) and runs to
    the close. The exchange (or a lagging CDN replica) can serve a partial
    stream — while it is still publishing the date — that starts after trading
    began or stops early; replaying that would describe a book that never
    existed, and label an early state with the close's time.
    """
    minutes = [bar["minute"] for bar in day.get("bars") or ()]
    if not minutes or not updates:
        return True
    started = minute_of(updates[0]["hhmmss"]) <= min(minutes)
    finished = (
        minute_of(updates[-1]["hhmmss"]) + DEPTH_COVER_SLACK_MINUTES >= max(minutes)
    )
    return started and finished


def attach_day_depth(client, code, greg, day, attempts=3):
    """Fetch a completed session's book stream; never fails the day.

    The CDN can serve the day's stream before the exchange has finished
    publishing it, so a stream that does not cover the session is refetched a
    few times before being given up on — a truncated stream would otherwise be
    replayed as if it were the whole day (and mislabel an early state as the
    close).
    """
    for attempt in range(attempts):
        try:
            updates = fetch_book_stream(client, code, greg)
        except tse.DataError as exc:
            day["depth_note"] = f"order book unavailable: {exc}"
            return
        if not updates:
            day["depth_note"] = (
                "order book not published for this date (it appears after the"
                " close, and only for roughly the last two months)"
            )
            return
        if book_covers_session(day, updates):
            day["depth_updates"] = updates
            return
        if attempt < attempts - 1:
            # Another CDN edge may already have the whole day.
            client.drop(f"{API}/BestLimits/{code}/{greg}")
            time.sleep(0.5 * (attempt + 1))
    day["depth_note"] = (
        "the level stream only spans"
        f" {fmt_minute(minute_of(updates[0]['hhmmss']))}–"
        f"{fmt_minute(minute_of(updates[-1]['hhmmss']))}, not the whole session"
        " (the exchange is still publishing this date); rerun later"
    )


def attach_live_depth(client, code, day):
    """Attach the current book to the live session (history lags a day)."""
    try:
        updates = fetch_live_book(client, code)
    except tse.DataError as exc:
        day["depth_note"] = f"order book unavailable: {exc}"
        return
    if not updates:
        day["depth_note"] = "no order book snapshot available"
        return
    day["live_book"] = updates
    day["depth_note"] = (
        "intraday order-book history is published after the close;"
        " showing the current snapshot"
    )


def load_day(
    client, code, entry, mode, include_canceled, depth=False, keep_ticks=False
):
    """Fetch one session into its artifact, or None when it has no data.

    A completed session comes from its per-trade tape (validated against the
    official daily aggregate). The live session (today, before its daily bar is
    published) uses the raw live tape too — it is fresh, 1-minute and carries
    trade numbers — falling back to TSETMC's native 2-minute ``GetTradeIntraDay``
    bars only if the tape has nothing.
    """
    greg, jalali, live = entry["greg"], entry["jalali"], entry["live"]
    if not live:
        rows = fetch_ticks(client, code, greg)
        if not rows:
            return None
        day = day_from_rows(jalali, "ticks", rows, mode, include_canceled)
        day["greg"] = greg
        day["check"] = tape_check(entry, rows)
        day["official"] = entry.get("official")
        if keep_ticks:
            day["tape"] = rows
        if depth:
            attach_day_depth(client, code, greg, day)
        return day

    try:
        rows = fetch_live_ticks(client, code)
    except tse.DataError:
        rows = []
    if rows:
        day = day_from_rows(jalali, "live", rows, mode, include_canceled)
        day["greg"] = greg
        if keep_ticks:
            day["tape"] = rows
        if depth:
            attach_live_depth(client, code, day)
        return day
    bars = fetch_live_bars(client, code)
    if not bars or mode != "bars":
        return None
    day = {
        "date": jalali,
        "greg": greg,
        "source": "live",
        "native_interval": 2,
        "bars": bars,
    }
    if depth:
        attach_live_depth(client, code, day)
    return day


def day_from_rows(jalali, source, rows, mode, include_canceled):
    """One session's raw tape rows -> the artifact for the requested output mode."""
    if mode == "ticks":
        return {"date": jalali, "source": source, "ticks": rows}
    samples = tick_samples(rows, include_canceled)
    if mode == "profile":
        return {
            "date": jalali,
            "source": source,
            "profile": profile_rows(samples),
        }
    return {
        "date": jalali,
        "source": source,
        "bars": samples_to_bars(samples),
        "native_interval": 1,
        "session": session_summary(samples),
    }


def tape_check(entry, rows):
    """Compare a completed session's tape with its official daily aggregate.

    Returns a human-readable note when they differ, else None. The tape is
    deduplicated first, so an intact session matches exactly.
    """
    expected_trades = entry.get("expected_trades")
    if expected_trades is None:
        return None
    clean = dedup_ticks(rows, include_canceled=False)
    count = len(clean)
    volume = sum(tse.value(row, "qTitTran") or 0 for row in clean)
    problems = []
    if count != expected_trades:
        problems.append(f"{count} trades vs {expected_trades} reported")
    expected_volume = entry.get("expected_volume")
    if expected_volume and volume != expected_volume:
        problems.append(f"volume {volume} vs {expected_volume} reported")
    return "; ".join(problems) if problems else None


def select_entries(sessions, args, parser, today):
    """The candidate sessions (oldest first, live marked) and the wanted count.

    ``wanted`` is the requested session count for the ``--days`` path — the
    caller backfills older sessions when the newest has no data yet — and None
    for an explicit ``--date``/``--from``/``--to``, which fetches exactly the
    named sessions.
    """
    by_greg = {session["greg"]: session for session in sessions}
    today_greg, today_jalali = today["greg"], today["jalali"]
    live_ok = today["trading"] and not args.no_live

    def is_live(greg):
        # Today is only genuinely live while it is absent from the completed
        # daily list; once its daily bar is published it has a full tape.
        return live_ok and greg == today_greg and greg not in by_greg

    def make(greg, jalali, live=False):
        session = by_greg.get(greg, {})
        return {
            "greg": greg,
            "jalali": jalali,
            "live": live,
            "expected_trades": session.get("trades"),
            "expected_volume": session.get("volume"),
            "official": session.get("official"),
        }

    def entry(greg, jalali):
        return make(greg, jalali, is_live(greg))

    if args.date:
        jalali, greg = parse_jalali(parser, args.date, "--date")
        if greg in by_greg:
            return [entry(greg, jalali)], None
        if greg == today_greg:
            if live_ok:
                return [make(greg, jalali, True)], None
            parser.error(
                f"--date {jalali}: today's session is only available live "
                "(remove --no-live)"
            )
        parser.error(f"--date {jalali}: not a trading session")

    if args.start or args.end:
        low_jalali = high_jalali = None
        if args.start:
            low_jalali = parse_jalali(parser, args.start, "--from")[0]
        if args.end:
            high_jalali = parse_jalali(parser, args.end, "--to")[0]
        if low_jalali and high_jalali and low_jalali > high_jalali:
            parser.error("--from must not be later than --to")
        entries = [
            entry(session["greg"], session["jalali"])
            for session in sessions
            if (low_jalali is None or session["jalali"] >= low_jalali)
            and (high_jalali is None or session["jalali"] <= high_jalali)
        ]
        if (
            live_ok
            and today_greg not in by_greg
            and (low_jalali is None or today_jalali >= low_jalali)
            and (high_jalali is None or today_jalali <= high_jalali)
        ):
            entries.append(make(today_greg, today_jalali, True))
        if not entries:
            parser.error("no trading sessions in the requested range")
        return entries, None

    entries = [entry(session["greg"], session["jalali"]) for session in sessions]
    if live_ok and today_greg not in by_greg:
        entries.append(make(today_greg, today_jalali, True))
    return entries, args.days


# --- rendering ------------------------------------------------------------


def bars_to_rows(bars):
    """Un-collapsed bars -> rows, each spanning its own single minute bucket."""
    return [
        {
            "from": fmt_minute(bar["minute"]),
            "to": fmt_minute(bar["minute"]),
            "open_rial": bar["open"],
            "high_rial": bar["high"],
            "low_rial": bar["low"],
            "close_rial": bar["close"],
            "vwap_rial": bar_vwap(bar),
            "volume_shares": bar["volume"],
            "trades": bar["trades"],
        }
        for bar in bars
    ]


def collapsed_to_rows(collapsed):
    """Collapsed flat runs -> rows spanning ``from``..``to`` with the run's OHLCV."""
    return [
        {
            "from": fmt_minute(bar["from"]),
            "to": fmt_minute(bar["to"]),
            "open_rial": bar["open"],
            "high_rial": bar["high"],
            "low_rial": bar["low"],
            "close_rial": bar["close"],
            "vwap_rial": bar_vwap(bar),
            "volume_shares": bar["volume"],
            "trades": bar["trades"],
            "bars": bar["count"],
        }
        for bar in collapsed
    ]


def bar_columns(collapsed=False, depth=False, flow=False):
    """The bar row's column order, with the extras before ``bars``."""
    columns = list(COLLAPSED_BAR_COLUMNS if collapsed else BAR_COLUMNS)
    extra = list(DEPTH_COLUMNS if depth else ()) + list(FLOW_COLUMNS if flow else ())
    if extra:
        at = columns.index("bars") if collapsed else len(columns)
        columns[at:at] = extra
    return columns


def tick_rows(rows, include_canceled):
    return [
        {
            "time": tse.trade_time(tse.pick(row, "hEven")),
            "price_rial": tse.price(tse.pick(row, "pTran")),
            "volume_shares": tse.value(row, "qTitTran"),
            "trade_no": tse.value(row, "nTran"),
            "canceled": tse.value(row, "canceled") or 0,
        }
        for row in dedup_ticks(rows, include_canceled)
    ]


def live_client_type(client, code):
    row = client.api(f"ClientType/GetClientType/{code}/1/0", "clientType")
    if not isinstance(row, dict):
        return None
    buy_i = tse.value(row, "buy_I_Volume")
    sell_i = tse.value(row, "sell_I_Volume")
    buy_n = tse.value(row, "buy_N_Volume")
    sell_n = tse.value(row, "sell_N_Volume")
    return {
        "individual_buy_shares": buy_i,
        "individual_sell_shares": sell_i,
        "legal_buy_shares": buy_n,
        "legal_sell_shares": sell_n,
        "legal_net_shares": buy_n - sell_n
        if buy_n is not None and sell_n is not None
        else None,
        # The live endpoint publishes volumes and trader counts only; the rial
        # values arrive with the completed session's history row, so they stay
        # unknown here instead of being estimated from shares x VWAP.
        "individual_buy_value_rial": None,
        "individual_sell_value_rial": None,
        "legal_buy_value_rial": None,
        "legal_sell_value_rial": None,
        "legal_net_value_rial": None,
        "individual_buyers": tse.value(row, "buy_CountI"),
        "individual_sellers": tse.value(row, "sell_CountI"),
        "legal_buyers": tse.value(row, "buy_CountN"),
        "legal_sellers": tse.value(row, "sell_CountN"),
    }


def official_line(official, tape_vwap):
    """One compact line for TSETMC's official daily row."""
    pieces = []
    close = official.get("close")
    if close is not None:
        stamp = f" @ {official['close_time']}" if official.get("close_time") else ""
        pieces.append(f"قیمت پایانی {close:,}{stamp}")
    last = official.get("last_price")
    if last is not None:
        detail = ""
        change, yesterday = official.get("change"), official.get("yesterday")
        if change is not None:
            detail = f" ({change:+}"
            if yesterday:
                detail += f", {change / yesterday * 100:+.1f}% vs {yesterday:,}"
            detail += ")"
        pieces.append(f"last trade {last:,}{detail}")
    if tape_vwap is not None:
        pieces.append(f"tape VWAP {tape_vwap:,}")
    first, low, high = official.get("first"), official.get("low"), official.get("high")
    if first is not None:
        pieces.append(f"first {first:,}")
    if low is not None and high is not None:
        pieces.append(f"range {low:,}–{high:,}")
    trades = official.get("trades")
    volume = official.get("volume")
    value_rial = official.get("value_rial")
    if trades is not None:
        pieces.append(f"{trades:,} trades")
    if volume is not None:
        pieces.append(f"{volume:,} shares")
    if value_rial is not None:
        pieces.append(f"{value_rial:,} rial")
    return f"Official: {' · '.join(pieces)}" if pieces else None


def depth_line(summary, kind="close", orders=True):
    """One compact line for an order-book snapshot.

    ``kind`` labels the moment: ``auction`` (opening queue), ``close`` (end of
    the session) or ``live`` (the current snapshot). Order counts saturate at
    9,999 on the exchange feed, so a capped count is printed as ``>=9,999``.
    """
    if not summary:
        return None
    pieces = []
    if summary.get("bid_rial") is not None:
        text = f"bid {summary['bid_rial']:,} × {summary.get('bid_shares') or 0:,}"
        if orders:
            count = summary.get("bid_orders")
            if count is not None:
                text += f" ({'>=9,999' if count >= 9999 else f'{count:,}'} ord)"
        pieces.append(text)
    if summary.get("ask_rial") is not None:
        text = f"ask {summary['ask_rial']:,} × {summary.get('ask_shares') or 0:,}"
        if orders:
            count = summary.get("ask_orders")
            if count is not None:
                text += f" ({'>=9,999' if count >= 9999 else f'{count:,}'} ord)"
        pieces.append(text)
    if summary.get("spread_rial") is not None:
        pieces.append(f"spread {summary['spread_rial']:,}")
    bid_depth = summary.get("bid_depth_shares")
    ask_depth = summary.get("ask_depth_shares")
    if bid_depth is not None and ask_depth is not None:
        pieces.append(f"{DEPTH_LEVELS}-level {bid_depth:,} bid / {ask_depth:,} ask")
    imbalance = summary.get("depth_imbalance_pct")
    if imbalance is not None:
        pieces.append(f"imbalance {imbalance:+.1f}%")
    if not pieces:
        return None
    stamp = f" {summary['time']}" if summary.get("time") else ""
    return f"Depth ({kind}{stamp}): " + " · ".join(pieces)


def format_shares(count):
    """A share count as a compact human-readable magnitude."""
    if count is None:
        return "?"
    for scale, suffix in ((1_000_000_000, "bn"), (1_000_000, "m"), (1_000, "k")):
        if abs(count) >= scale:
            return f"{count / scale:,.2f} {suffix}"
    return f"{count:,.0f}"


def format_rial(amount):
    """A rial amount as a compact human-readable magnitude."""
    if amount is None:
        return "?"
    for scale, suffix in ((1e15, "e15"), (1e12, "T"), (1e9, "bn"), (1e6, "m")):
        if abs(amount) >= scale:
            return f"{amount / scale:,.2f} {suffix}".replace(" ", "")
    return f"{amount:,.0f}"


def trade_sides(rows, updates):
    """Per-minute buy/sell-initiated volume, from the tape classified against the book.

    Each trade is matched to the prevailing best bid/ask (the Lee-Ready rule):
    at or above the ask is buyer-initiated, at or below the bid seller-initiated,
    and an inside-the-spread print goes to the side of the midpoint. TSETMC
    publishes no aggressor flag, so this is an estimate and whatever cannot be
    classified is counted separately instead of guessed.
    """
    samples = tick_samples(rows, False)
    buckets = {}
    state = {}
    cursor = 0
    for secs, _trade_no, price, volume in samples:
        cursor = advance_book(updates, cursor, state, secs)
        best = state.get(1)
        bid = best["bid_rial"] if best else None
        ask = best["ask_rial"] if best else None
        side = None
        if price is not None and bid is not None and ask is not None:
            if price >= ask:
                side = "buy"
            elif price <= bid:
                side = "sell"
            else:
                mid = (bid + ask) / 2
                side = "buy" if price > mid else "sell" if price < mid else None
        bucket = buckets.setdefault(
            minute_of(secs), {"buy": 0, "sell": 0, "unknown": 0}
        )
        bucket[side or "unknown"] += volume
    return buckets


def attach_flow(rows, buckets, interval=1, last_minute=None):
    """Add the flow columns, summing each bucket over the row's whole span."""
    span = max(0, interval - 1)
    cumulative = 0
    for row in rows:
        start = minute_of(text_hhmmss(row["from"]))
        end = minute_of(text_hhmmss(row["to"])) + span
        if last_minute is not None:
            end = min(end, last_minute)
        buy = sell = unknown = 0
        for minute in range(start, end + 1):
            bucket = buckets.get(minute)
            if bucket:
                buy += bucket["buy"]
                sell += bucket["sell"]
                unknown += bucket["unknown"]
        total = buy + sell + unknown
        net = buy - sell
        cumulative += net
        row["buy_initiated_shares"] = buy
        row["sell_initiated_shares"] = sell
        row["net_shares"] = net
        row["cum_net_shares"] = cumulative
        row["buy_pct"] = round(buy / total * 100, 1) if total else None


def flow_totals(buckets):
    """The session's day-level flow, matching the per-row columns."""
    buy = sum(bucket["buy"] for bucket in buckets.values())
    sell = sum(bucket["sell"] for bucket in buckets.values())
    unknown = sum(bucket["unknown"] for bucket in buckets.values())
    total = buy + sell + unknown
    return {
        "buy_initiated_shares": buy,
        "sell_initiated_shares": sell,
        "unclassified_shares": unknown,
        "net_shares": buy - sell,
        "buy_pct": round(buy / total * 100, 1) if total else None,
    }


def flow_line(totals):
    """One compact line for the session's estimated aggressor split."""
    if not totals:
        return None
    total = (
        totals["buy_initiated_shares"]
        + totals["sell_initiated_shares"]
        + totals["unclassified_shares"]
    )
    if not total:
        return None
    pieces = [
        f"{totals['buy_pct']:.1f}% buy-initiated",
        f"net {totals['net_shares']:+,} shares",
    ]
    if totals["unclassified_shares"]:
        pieces.append(
            f"{totals['unclassified_shares'] / total * 100:.1f}% unclassified"
        )
    return "Flow (estimated): " + " · ".join(pieces)


def session_line(summary, official=None, live_quote=None):
    """One line for the tape's own session structure."""
    if not summary:
        return None
    pieces = []
    first = summary.get("first_rial")
    if first is not None:
        pieces.append(f"first {first:,}")
    high = summary.get("high_rial")
    if high is not None:
        stamp = f" @ {summary['high_time']}" if summary.get("high_time") else ""
        pieces.append(f"high {high:,}{stamp}")
    low = summary.get("low_rial")
    if low is not None:
        stamp = f" @ {summary['low_time']}" if summary.get("low_time") else ""
        pieces.append(f"low {low:,}{stamp}")
    last = summary.get("last_rial")
    if last is not None:
        text = f"last {last:,}"
        location = summary.get("close_location_pct")
        if location is not None:
            text += f" (CLV {location:.0f}%)"
        pieces.append(text)
    vwap = summary.get("vwap_rial")
    if vwap is not None:
        text = f"VWAP {vwap:,}"
        share = summary.get("above_vwap_pct")
        if share is not None:
            text += f" ({share:.0f}% of volume at/above)"
        pieces.append(text)
    yesterday = (official or {}).get("yesterday") or (live_quote or {}).get("yesterday")
    if first is not None and yesterday:
        pieces.append(f"gap {(first / yesterday - 1) * 100:+.1f}% vs {yesterday:,}")
    return "Session: " + " · ".join(pieces) if pieces else None


def structure_line(summary):
    """Opening ranges and the market-profile value area, one line."""
    if not summary:
        return None
    pieces = []
    ranges = summary.get("opening_range") or {}
    for window in ("5m", "15m", "30m"):
        band = ranges.get(window)
        if band:
            pieces.append(f"{window} {band['low_rial']:,}–{band['high_rial']:,}")
    area = summary.get("value_area")
    if area:
        pieces.append(
            f"POC {area['poc_rial']:,}"
            f" · 70% band {area['val_rial']:,}–{area['vah_rial']:,}"
            f" ({area['levels']} levels, {area['share_pct']:.0f}% of volume)"
        )
    if not pieces:
        return None
    return "Structure: " + " · ".join(pieces)


def prints_line(summary):
    """The session's largest prints by rial value."""
    prints = (summary or {}).get("largest_prints") or []
    if not prints:
        return None
    pieces = [
        f"{item['time']} {item['price_rial']:,} × {item['volume_shares']:,}"
        f" ({format_rial(item['value_rial'])} rial)"
        for item in prints
    ]
    return "Largest prints: " + " · ".join(pieces)


def price_limits(client, code):
    """Today's static daily price limits (rial), or None when unpublished."""
    row = client.api(f"Instrument/GetInstrumentInfo/{code}", "instrumentInfo")
    if not isinstance(row, dict):
        return None
    band = tse.pick(row, "staticThreshold")
    if not isinstance(band, dict):
        return None
    low = tse.price(tse.pick(band, "psGelStaMin"))
    high = tse.price(tse.pick(band, "psGelStaMax"))
    if low is None or high is None:
        return None
    return {"low_rial": low, "high_rial": high}


def limit_distance_line(quote, limits):
    """How far the live price sits from today's limit, for lock/صف detection."""
    if not quote or not limits or quote.get("last_price") is None:
        return None
    last = quote["last_price"]
    low, high = limits.get("low_rial"), limits.get("high_rial")
    pieces = []
    if high:
        if last >= high:
            pieces.append("at the high limit")
        else:
            pieces.append(f"{(high - last) / high * 100:.1f}% below the high limit")
    if low:
        if last <= low:
            pieces.append("at the low limit")
        else:
            pieces.append(f"{(last - low) / low * 100:.1f}% above the low limit")
    if not pieces:
        return None
    return f"Limits: last {last:,} is " + " and ".join(pieces)


def stats_line(stats, session=None):
    """3-month averages, and — when it matches — the latest session beside them."""
    if not stats:
        return None
    pieces = []
    average = stats.get("avg_volume_3m_shares")
    if average is not None:
        text = f"3-mo avg {format_shares(average)} shares/day"
        older = stats.get("avg_volume_12m_shares")
        if older is not None:
            text += f" (12-mo {format_shares(older)})"
        pieces.append(text)
    trades = stats.get("avg_trades_3m")
    if trades is not None:
        pieces.append(f"{trades:,.0f} trades/day")
    buyers = stats.get("avg_individual_buyers_3m")
    if buyers is not None:
        pieces.append(f"{buyers:,.0f} real buyers/day")
    if session and session.get("volume") is not None:
        session_trades = session.get("trades")
        text = f"session {format_shares(session['volume'])}"
        if average:
            text += f" ({session['volume'] / average:.2f}x)"
        if session_trades is not None:
            text += f", {session_trades:,} trades"
        if session.get("buyers") is not None:
            text += f", {session['buyers']:,} real buyers"
        pieces.append(text)
    value = stats.get("company_value_rial")
    if value is not None:
        text = f"company value {format_rial(value)} rial"
        rank = stats.get("company_value_rank")
        if rank is not None:
            text += f" (#{rank:,.0f} by value)"
        pieces.append(text)
    return "Context: " + " · ".join(pieces) if pieces else None


def index_line(overview):
    """One compact line for the live market overview."""
    if not overview:
        return None
    pieces = []
    value = overview.get("index_value")
    if value is not None:
        text = f"TEDPIX {value:,.2f}"
        change = overview.get("index_change_pct")
        if change is not None:
            text += f" {change:+.2f}%"
        pieces.append(text)
    equal = overview.get("equal_weighted_change_pct")
    if equal is not None:
        pieces.append(f"equal-weighted {equal:+.2f}%")
    bits = []
    if overview.get("trades") is not None:
        bits.append(f"{overview['trades']:,.0f} trades")
    if overview.get("volume_shares") is not None:
        bits.append(f"{format_shares(overview['volume_shares'])} shares")
    if overview.get("value_rial") is not None:
        bits.append(f"{format_rial(overview['value_rial'])} rial")
    if bits:
        pieces.append("market " + ", ".join(bits))
    if overview.get("state"):
        pieces.append(str(overview["state"]))
    if not pieces:
        return None
    stamp = f" {overview['time']}" if overview.get("time") else ""
    return f"Market{stamp}: " + " · ".join(pieces)


def breadth_line(breadth):
    """One compact line for a session's market breadth.

    The exchange's own rows for a published session are preferred; the small
    large-cap proxy is the fallback for a day they are not published for, and
    it carries neither a median nor the symbol's percentile, so the line names
    the scope it actually covers.
    """
    if not breadth:
        return None
    pieces = [
        f"{breadth.get('advancers') or 0:,} up /"
        f" {breadth.get('decliners') or 0:,} down /"
        f" {breadth.get('unchanged') or 0:,} flat"
    ]
    median = breadth.get("median_change_pct")
    if median is not None:
        pieces.append(f"median {median:+.2f}%")
    own = breadth.get("instrument_change_pct")
    if own is not None:
        text = f"this stock {own:+.2f}%"
        percentile = breadth.get("instrument_percentile")
        if percentile is not None:
            text += f" (above {percentile:.0f}% of {breadth['instruments']:,} quoted)"
        pieces.append(text)
    if breadth.get("tracked"):
        pieces.append(
            f"tracked index components only ({breadth['tracked']} symbols,"
            " not the whole market)"
        )
    label = breadth.get("date") or "large-cap proxy"
    return f"Breadth ({label}): " + " · ".join(pieces)


def book_entries(day, updates, last_minute):
    """The book summaries for one session: auction, close — or just "now".

    A completed session's level stream is replayed twice: once at its first
    bar's end (the opening auction that set the first price) and once at its
    last trade. The live session publishes no stream, so it only has the
    current snapshot.
    """
    if updates:
        entries = []
        if day.get("bars"):
            auction_time = minute_hhmmss(day["bars"][0]["minute"])
            auction = depth_summary(updates, auction_time)
            if auction:
                entries.append({"kind": "auction", "summary": auction})
        close_time = minute_hhmmss(last_minute) if last_minute is not None else None
        close = depth_summary(updates, close_time)
        if close and (not entries or close != entries[-1]["summary"]):
            entries.append({"kind": "close", "summary": close})
        return entries
    if day.get("live_book"):
        live = depth_summary(day["live_book"])
        if live:
            live["time"] = (day.get("live_quote") or {}).get("time")
            return [{"kind": "live", "summary": live}]
    return []


def render_markdown(result):
    lines = [
        f"Fetched at: {result['fetched_at']}",
        f"Market session open by schedule: {result['market_session_open']}",
        "Prices and traded value are in rial, volume in shares.",
        "Not published by TSETMC: per-minute حقیقی/حقوقی (only the day-level"
        " breakdown shown below), closing-auction detail (قیمت پایانی is a"
        " volume-weighted average, not an auction print), and per-instrument"
        " NAV history (only the current NAV is exposed).",
    ]
    if result.get("depth"):
        lines.append(
            "Order-book depth: 5 levels only, from TSETMC's level-update stream;"
            " published per day after the close (the live session shows the current"
            " snapshot) and available for roughly the last two months."
        )
    if result.get("flow"):
        lines.append(
            "Buy/sell-initiated volume is an estimate: TSETMC publishes no"
            " aggressor flag, so each trade is classified against the best bid/ask"
            " at that moment and the leftovers are reported, not guessed."
        )
    mode = result["mode"]
    if mode == "ticks":
        lines.append("Rows: every trade (raw tape)")
    elif mode == "profile":
        lines.append("Rows: price-level volume profile")
    elif mode == "ladder":
        lines.append(
            f"Rows: 5-level order book at {result['interval_minutes']}-minute"
            " boundaries (the cumulative columns carry the running depth)"
        )
    else:
        parts = [f"{result['interval_minutes']}-minute OHLCV bars"]
        parts.append("auto interval" if result["interval_auto"] else "fixed interval")
        parts.append("collapsed" if result["collapsed"] else "not collapsed")
        lines.append("Rows: " + ", ".join(parts))
        if result["collapsed"]:
            lines.append(
                "Collapsed: consecutive identical-OHLC bars merged; the `bars`"
                " column is how many bars each row merged (1 = untouched)."
            )
    if result.get("interval_note"):
        lines.append(result["interval_note"])
    if result.get("live_note"):
        lines.append(result["live_note"])
    limits = result.get("limits")
    if limits:
        lines.append(
            f"Price limits (today): {limits['low_rial']:,}–{limits['high_rial']:,}"
            " (static daily band; not historical)"
        )
    line = stats_line(result.get("statistics"), result.get("latest_session"))
    if line:
        lines.append(line)
    line = index_line(result.get("market"))
    if line:
        lines.append(line)
    skipped = (result.get("extras") or {}).get("skipped") or {}
    informative = {
        name: reason for name, reason in skipped.items() if reason != "off"
    }
    if informative:
        lines.append(
            "Skipped extras: "
            + "; ".join(f"{name} ({reason})" for name, reason in informative.items())
        )
    instrument = result["instrument"]
    label = instrument.get("symbol") or instrument.get("name") or instrument["ins_code"]
    for day in result["days"]:
        source = day["source"]
        title = f"## {label} — {day['date']}  (source: {source})"
        lines.extend(("", title))
        if mode == "bars" and day.get("native_interval") == 2:
            lines.append(
                "Bar resolution: 2-minute (TSETMC's native intraday fallback;"
                " per-bar trade count is not published)"
            )
        official = day.get("official")
        if official:
            line = official_line(official, day.get("tape_vwap"))
            if line:
                lines.append(line)
        for line in (
            session_line(
                day.get("session"),
                official=official,
                live_quote=day.get("live_quote"),
            ),
            structure_line(day.get("session")),
            prints_line(day.get("session")),
        ):
            if line:
                lines.append(line)
        for entry in day.get("book") or ():
            line = depth_line(
                entry["summary"], kind=entry["kind"], orders=result.get("orders", True)
            )
            if line:
                lines.append(line)
        line = breadth_line(day.get("breadth"))
        if line:
            lines.append(line)
        client_type = day.get("client_type")
        if client_type:
            lines.append(
                "حقیقی/حقوقی (day): "
                + json.dumps(client_type, ensure_ascii=False, separators=(",", ":"))
            )
        line = flow_line(day.get("flow"))
        if line:
            lines.append(line)
        quote = day.get("live_quote")
        if quote:
            detail = [f"Live quote: last {quote['last_price']} @ {quote['time']}"]
            if quote.get("trades") is not None:
                detail.append(f"{quote['trades']} trades")
            if quote.get("volume") is not None:
                detail.append(f"{quote['volume']} shares")
            if quote.get("low") is not None and quote.get("high") is not None:
                detail.append(f"day {quote['low']}–{quote['high']}")
            if quote.get("vwap") is not None:
                detail.append(f"قیمت پایانی {quote['vwap']}")
            if quote.get("change") is not None and quote.get("yesterday"):
                detail.append(f"{quote['change']:+} vs {quote['yesterday']:,}")
            text = " · ".join(detail)
            if quote.get("lag_minutes"):
                text += (
                    f" — tape through {quote['tape_time']}"
                    f" ({quote['lag_minutes']}m behind)"
                )
            lines.append(text)
            line = limit_distance_line(quote, limits)
            if line:
                lines.append(line)
        buffer = io.StringIO()
        writer = csv.DictWriter(
            buffer, fieldnames=day["columns"], lineterminator="\n", extrasaction="ignore"
        )
        writer.writeheader()
        writer.writerows(day["rows"])
        lines.extend(("```csv", buffer.getvalue().rstrip(), "```"))
    if result["errors"]:
        lines.extend(
            (
                "",
                "## Missing or failed sources / داده‌های ناموجود",
                "```json",
                json.dumps(result["errors"], ensure_ascii=False, separators=(",", ":")),
                "```",
            )
        )
    return "\n".join(lines)


# --- extras selection ------------------------------------------------------


def parse_extra_names(values):
    """``--with``/``--without``/``--only`` arguments -> a flat, unique name list."""
    names = []
    for value in values or []:
        for item in value.split(","):
            item = item.strip().lower()
            if item and item not in names:
                names.append(item)
    return names


def validate_extras(names, parser):
    """Reject an unknown extra name, showing the catalog."""
    for name in names:
        if name not in EXTRA_NAMES and name != "all":
            parser.error(
                f"unknown extra {name!r}; choose from {', '.join(EXTRA_NAMES)}"
                " (or 'all')"
            )


def resolve_extras(args, parser):
    """Every extra's on/off state, before the sessions are known.

    ``--only`` replaces the registry outright; otherwise ``--without`` wins over
    ``--with``, and the flags that need the book (``--depth``, ``--depth-ladder``,
    ``--flow``) force it back on. The ``auto`` entries stay None until
    :func:`settle_extras` has seen which sessions were selected.
    """
    with_names = parse_extra_names(args.with_extras)
    without_names = parse_extra_names(args.without_extras)
    only_names = parse_extra_names(args.only_extras)
    for names in (with_names, without_names, only_names):
        validate_extras(names, parser)
    if only_names:
        if with_names or without_names:
            parser.error("--only cannot be combined with --with/--without")
        if "all" in only_names:
            only_names = list(EXTRA_NAMES)
        chosen = {name: name in only_names for name in EXTRA_NAMES}
    else:
        chosen = dict(EXTRA_DEFAULTS)
        for name in with_names:
            if name == "all":
                chosen = {key: True for key in EXTRA_NAMES}
            else:
                chosen[name] = True
        for name in without_names:
            if name == "all":
                chosen = {key: False for key in EXTRA_NAMES}
            else:
                chosen[name] = False
    if args.depth or args.depth_ladder:
        chosen["book"] = True
    if args.flow:
        chosen["flow"] = True
    return chosen


def settle_extras(chosen, days, notes):
    """Resolve the ``auto`` extras now that the selected sessions are known."""
    if chosen["index"] is None:
        chosen["index"] = any(day["source"] == "live" for day in days)
        if not chosen["index"]:
            notes["index"] = "the market index is published live only"
    published = [day for day in days if day["source"] != "live"]
    if chosen["breadth"] is None:
        if not published:
            chosen["breadth"] = False
            notes["breadth"] = "no published session selected"
        elif len(published) > BREADTH_AUTO_MAX_DAYS:
            chosen["breadth"] = False
            notes["breadth"] = (
                f"{len(published)} sessions x ~175 KB; use --with breadth"
            )
        else:
            chosen["breadth"] = True
    return chosen


def extras_table(chosen):
    """The registry as an aligned table, for ``--extras``."""
    lines = ["Extras: name, default, now, what it adds, cost"]
    for name, default, what, cost in EXTRA_CATALOG:
        if chosen.get(name) is None:
            state = "auto"
        else:
            state = "on" if chosen[name] else "off"
        lines.append(f"  {name:<8} {default:<6} {state:<4} {what} — {cost}")
    return lines


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="tse.intraday",
        description="Intraday (per-minute) OHLCV bars for a Tehran Stock Exchange instrument.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  tse.intraday فولاد
  tse.intraday فولاد --days 5
  tse.intraday فولاد --date 1405/07/25
  tse.intraday فولاد --from 1405/07/20 --to 1405/07/25
  tse.intraday فولاد --interval 5
  tse.intraday فولاد --days 3 --ticks
  tse.intraday فولاد --days 3 --profile
  tse.intraday فولاد --depth
  tse.intraday فولاد --depth-ladder --interval 5
  tse.intraday فولاد --no-live --json

Every session, including the live one, comes from the per-trade tape and is
aggregated here into N-minute bars (the live day falls back to TSETMC's native
2-minute bars only if its tape is empty). --interval auto (default) picks the
finest interval that fits --max-rows, and --collapse auto (default) merges
consecutive identical-OHLC bars only once a run exceeds --collapse-threshold
rows; the merged rows carry a `bars` column with the bar count they swallowed.

Every bar carries `vwap_rial`, its own volume-weighted average price computed
from the tape, and every completed session an `Official:` line with TSETMC's
daily row: قیمت پایانی (the day's VWAP capped by حجم مبنا) and its timestamp,
the last trade, first/range, change vs the previous close, and the trade,
volume and value totals. TSETMC publishes no per-minute حقیقی/حقوقی, no
closing-auction detail and no per-instrument NAV history.

Each session also carries its own `Session:` line (high/low with times, the
close's location in the range, the share of volume at or above the tape VWAP,
the gap vs the previous close), a `Structure:` line (5/15/30-minute opening
ranges and the market-profile value area: POC and the 70% band) and its
largest prints by rial value. Today's static price limits are printed in the
header, so a locked session (صف) is recognizable.

--depth adds the order book to every bar (best bid/ask with their sizes, the
spread, the 5-level bid/ask depth and the imbalance), sampled at the bar's end;
--depth-ladder prints the whole ladder at each row boundary with running
cumulative depth. TSETMC publishes 5 levels and no more, and the per-day stream
only after the close (about two months of history), so the live session shows
just its current snapshot.

Each run also carries context extras, on by default and individually switchable
with --with NAME, --without NAME (or all) and --only NAME; --extras lists them:
book (opening-auction and close order-book summaries with order counts), orders,
opening, stats (3-month averages and the latest session beside them), index
(the live market overview), breadth (whole-market advancers/decliners per
session, up to five sessions) and flow (buy/sell-initiated volume and the
running cumulative net; off by default, and --flow also adds its columns). A
source that cannot answer is skipped with a reason instead of an empty section.""",
    )
    parser.add_argument(
        "symbol",
        metavar="SYMBOL",
        nargs="?",
        help="Persian symbol, ISIN, insCode, or easytrader/tsetmc/codal URL",
    )
    parser.add_argument(
        "--days",
        type=int,
        default=None,
        metavar="N",
        help=f"Last N trading sessions (1-{MAX_DAYS}; default 1). The live session counts as the most recent when available",
    )
    parser.add_argument(
        "--date", metavar="DATE", help="One session, as a Jalali date (YYYY/MM/DD)"
    )
    parser.add_argument("--from", dest="start", metavar="DATE", help="First Jalali date (with --to)")
    parser.add_argument("--to", dest="end", metavar="DATE", help="Last Jalali date (with --from)")
    parser.add_argument(
        "--interval",
        default="auto",
        metavar="auto|M",
        help="Bar size in minutes, or 'auto' (default: finest that fits --max-rows)",
    )
    parser.add_argument(
        "--max-rows",
        type=int,
        default=DEFAULT_MAX_ROWS,
        metavar="N",
        help=f"Row budget for the automatic interval (default {DEFAULT_MAX_ROWS})",
    )
    parser.add_argument(
        "--collapse",
        dest="collapse_mode",
        choices=("auto", "on", "off"),
        default="auto",
        metavar="auto|on|off",
        help=(
            "Merge consecutive identical-OHLC bars into one row: auto (default)"
            " condenses only a big run, on always, off never"
        ),
    )
    parser.add_argument(
        "--collapse-threshold",
        type=int,
        default=DEFAULT_COLLAPSE_THRESHOLD,
        metavar="N",
        help=(
            "With --collapse auto, condense once a run exceeds N bars"
            f" (default {DEFAULT_COLLAPSE_THRESHOLD})"
        ),
    )
    parser.add_argument(
        "--no-collapse",
        action="store_true",
        help="Alias for --collapse off (keep every bar)",
    )
    parser.add_argument(
        "--depth",
        action="store_true",
        help=(
            "Add order-book depth columns to every bar: best bid/ask, spread,"
            " 5-level depth and the bid/ask imbalance"
        ),
    )
    parser.add_argument(
        "--flow",
        action="store_true",
        help=(
            "Add buy/sell-initiated volume columns and a Flow line: each trade"
            " classified against the best bid/ask at its moment (an estimate;"
            " needs the order book). The cumulative net is carried along"
        ),
    )
    parser.add_argument(
        "--with",
        dest="with_extras",
        action="append",
        metavar="NAME[,NAME...]",
        help="Force extras on (repeatable): " + ", ".join(EXTRA_NAMES),
    )
    parser.add_argument(
        "--without",
        dest="without_extras",
        action="append",
        metavar="NAME[,NAME...]",
        help="Force extras off (repeatable; 'all' for everything)",
    )
    parser.add_argument(
        "--only",
        dest="only_extras",
        action="append",
        metavar="NAME[,NAME...]",
        help="Keep only these extras and drop the rest",
    )
    parser.add_argument(
        "--extras",
        action="store_true",
        help="Print the extras table (defaults, state, cost) and exit",
    )
    output = parser.add_mutually_exclusive_group()
    output.add_argument(
        "--ticks", action="store_true", help="Emit the raw per-trade tape instead of bars"
    )
    output.add_argument(
        "--profile",
        action="store_true",
        help="Emit a price-level volume profile instead of time bars",
    )
    output.add_argument(
        "--depth-ladder",
        action="store_true",
        help=(
            "Emit the 5-level order book (bid/ask price, shares, orders and"
            " cumulative depth) at each row boundary instead of bars"
        ),
    )
    parser.add_argument(
        "--canceled",
        action="store_true",
        help="Keep canceled rows (default: they are dropped)",
    )
    parser.add_argument(
        "--no-live", action="store_true", help="Skip the current (live) session"
    )
    parser.add_argument(
        "--json", action="store_true", help="Output JSON instead of Markdown"
    )
    args = parser.parse_args(argv)

    if args.days is not None and not 1 <= args.days <= MAX_DAYS:
        parser.error(f"--days must be between 1 and {MAX_DAYS}")
    if bool(args.start) != bool(args.end):
        parser.error("--from and --to must be used together")
    if args.max_rows < 1:
        parser.error("--max-rows must be positive")
    if args.collapse_threshold < 1:
        parser.error("--collapse-threshold must be positive")
    if args.date and (args.start or args.end):
        parser.error("--date cannot be combined with --from/--to")
    if args.date and args.days is not None:
        parser.error("--date cannot be combined with --days")
    if args.days is None:
        args.days = 1
    if args.depth and (args.ticks or args.profile):
        parser.error(
            "--depth adds columns to bars; it cannot be combined with --ticks/--profile"
        )
    if args.depth and args.depth_ladder:
        parser.error("--depth and --depth-ladder are mutually exclusive")
    if args.flow and (args.ticks or args.profile):
        parser.error(
            "--flow adds columns to bars; it cannot be combined with --ticks/--profile"
        )
    if args.flow and args.depth_ladder:
        parser.error("--flow and --depth-ladder are mutually exclusive")

    interval = None
    if args.interval != "auto":
        try:
            interval = int(args.interval)
        except ValueError:
            parser.error("--interval must be 'auto' or a positive integer")
        if interval < 1:
            parser.error("--interval must be a positive integer")

    mode = "ticks" if args.ticks else "profile" if args.profile else "bars"
    extras = resolve_extras(args, parser)
    if args.extras:
        for line in extras_table(extras):
            print(line)
        return 0
    if not args.symbol:
        parser.error("SYMBOL is required")
    depth = (extras["book"] or extras["flow"]) if mode == "bars" else False
    collapse_mode = args.collapse_mode
    if args.no_collapse:
        if collapse_mode == "on":
            parser.error("--no-collapse conflicts with --collapse on")
        collapse_mode = "off"

    client = tse.Client()
    now = tse.tehran_now()
    try:
        instrument = tse.resolve(client, args.symbol)
        code = instrument["ins_code"]
        if not instrument.get("symbol"):
            try:
                ident = tse.identity(client, code)
                instrument = {**instrument, **{k: v for k, v in ident.items() if v}}
            except tse.DataError:
                pass
        sessions = fetch_sessions(client, code)
        if not sessions:
            raise tse.DataError("no trading sessions found for this instrument")
        today = {
            "greg": now.strftime("%Y%m%d"),
            "jalali": tse.trade_date(now.strftime("%Y%m%d")),
            "trading": now.weekday() in TRADING_WEEKDAYS,
        }
        entries, wanted = select_entries(sessions, args, parser, today)
        if not entries:
            raise tse.DataError("no sessions selected")

        errors = {}
        try:
            limits = price_limits(client, code)
        except tse.DataError as exc:
            limits = None
            errors["price_limits"] = str(exc)
        try:
            flow = tse.client_type_history(client, code)
        except tse.DataError as exc:
            flow = {}
            errors["client_type_history"] = str(exc)

        loaded = {}

        def load_batch(indices):
            indices = list(indices)
            if not indices:
                return
            with ThreadPoolExecutor(
                max_workers=min(FETCH_WORKERS, len(indices))
            ) as pool:
                futures = {
                    pool.submit(
                        load_day,
                        client,
                        code,
                        entries[index],
                        mode,
                        args.canceled,
                        depth,
                        extras["flow"],
                    ): index
                    for index in indices
                }
                for future, index in futures.items():
                    try:
                        loaded[index] = future.result()
                    except tse.DataError as exc:
                        loaded[index] = None
                        errors[entries[index]["jalali"]] = str(exc)

        if wanted is not None:
            # The newest `wanted` candidates, backfilling older sessions while a
            # newer one (often today's not-yet-open live session) has no data.
            start = max(0, len(entries) - wanted)
            load_batch(range(start, len(entries)))
            have = sorted(index for index, day in loaded.items() if day)
            cursor = start - 1
            while len(have) < wanted and cursor >= 0:
                load_batch([cursor])
                if loaded.get(cursor):
                    have.append(cursor)
                cursor -= 1
            days = [loaded[index] for index in sorted(have)[-wanted:]]
        else:
            load_batch(range(len(entries)))
            days = []
            for index in sorted(loaded):
                day = loaded[index]
                if day:
                    days.append(day)
                elif entries[index]["jalali"] not in errors:
                    errors[entries[index]["jalali"]] = "no data"

        if not days:
            raise tse.DataError(
                "no intraday data available for the requested session(s)"
            )

        # A completed day's tape occasionally disagrees with TSETMC's own daily
        # aggregate; report it instead of silently trusting the tape.
        for day in days:
            check = day.pop("check", None)
            if check:
                errors[day["date"]] = f"tape vs daily aggregate: {check}"
            if day.get("depth_note"):
                errors[f"{day['date']} (depth)"] = day["depth_note"]

        live_note = None
        newest = entries[-1]
        if newest["live"] and not any(day["date"] == newest["jalali"] for day in days):
            live_note = (
                f"Live session ({newest['jalali']}) has no data yet; "
                "showing the most recent completed sessions."
            )

        # The live tape is served from lagging CDN replicas, so anchor the live
        # session with the real-time quote and say how far the tape trails it.
        live_day = next((day for day in days if day["source"] == "live"), None)
        if live_day is not None:
            try:
                quote = fetch_live_quote(client, code)
            except tse.DataError as exc:
                quote = None
                errors.setdefault("live_quote", str(exc))
            if quote:
                if mode == "bars":
                    tape_minute = max(
                        (bar["minute"] for bar in live_day["bars"]), default=None
                    )
                    lag = (
                        quote["minute"] - tape_minute
                        if tape_minute is not None
                        else 0
                    )
                    if lag >= LAG_WARN_MINUTES:
                        quote["tape_time"] = fmt_minute(tape_minute)
                        quote["lag_minutes"] = lag
                live_day["live_quote"] = quote

        # --- extras -------------------------------------------------------
        notes = {}
        settle_extras(extras, days, notes)
        if mode != "bars":
            for name in ("book", "orders", "opening", "flow"):
                if extras[name]:
                    extras[name] = False
                    notes[name] = f"only sampled in bars mode (not --{mode})"

        statistics = None
        if extras["stats"]:
            try:
                statistics = tse.instrument_statistics(client, code)
            except tse.DataError as exc:
                errors["statistics"] = str(exc)
            if statistics is None:
                notes["stats"] = "the exchange returned none for this instrument"

        overview = None
        if extras["index"]:
            try:
                overview = tse.market_overview(client)
            except tse.DataError as exc:
                errors["market_overview"] = str(exc)
            if overview is None:
                notes["index"] = "the market overview returned nothing"

        breadth = {}
        if extras["breadth"]:
            published = [day for day in days if day["source"] != "live"]
            with ThreadPoolExecutor(
                max_workers=max(1, min(FETCH_WORKERS, len(published)))
            ) as pool:
                futures = {
                    pool.submit(tse.market_breadth_day, client, day["greg"], code): day
                    for day in published
                }
                for future, day in futures.items():
                    try:
                        breadth[day["date"]] = future.result()
                    except tse.DataError as exc:
                        errors[f"{day['date']} (breadth)"] = str(exc)
            missing = [
                day["date"]
                for day in published
                if not breadth.get(day["date"])
                and f"{day['date']} (breadth)" not in errors
            ]
            if missing:
                notes["breadth"] = (
                    "the exchange has not published whole-market rows for "
                    + ", ".join(missing)
                )

        flow_maps = {}
        if extras["flow"]:
            for day in days:
                if day.get("depth_updates") and day.get("tape"):
                    flow_maps[day["date"]] = trade_sides(
                        day["tape"], day["depth_updates"]
                    )
            missing = [
                day["date"]
                for day in days
                if day["source"] != "live" and day["date"] not in flow_maps
            ]
            if missing:
                notes["flow"] = (
                    "needs the day's order-book stream, missing for "
                    + ", ".join(missing)
                )
            elif live_day is not None and live_day["date"] not in flow_maps:
                notes["flow"] = (
                    "the live session has only its current book snapshot, not the"
                    " per-level stream a classification needs"
                )

        interval_auto = False
        interval_note = None
        collapse = False
        if mode == "bars":
            if args.depth_ladder:
                # A ladder needs a uniform clock, so identical-OHLC runs stay.
                collapse = False
                if collapse_mode == "on":
                    interval_note = (
                        "--depth-ladder samples a uniform time grid; "
                        "--collapse on is ignored."
                    )
            elif collapse_mode == "auto":
                # Small runs stay raw; only a big run is condensed.
                total_minutes = sum(len(day["bars"]) for day in days)
                collapse = total_minutes > args.collapse_threshold
            else:
                collapse = collapse_mode == "on"
            if interval is None:
                interval_auto = True
                # The ladder multiplies every time point by its five levels.
                budget = args.max_rows
                if args.depth_ladder:
                    budget = max(1, budget // DEPTH_LEVELS)
                bars_per_day = [day["bars"] for day in days]
                forced = choose_interval(bars_per_day, budget, collapse)
                per_point = DEPTH_LEVELS if args.depth_ladder else 1
                raw_one_minute = per_point * sum(
                    len(collapse_bars(day["bars"])) if collapse else len(day["bars"])
                    for day in days
                )
                interval = forced
                if forced > 1:
                    if args.depth_ladder:
                        limit = (
                            f"{budget} time points ({args.max_rows} rows /"
                            f" {DEPTH_LEVELS} levels)"
                        )
                    else:
                        limit = f"{budget} rows"
                    note = (
                        f"Auto interval: {forced}-minute to stay within {limit}"
                        f" (1-minute would have produced {raw_one_minute} rows)."
                    )
                    interval_note = f"{interval_note} {note}" if interval_note else note
        else:
            interval = 1

        rendered = []
        for day in days:
            depth_updates = day.get("depth_updates") or []
            book = []
            if mode == "ticks":
                columns, rows = TICK_COLUMNS, tick_rows(day["ticks"], args.canceled)
            elif mode == "profile":
                columns = PROFILE_COLUMNS
                rows = [
                    {
                        "price_rial": item["price"],
                        "volume_shares": item["volume"],
                        "trades": item["trades"],
                        "first_time": fmt_minute(minute_of(item["first"])),
                        "last_time": fmt_minute(minute_of(item["last"])),
                    }
                    for item in day["profile"]
                ]
            else:
                flow_here = extras["flow"] and day["date"] in flow_maps
                columns = bar_columns(bool(collapse), args.depth, flow_here)
                merged = merge_bars(day["bars"], interval)
                rows = (
                    collapsed_to_rows(collapse_bars(merged))
                    if collapse
                    else bars_to_rows(merged)
                )
                last_minute = max(
                    (bar["minute"] for bar in day["bars"]), default=None
                )
                if args.depth_ladder:
                    if depth_updates and rows:
                        rows = ladder_rows(
                            rows, depth_updates, interval, last_minute
                        )
                    elif day.get("live_book"):
                        label = (day.get("live_quote") or {}).get("time") or "live"
                        rows = ladder_block(
                            {item["level"]: item for item in day["live_book"]}, label
                        )
                    columns = LADDER_COLUMNS
                elif depth_updates and rows:
                    attach_depth(rows, depth_updates, interval, last_minute)
                if flow_here:
                    attach_flow(rows, flow_maps[day["date"]], interval, last_minute)
                if extras["book"]:
                    book = book_entries(day, depth_updates, last_minute)
                    if not extras["opening"]:
                        book = [item for item in book if item["kind"] != "auction"]
            client_type = flow.get(day["date"])
            if day["source"] == "live" and client_type is None:
                try:
                    client_type = live_client_type(client, code)
                except tse.DataError:
                    client_type = None
            rendered.append(
                {
                    "date": day["date"],
                    "source": day["source"],
                    "interval_minutes": max(interval, day.get("native_interval") or 1)
                    if mode == "bars"
                    else None,
                    "native_interval": day.get("native_interval"),
                    "official": day.get("official"),
                    "tape_vwap": session_vwap(day["bars"]) if mode == "bars" else None,
                    "session": day.get("session"),
                    "book": book,
                    "client_type": client_type,
                    "breadth": breadth.get(day["date"]),
                    "flow": flow_totals(flow_maps[day["date"]])
                    if extras["flow"] and day["date"] in flow_maps
                    else None,
                    "live_quote": day.get("live_quote"),
                    "columns": list(columns),
                    "rows": rows,
                }
            )

        # The latest-session numbers beside the 3-month averages: the live tape's
        # running totals, or the published day the statistics actually describe.
        latest_session = None
        if live_day is not None:
            quote = live_day.get("live_quote") or {}
            live_rendered = next(
                (item for item in rendered if item["source"] == "live"), None
            )
            latest_session = {
                "volume": quote.get("volume"),
                "trades": quote.get("trades"),
                "buyers": ((live_rendered or {}).get("client_type") or {}).get(
                    "individual_buyers"
                ),
            }
        elif statistics:
            for item in rendered:
                official = item.get("official") or {}
                if official.get("volume") == statistics.get("last_volume_shares"):
                    latest_session = {
                        "volume": official.get("volume"),
                        "trades": official.get("trades"),
                        "buyers": (item.get("client_type") or {}).get(
                            "individual_buyers"
                        ),
                    }
                    break

        used = []
        if any(item["book"] for item in rendered):
            used.append("book")
            if any(
                entry["kind"] == "auction"
                for item in rendered
                for entry in item["book"]
            ):
                used.append("opening")
            if extras["orders"]:
                used.append("orders")
        if statistics:
            used.append("stats")
        if overview:
            used.append("index")
        if any(item["breadth"] for item in rendered):
            used.append("breadth")
        if any(item["flow"] for item in rendered):
            used.append("flow")
        skipped = {
            name: notes.get(name, "off")
            for name in EXTRA_NAMES
            if name not in used
        }
        result = {
            "fetched_at": tse.jalali_stamp(now),
            "market_session_open": tse.market_session_open(now),
            "instrument": instrument,
            "mode": "ladder" if args.depth_ladder else mode,
            "depth": depth,
            "orders": extras["orders"],
            "flow": "flow" in used,
            "interval_minutes": interval if mode == "bars" else None,
            "interval_auto": interval_auto,
            "interval_note": interval_note,
            "live_note": live_note,
            "collapsed": collapse if mode == "bars" else False,
            "collapse_mode": collapse_mode if mode == "bars" else None,
            "collapse_threshold": args.collapse_threshold,
            "statistics": statistics,
            "market": overview,
            "latest_session": latest_session,
            "limits": limits,
            "extras": {"used": used, "skipped": skipped},
            "days": rendered,
            "errors": errors,
        }
    except tse.DataError as exc:
        print(f"tse.intraday: {exc}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        print(render_markdown(result))
    return 0


if __name__ == "__main__":
    sys.exit(main())
