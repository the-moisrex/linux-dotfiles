#!/bin/bash

if ! command -v fzf >/dev/null; then
    echo "fzf is not installed." >&2
    exit 1
fi

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo "Usage: fzf1 QUERY"
    echo
    echo "Shortcut for 'fzf -f QUERY | head -1'"
    echo
    echo "Options:"
    echo "  -h, --help    Show this help message"
    exit 0
fi

for file in "$@"; do
    fzf -f "$file" | head -1
done
