if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo "Usage: terminal-colors"
    echo
    echo "Print a 256-color foreground and background table to the terminal."
    echo
    echo "Options:"
    echo "  -h, --help    Show this help message"
    exit 0
fi

for fgbg in 38 48 ; do # Foreground / Background
    for color in {0..255} ; do # Colors
        # Display the color
        printf "\e[${fgbg};5;%sm  %3s  \e[0m" $color $color
        # Display 6 colors per lines
        if [ $((($color + 1) % 6)) == 0 ] ; then
            echo # New line
        fi
    done
    echo # New line
done
 
exit 0


