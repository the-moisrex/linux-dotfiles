#!/usr/bin/env python3
"""ai.gemini — start a new Gemini chat from a prompt or stdin.

Replays the signed-in gemini.google.com session against the web app's private
``StreamGenerate`` RPC — no API key.
See ``ai.gemini --help``.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from ai.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main("gemini"))
