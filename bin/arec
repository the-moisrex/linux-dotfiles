#!/bin/bash

if ! command -v asciinema &> /dev/null; then
    echo "asciinema could not be found."
    exit
fi

function print_help {
  echo Record shell using asciinema
  echo
  echo "   Usage:   arec [--no-tmux] [--list] [--play FILE] [pretext] [title]"
  echo "   Example: arec webpp Working on database"
  echo
  echo "   Options:"
  echo "     --no-tmux    Don't start a new tmux session"
  echo "     --list       List existing recordings"
  echo "     --play FILE  Play back a recording"
  echo "     -h, --help   Show this help message"
  echo
  echo "   Pretext: the name of the project you're working on so we can write custom configurations for them."
  echo "   Title:   the title of this session that you're working on."
  exit
}

function list_recordings {
  local recordings_dir="$HOME/live"
  if [ ! -d "$recordings_dir" ]; then
    echo "No recordings directory found at $recordings_dir"
    return 1
  fi
  
  local count=$(find "$recordings_dir" -name "*.cast" -type f | wc -l)
  if [ "$count" -eq 0 ]; then
    echo "No recordings found in $recordings_dir"
    return 1
  fi
  
  echo "Recordings in $recordings_dir:"
  echo
  ls -lhtr "$recordings_dir"/*.cast 2>/dev/null | while read -r line; do
    echo "  $line"
  done
}

function play_recording {
  local file="$1"
  if [ ! -f "$file" ]; then
    echo "File not found: $file"
    return 1
  fi
  
  if ! command -v asciinema &> /dev/null; then
    echo "asciinema could not be found."
    return 1
  fi
  
  asciinema play "$file"
}

pretext=$1
no_tmux=false
cmd="$SHELL"
working_dir="$HOME"


case $1 in
    --help|-h|help)
        print_help;
        ;;
    --list|-l|list)
        list_recordings;
        exit 0;
        ;;
    --play|-p)
        if [ -z "$2" ]; then
          echo "Error: --play requires a file argument"
          exit 1
        fi
        play_recording "$2";
        exit $?;
        ;;
    --no-tmux|-nt|--notmux|no-tmux|-no-tmux)
        no_tmux=true;
        pretext=$2;
        shift 2;
        ;;
    *)
        shift;
esac

if [ -z "$pretext" ]; then
    print_help;
fi


if [ "$pretext" != "" ]; then
  if [ -d "$HOME/$pretext" ]; then
    working_dir="$HOME/$pretext"
  elif [ -d "$HOME/Projects/$pretext" ]; then
    working_dir="$HOME/Projects/$pretext"
    if ! $no_tmux; then
      cmd="tmux new -c $working_dir"
    fi
  fi
fi

if [ "$pretext" == "webpp" ]; then
  pretext="Webpp live coding"
elif [ "$pretext" == "foresight" ]; then
  pretext="Foresight live coding"
elif [ "$pretext" == "simdjson" ]; then
  pretext="SIMDJSON live coding"
fi

cd "$working_dir" || exit;
title="${*}"

# splugify from: https://gist.github.com/oneohthree/f528c7ae1e701ad990e6?permalink_comment_id=2047474#gistcomment-2047474
filename=$(echo "$pretext-$title" | iconv -t ascii//TRANSLIT | sed -r s/[~^]+//g | sed -r s/[^a-zA-Z0-9]+/-/g | sed -r 's/^-+|-+$//g' | tr A-Z a-z)
file="$HOME/live/$(date +%Y-%m-%d)-$filename.cast"

echo "Recording $pretext, $title"
echo "File: $file"
echo

append=""
if [ -f "$file" ]; then
  while true; do
    read -rp "File $file already exists, do you want to append? (Y/n) " yn
    case $yn in
      [Yy]* ) break;;
      [Nn]* ) exit;;
      * ) ;;
    esac
  done

  append="--append"
fi

asciinema rec "$file" -i 1 -t "$pretext, $title" -c "$cmd" $append
