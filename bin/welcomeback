#!/bin/bash

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo "Usage: $0"
    echo
    echo "  Print a welcome-back message (via cowsay/lolcat) when more than"
    echo "  one day has passed since the last visit. Put it in your shell"
    echo "  startup file to run it on every login."
    echo
    echo "Options:"
    echo "  -h, --help          Show this help message"
    exit 0
fi

text="Oh, there you are! I was getting worried."

if ! command -v cowsay >/dev/null; then
    function cowsay {
        echo "$*";
    }
fi


dir="$HOME/.cache/last_visit"
file=$dir/last_visit
mkdir -p "$dir"
touch "$file"
last_visit=$(cat "$file");
if [ -z "$last_visit" ]; then
    last_visit="200101";
fi
days=$(( ($(date -u +%s) - $(date -u --date="${last_visit}" +%s) )/(60*60*24) ))
echo "last visited $days days ago.";
if [ $days -gt 1 ]; then
    if ! command -v lolcat >/dev/null; then
        cowsay "$text";
    else
        cowsay "$text" | lolcat;
    fi
fi;

date -u +%y%m%d > "$file";

