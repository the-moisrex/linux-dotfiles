#!/usr/bin/env python3
"""ai.grok — start a new Grok chat from a prompt or stdin.

Replays the signed-in grok.com session (``sso`` cookie) over its own chat API —
no API key.  See ``ai.grok --help``.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from ai.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main("grok"))
