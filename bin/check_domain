#!/bin/bash

JOBS=50

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo "Usage: cat urls.txt | check_domain [OPTIONS]"
    echo
    echo "Reads URLs/domains from stdin and checks them in parallel."
    echo
    echo "Options:"
    echo "  -j, --jobs N    Number of parallel jobs (default: 50)"
    echo "  -h, --help      Show this help message"
    exit 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -j|--jobs)
            JOBS="$2"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

if [[ -t 0 ]]; then
    echo "usage: cat alive.txt | check_domain" >&2
    echo "Reads URLs/domains from stdin and checks them in parallel." >&2
    exit 1
fi

exec parallel -j"$JOBS" -q curl -w 'Status:%{http_code}\t  Size:%{size_download}\t %{url_effective}\n' -o /dev/null -sk