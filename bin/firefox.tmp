#!/bin/bash

firefox_exe="firefox"
if command -v firefox-developer-edition >/dev/null; then
    if ! command -v firefox >/dev/null; then
        firefox_exe="firefox-developer-edition"
    fi
elif ! command -v firefox >/dev/null; then
    echo "Firefox is not installed or it's not in the PATH";
    exit 1;
fi

show_help() {
    cat <<'EOF'
Usage: firefox.tmp [-- URL...]

Launch Firefox with a temporary profile (deleted on exit).
Defaults to 'about:blank' if no arguments are given.

Options:
  -h, --help    Show this help message

All other arguments are passed directly to Firefox.
EOF
}

case "${1:-}" in
    -h|--help) show_help; exit 0 ;;
esac

the_args=("about:blank")
if [ $# -gt 0 ]; then
    the_args=("$@")
fi
dir=$(mktemp -d)
echo "Firefox Config Directory: $dir"
"$firefox_exe" --no-remote --new-instance --profile "$dir" "${the_args[@]}"
rm -rf "$dir"
echo "Firefox Config Directory $dir Deleted."