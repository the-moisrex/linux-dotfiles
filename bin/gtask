#!/usr/bin/bash

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo "Usage: $0 <task-command>..."
    echo
    echo "  Run the 'task' command with the local .taskrc and .task data"
    echo "  discovered by walking up from the current directory."
    echo
    echo "Options:"
    echo "  -h, --help          Show this help message"
    echo
    echo "All other arguments are forwarded to 'task'. For task's own help,"
    echo "run: $0 help"
    exit 0
fi

TASKDATA=".task";
TASKRC=".taskrc";

until [ "$(realpath -m "$TASKRC")" = "/.taskrc" ] || \
      [ "$(realpath -m "$TASKRC")" = "/" ] || \
      [ -f "$TASKRC" ]; do
  TASKRC="../${TASKRC}";
done;

until [ "$(realpath -m "$TASKDATA")" = "/.task" ] || \
      [ "$(realpath -m "$TASKDATA")" = "/" ] || \
      [ -d "$TASKDATA" ]; do
  TASKDATA="../${TASKDATA}";
done;

TASKRCGIT="$(realpath "$(dirname "$TASKRC")")/.git";
TASKDATAGIT="$(realpath "$(dirname "$TASKDATA")")/.git";


if [ -d "$TASKDATA" ] && [ -f "$TASKRC" ] && [ -d "$TASKRCGIT" ] && [ -d "$TASKDATAGIT" ]; then
  echo "TASKDATA=\"${TASKDATA}\" TASKRC=\"${TASKRC}\" task $*";
  TASKDATA="${TASKDATA}" TASKRC="${TASKRC}" task "$@";
elif [ -f "$TASKRC" ] && [ -d "$TASKRCGIT" ]; then
  echo "TASKRC=\"${TASKRC}\" task $*";
  TASKRC="${TASKRC}" task "$@";
elif [ -d "$TASKDATA" ] && [ -d "$TASKDATAGIT" ]; then
  echo "TASKDATA=\"${TASKDATA}\" task $*";
  TASKDATA="${TASKDATA}" task "$@";
else
  task "$@";
fi;
